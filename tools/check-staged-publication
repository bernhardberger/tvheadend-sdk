def zip_bytes(entries: dict[str, bytes]) -> bytes:
    output = io.BytesIO()
    with zipfile.ZipFile(output, "w") as archive:
        for name, data in entries.items():
            archive.writestr(name, data)
    return output.getvalue()


def class_bytes(major: int = CLASS_MAJOR) -> bytes:
    return b"\xca\xfe\xba\xbe\x00\x00" + struct.pack(">H", major)


def archive_fixture(module: str, kind: str, wrong_major: bool = False) -> bytes:
    legal = {
        "META-INF/LICENSE": b"GNU GENERAL PUBLIC LICENSE Version 3",
        "META-INF/NOTICE": b"Derived from Preclikos/tvhstream",
    }
    if kind == "sources":
        return zip_bytes({**legal, f"at/bernhardberger/tvheadend/sdk/{module}/Synthetic.kt": b"package synthetic"})
    if kind == "javadoc":
        return zip_bytes({**legal, "index.html": b"documentation"})
    class_entry = {f"at/bernhardberger/tvheadend/sdk/{module}/Synthetic.class": class_bytes(60 if wrong_major else CLASS_MAJOR)}
    if MODULES[module].android:
        entries = {"classes.jar": zip_bytes({**legal, **class_entry})}
        if module == "sdk-media3":
            entries.update({
                FFMPEG_LIBRARY: zip_bytes({
                    name: class_bytes(FFMPEG_CLASS_MAJOR)
                    for name in sorted(FFMPEG_CLASSES)
                }),
                "jni/arm64-v8a/libffmpegJNI.so": b"a",
                "jni/armeabi-v7a/libffmpegJNI.so": b"b",
                "jni/x86/libffmpegJNI.so": b"c",
                "jni/x86_64/libffmpegJNI.so": b"d",
            })
        return zip_bytes(entries)
    return zip_bytes({**legal, **class_entry})


def module_fixture(module: str, resolved_names: dict[str, str], files: dict[str, bytes]) -> dict[str, Any]:
    spec = MODULES[module]
    if spec.android:
        variants = (
            ("releaseVariantReleaseApiPublication", "main", False),
            ("releaseVariantReleaseRuntimePublication", "main", True),
            ("releaseVariantReleaseSourcePublication", "sources", False),
        )
    else:
        variants = (
            ("apiElements", "main", False),
            ("runtimeElements", "main", True),
            ("sourcesElements", "sources", False),
            ("javadocElements", "javadoc", False),
        )
    models: list[dict[str, Any]] = []
    for name, label, runtime in variants:
        documentation = label in {"sources", "javadoc"}
        attributes: dict[str, Any] = {
            "org.gradle.category": "documentation" if documentation else "library",
            "org.gradle.dependency.bundling": "external",
            "org.gradle.usage": "java-runtime" if documentation or runtime else "java-api",
        }
        if documentation:
            attributes["org.gradle.docstype"] = label
        else:
            attributes["org.gradle.libraryelements"] = spec.main_extension
            if not spec.android:
                attributes["org.gradle.jvm.environment"] = "standard-jvm"
                attributes["org.gradle.jvm.version"] = JVM_VERSION
                attributes["org.jetbrains.kotlin.platform.type"] = "jvm"
        name_value = resolved_names[label]
        data = files[label]
        model: dict[str, Any] = {
            "name": name,
            "attributes": attributes,
            "files": [{
                "name": name_value,
                "url": name_value,
                "size": len(data),
                "sha512": digest_bytes("sha512", data),
                "sha256": digest_bytes("sha256", data),
                "sha1": digest_bytes("sha1", data),
                "md5": digest_bytes("md5", data),
            }],
        }
        dependencies = module_dependencies(module, runtime) if not documentation else set()
        if dependencies:
            model["dependencies"] = [
                {"group": group, "module": artifact, "version": {"requires": version}}
                for group, artifact, version in sorted(dependencies)
            ]
        models.append(model)
    return {
        "formatVersion": "1.1",
        "component": {
            "group": GROUP,
            "module": module,
            "version": VERSION,
            "attributes": {"org.gradle.status": "release"},
        },
        "createdBy": {"gradle": {"version": GRADLE_VERSION}},
        "variants": models,
    }


