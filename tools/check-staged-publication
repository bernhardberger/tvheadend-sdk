    for module in MODULES:
        module_dir = group_dir / module
        version_dir = module_dir / VERSION
        version_dir.mkdir(parents=True)
        metadata = (
            f"<metadata><groupId>{GROUP}</groupId><artifactId>{module}</artifactId><versioning>"
