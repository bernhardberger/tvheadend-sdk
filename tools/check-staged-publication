def manifest_path(argument: str) -> Path:
    path = Path(argument)
    if ".." in path.parts:
        raise ValueError("manifest path must not contain parent traversal")
    if not path.is_absolute():
        path = ROOT / path
    try:
        relative = path.relative_to(ROOT)
    except ValueError as error:
        raise ValueError("manifest path must be below checkout build/") from error
    absolute = path.resolve(strict=False)
    build = (ROOT / "build").resolve(strict=False)
    if absolute == build or build not in absolute.parents:
        raise ValueError("manifest path must be below checkout build/")
    current = ROOT
    for part in relative.parts:
        current /= part
        if current.is_symlink():
            raise ValueError("manifest path must not traverse symlinks")
    return absolute


def main() -> int:
    args = sys.argv[1:]
    if args == ["--self-test"]:
        errors = self_test()
        manifest: dict[str, str] = {}
        success = "Staged publication hostile self-tests passed"
    elif not args or (len(args) == 2 and args[0] in {"--write-manifest", "--compare-manifest"}):
        errors, manifest = verify()
        success = "Staged SDK publication passed"
        if not errors and args:
            try:
                path = manifest_path(args[1])
                if args[0] == "--write-manifest":
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
                else:
                    expected = json.loads(path.read_text(encoding="utf-8"))
                    if expected != manifest:
                        errors.append(f"recreated publication bytes differ: expected {expected}, actual {manifest}")
            except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
                errors.append(f"publication manifest operation failed: {error}")
    else:
        print(
            "usage: check-staged-publication [--self-test|--write-manifest PATH|--compare-manifest PATH]",
            file=sys.stderr,
        )
        return 2
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(success + ": five modules, 26 checksummed originals, exact POM/module metadata, JVM 17, and approved native/source contents")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
