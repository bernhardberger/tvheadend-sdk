def pom_errors(module: str, path: Path) -> list[str]:
    errors: list[str] = []
    root = parse_xml(path, f"{module} POM", errors)
    if root is None:
        return errors
    spec = MODULES[module]
    expected_root = ET.fromstring(pom_fixture(module))
    if canonical_xml(root) != canonical_xml(expected_root):
        errors.append(f"{module} POM: exact XML structure or dependency semantics mismatch")
    expected_text = {
        "modelVersion": "4.0.0",
        "groupId": GROUP,
        "artifactId": module,
        "version": VERSION,
        "name": module,
        "description": spec.description,
        "url": PROJECT_URL,
    }
    for name, expected in expected_text.items():
        actual = one_text(root, name, f"{module} POM", errors)
        if actual is not None and actual != expected:
            errors.append(f"{module} POM: {name} is {actual!r}, expected {expected!r}")
    packaging = children(root, "packaging")
    expected_packaging = "aar" if spec.android else None
    actual_packaging = (packaging[0].text or "").strip() if len(packaging) == 1 else None
    if len(packaging) > 1 or actual_packaging != expected_packaging:
        errors.append(f"{module} POM: packaging is {actual_packaging!r}, expected {expected_packaging!r}")
    licenses = one_child(root, "licenses", f"{module} POM", errors)
    if licenses is not None:
        entries = children(licenses, "license")
        actual = {} if len(entries) != 1 else {
            name: one_text(entries[0], name, f"{module} POM license", errors)
            for name in ("name", "url", "distribution")
        }
        if actual != {"name": GPL_NAME, "url": GPL_URL, "distribution": "repo"}:
            errors.append(f"{module} POM: GPLv3 license metadata mismatch")
    developers = one_child(root, "developers", f"{module} POM", errors)
    if developers is not None:
        entries = children(developers, "developer")
        actual = {} if len(entries) != 1 else {
            name: one_text(entries[0], name, f"{module} POM developer", errors)
            for name in DEVELOPER
        }
        if actual != DEVELOPER:
            errors.append(f"{module} POM: developer metadata mismatch")
    scm = one_child(root, "scm", f"{module} POM", errors)
    if scm is not None:
        actual = {
            name: one_text(scm, name, f"{module} POM SCM", errors)
            for name in ("connection", "developerConnection", "url")
        }
        tags = children(scm, "tag")
        tag = "HEAD" if not tags else (tags[0].text or "").strip()
        if len(tags) > 1 or actual != {
            "connection": SCM,
            "developerConnection": SCM_DEVELOPER,
            "url": PROJECT_URL,
        } or tag != "HEAD":
            errors.append(f"{module} POM: SCM metadata mismatch")
    issues = one_child(root, "issueManagement", f"{module} POM", errors)
    if issues is not None:
        actual = {
            name: one_text(issues, name, f"{module} POM issues", errors)
            for name in ("system", "url")
        }
        if actual != {"system": "GitHub Issues", "url": ISSUES_URL}:
            errors.append(f"{module} POM: issue-management metadata mismatch")
    properties = one_child(root, "properties", f"{module} POM", errors)
    if properties is not None:
        actual = {local_name(child.tag): (child.text or "").strip() for child in properties}
        if actual != PROPERTIES:
            errors.append(f"{module} POM: properties mismatch: {actual}")
    dependency_root = one_child(root, "dependencies", f"{module} POM", errors)
    actual_dependencies: list[tuple[str, str, str, str]] = []
    if dependency_root is not None:
        for dependency in children(dependency_root, "dependency"):
            actual_dependencies.append(tuple(
                one_text(dependency, name, f"{module} POM dependency", errors) or ""
                for name in ("groupId", "artifactId", "version", "scope")
            ))
    if len(actual_dependencies) != len(set(actual_dependencies)):
        errors.append(f"{module} POM: duplicate dependencies")
    if set(actual_dependencies) != pom_dependencies(module):
        errors.append(
            f"{module} POM: dependencies {sorted(actual_dependencies)} do not match "
            f"{sorted(pom_dependencies(module))}"
        )
    return errors


def module_dependencies(module: str, runtime: bool) -> set[tuple[str, str, str]]:
    pom = pom_dependencies(module)
    if runtime:
        selected = pom
    else:
        selected = {item for item in pom if item[3] == "compile"}
    return {
        (group, artifact.removesuffix("-jvm") if artifact == "kotlinx-coroutines-core-jvm" else artifact, version)
        for group, artifact, version, _scope in selected
    }


def mapping(value: Any, label: str, errors: list[str]) -> dict[str, Any] | None:
    if not isinstance(value, dict) or not all(isinstance(key, str) for key in value):
        errors.append(f"{label}: expected JSON object with string keys")
        return None
    return value


def module_metadata_errors(module: str, path: Path, resolved: ResolvedModule) -> list[str]:
    errors: list[str] = []
    try:
        model = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        return [f"{module} module metadata: malformed JSON: {error}"]
    root = mapping(model, f"{module} module metadata", errors)
    if root is None:
        return errors
    module_labels = {"main", "sources"} if MODULES[module].android else {"main", "sources", "javadoc"}
    if module_labels <= set(resolved.files):
        try:
            expected_model = module_fixture(
                module,
                {label: staged.name for label, staged in resolved.files.items()},
                {label: staged.read_bytes() for label, staged in resolved.files.items()},
            )
        except OSError as error:
            return errors + [f"{module} module metadata: staged files cannot be read: {error}"]
        if canonical_module_model(root) != canonical_module_model(expected_model):
            errors.append(f"{module} module metadata: exact Gradle metadata semantics mismatch")
    if root.get("formatVersion") != "1.1":
        errors.append(f"{module} module metadata: formatVersion must be 1.1")
    component = mapping(root.get("component"), f"{module} module component", errors)
    if component is not None:
        actual = {name: component.get(name) for name in ("group", "module", "version")}
        if actual != {"group": GROUP, "module": module, "version": VERSION}:
            errors.append(f"{module} module metadata: wrong component {actual}")
        if component.get("attributes") != {"org.gradle.status": "release" if not VERSION.endswith("-SNAPSHOT") else "integration"}:
            errors.append(f"{module} module metadata: wrong component status")
    created = mapping(root.get("createdBy"), f"{module} module createdBy", errors)
    gradle = mapping(created.get("gradle"), f"{module} module Gradle creator", errors) if created else None
    if gradle is not None and gradle != {"version": GRADLE_VERSION}:
        errors.append(f"{module} module metadata: creator must be Gradle {GRADLE_VERSION}")
    variants = root.get("variants")
    if not isinstance(variants, list):
        return errors + [f"{module} module metadata: variants must be an array"]
    by_name: dict[str, dict[str, Any]] = {}
    for index, value in enumerate(variants):
        variant = mapping(value, f"{module} module variant {index}", errors)
        if variant is None:
            continue
        name = variant.get("name")
        if not isinstance(name, str) or name in by_name:
            errors.append(f"{module} module metadata: missing or duplicate variant name {name!r}")
            continue
        by_name[name] = variant
    if MODULES[module].android:
        api_name = "releaseVariantReleaseApiPublication"
        runtime_name = "releaseVariantReleaseRuntimePublication"
        sources_name = "releaseVariantReleaseSourcePublication"
        expected_names = {api_name, runtime_name, sources_name}
    else:
        api_name = "apiElements"
        runtime_name = "runtimeElements"
        sources_name = "sourcesElements"
        expected_names = {api_name, runtime_name, sources_name, "javadocElements"}
    if set(by_name) != expected_names:
        errors.append(f"{module} module metadata: variants {sorted(by_name)} do not match {sorted(expected_names)}")
    for name in expected_names & set(by_name):
        variant = by_name[name]
        attributes = mapping(variant.get("attributes"), f"{module} variant {name} attributes", errors)
        if attributes is None:
            continue
        documentation = name in {sources_name, "javadocElements"}
        if documentation:
            expected_type = "sources" if name == sources_name else "javadoc"
            if attributes.get("org.gradle.category") != "documentation" or attributes.get("org.gradle.docstype") != expected_type:
                errors.append(f"{module} variant {name}: documentation attributes mismatch")
            expected_label = expected_type
            expected_dependencies: set[tuple[str, str, str]] = set()
        else:
            if attributes.get("org.gradle.category") != "library" or attributes.get("org.gradle.libraryelements") != MODULES[module].main_extension:
                errors.append(f"{module} variant {name}: library attributes mismatch")
            if not MODULES[module].android and attributes.get("org.gradle.jvm.version") != JVM_VERSION:
                errors.append(f"{module} variant {name}: must advertise JVM {JVM_VERSION}")
            expected_label = "main"
            expected_dependencies = module_dependencies(module, name == runtime_name)
        dependencies = variant.get("dependencies", [])
        actual_dependencies: set[tuple[str, str, str]] = set()
        if not isinstance(dependencies, list):
            errors.append(f"{module} variant {name}: dependencies must be an array")
        else:
            for dependency in dependencies:
                item = mapping(dependency, f"{module} variant {name} dependency", errors)
                version = mapping(item.get("version"), f"{module} variant {name} dependency version", errors) if item else None
                if item is not None and version is not None:
                    if set(version) != {"requires"}:
                        errors.append(f"{module} variant {name}: dependency version must use only requires")
                    actual_dependencies.add((str(item.get("group")), str(item.get("module")), str(version.get("requires"))))
        if actual_dependencies != expected_dependencies:
            errors.append(
                f"{module} variant {name}: dependencies {sorted(actual_dependencies)} do not match "
                f"{sorted(expected_dependencies)}"
            )
        files = variant.get("files")
        expected_file = resolved.files.get(expected_label)
        if not isinstance(files, list) or len(files) != 1 or not isinstance(files[0], dict) or expected_file is None:
            errors.append(f"{module} variant {name}: expected exactly one staged file")
            continue
        file_model = files[0]
        data = expected_file.read_bytes()
        expected_hashes = {
            "size": len(data),
            "sha512": digest_bytes("sha512", data),
            "sha256": digest_bytes("sha256", data),
            "sha1": digest_bytes("sha1", data),
            "md5": digest_bytes("md5", data),
        }
        if file_model.get("name") != expected_file.name or file_model.get("url") != expected_file.name:
            errors.append(f"{module} variant {name}: file name or URL differs from staged artifact")
        if {key: file_model.get(key) for key in expected_hashes} != expected_hashes:
            errors.append(f"{module} variant {name}: file size or digest metadata mismatch")
    return errors


def safe_archive_entries(entries: list[zipfile.ZipInfo], label: str) -> list[str]:
    errors: list[str] = []
    names = [entry.filename for entry in entries]
    if len(names) != len(set(names)):
        errors.append(f"{label}: archive contains duplicate entries")
    for entry in entries:
        name = entry.filename
        parts = Path(name).parts
        unix_type = stat.S_IFMT(entry.external_attr >> 16)
        unsafe_type = (
            unix_type not in {0, stat.S_IFDIR}
            if entry.is_dir()
            else unix_type not in {0, stat.S_IFREG}
        )
        if (
            name.startswith("/")
            or re.match(r"^[A-Za-z]:", name) is not None
            or ".." in parts
            or "\\" in name
            or unsafe_type
        ):
            errors.append(f"{label}: archive contains unsafe path {name!r}")
    return errors


def class_errors(data: bytes, name: str, module: str) -> list[str]:
    if len(data) < 8 or data[:4] != b"\xca\xfe\xba\xbe":
        return [f"{module} main: malformed class header: {name}"]
    major = struct.unpack(">H", data[6:8])[0]
    errors = [] if major == CLASS_MAJOR else [f"{module} main: {name} is class major {major}, expected {CLASS_MAJOR}"]
    if not name.startswith("at/bernhardberger/tvheadend/sdk/"):
        errors.append(f"{module} main: class lies outside the SDK package root: {name}")
    return errors


def legal_errors(archive: zipfile.ZipFile, names: list[str], label: str) -> list[str]:
    errors: list[str] = []
    for required in ("META-INF/LICENSE", "META-INF/NOTICE"):
        if names.count(required) != 1:
            errors.append(f"{label}: archive must contain exactly one {required}")
    if names.count("META-INF/LICENSE") == 1:
        if "GNU GENERAL PUBLIC LICENSE" not in archive.read("META-INF/LICENSE").decode("utf-8", "replace"):
            errors.append(f"{label}: archived LICENSE lacks GPLv3 evidence")
    if names.count("META-INF/NOTICE") == 1:
        if "Preclikos/tvhstream" not in archive.read("META-INF/NOTICE").decode("utf-8", "replace"):
            errors.append(f"{label}: archived NOTICE lacks predecessor evidence")
    return errors


def jar_errors(module: str, kind: str, path: Path) -> list[str]:
    label = f"{module} {kind}"
    errors: list[str] = []
    try:
        with zipfile.ZipFile(path) as archive:
            names = archive.namelist()
            errors.extend(safe_archive_entries(archive.infolist(), label))
            errors.extend(legal_errors(archive, names, label))
            classes = [name for name in names if name.endswith(".class")]
            sources = [name for name in names if name.endswith(".kt")]
            if kind == "main":
                if not classes:
                    errors.append(f"{label}: archive contains no JVM classes")
                for name in classes:
                    errors.extend(class_errors(archive.read(name), name, module))
            elif classes:
                errors.append(f"{label}: documentation/source archive contains class files")
            if kind == "sources" and not sources:
                errors.append(f"{label}: archive contains no Kotlin sources")
            if kind == "javadoc":
                if sources:
                    errors.append(f"{label}: documentation archive contains Kotlin sources")
                if names.count("index.html") != 1:
                    errors.append(f"{label}: Dokka index.html is missing")
    except (OSError, zipfile.BadZipFile) as error:
        errors.append(f"{label}: malformed ZIP/JAR: {error}")
    return errors


def aar_errors(module: str, path: Path) -> list[str]:
    label = f"{module} main"
    errors: list[str] = []
    expected_native = (
        {
            "jni/arm64-v8a/libffmpegJNI.so",
            "jni/armeabi-v7a/libffmpegJNI.so",
            "jni/x86/libffmpegJNI.so",
            "jni/x86_64/libffmpegJNI.so",
        }
        if module == "sdk-media3"
        else set()
    )
    expected_libraries = {FFMPEG_LIBRARY} if module == "sdk-media3" else set()
    try:
        with zipfile.ZipFile(path) as archive:
            names = archive.namelist()
            errors.extend(safe_archive_entries(archive.infolist(), label))
            native = {name for name in names if name.endswith(".so")}
            if native != expected_native:
                errors.append(f"{label}: native inventory {sorted(native)} does not match {sorted(expected_native)}")
            libraries = {name for name in names if name.startswith("libs/") and name.endswith(".jar")}
            if libraries != expected_libraries:
                errors.append(
                    f"{label}: embedded library inventory {sorted(libraries)} "
                    f"does not match {sorted(expected_libraries)}"
                )
            if FFMPEG_LIBRARY in libraries:
                try:
                    with zipfile.ZipFile(io.BytesIO(archive.read(FFMPEG_LIBRARY))) as ffmpeg:
                        errors.extend(safe_archive_entries(ffmpeg.infolist(), f"{label} FFmpeg JAR"))
                        classes = {name for name in ffmpeg.namelist() if name.endswith(".class")}
                        if classes != FFMPEG_CLASSES:
                            errors.append(
                                f"{label}: embedded FFmpeg class inventory {sorted(classes)} "
                                f"does not match {sorted(FFMPEG_CLASSES)}"
                            )
                        for name in classes:
                            data = ffmpeg.read(name)
                            if len(data) < 8 or data[:4] != b"\xca\xfe\xba\xbe":
                                errors.append(f"{label}: malformed embedded FFmpeg class: {name}")
                                continue
                            major = struct.unpack(">H", data[6:8])[0]
                            if major != FFMPEG_CLASS_MAJOR:
                                errors.append(
                                    f"{label}: embedded FFmpeg class {name} is class major {major}, "
                                    f"expected {FFMPEG_CLASS_MAJOR}"
                                )
                except (OSError, zipfile.BadZipFile) as error:
                    errors.append(f"{label}: malformed embedded FFmpeg JAR: {error}")
            if names.count("classes.jar") != 1:
                errors.append(f"{label}: AAR must contain exactly one classes.jar")
            else:
                with zipfile.ZipFile(io.BytesIO(archive.read("classes.jar"))) as classes_jar:
                    class_names = classes_jar.namelist()
                    errors.extend(safe_archive_entries(classes_jar.infolist(), f"{label} classes.jar"))
                    errors.extend(legal_errors(classes_jar, class_names, f"{label} classes.jar"))
                    classes = [name for name in class_names if name.endswith(".class")]
                    if not classes:
                        errors.append(f"{label}: classes.jar contains no JVM classes")
                    for name in classes:
                        errors.extend(class_errors(classes_jar.read(name), name, module))
    except (OSError, zipfile.BadZipFile) as error:
        errors.append(f"{label}: malformed AAR: {error}")
    return errors


def verify(
    repository: Path = REPOSITORY,
    *,
    enforce_path: bool = True,
    ffmpeg_source: Path | None = None,
) -> tuple[list[str], dict[str, str]]:
    errors = topology_errors(repository) if enforce_path else []
    if not enforce_path:
        if VERSION not in ALLOWED_VERSIONS:
            errors.append(f"publication version must be exactly one of {sorted(ALLOWED_VERSIONS)}: {VERSION!r}")
        reject_symlinks(repository, errors)
    resolved_modules: dict[str, ResolvedModule] = {}
    for module in sorted(MODULES):
        resolved = resolve_module(repository, module, errors)
        if resolved is None:
            continue
        resolved_modules[module] = resolved
        errors.extend(checksum_errors(module, resolved))
        if "pom" in resolved.files:
            errors.extend(pom_errors(module, resolved.files["pom"]))
        if "module" in resolved.files:
            errors.extend(module_metadata_errors(module, resolved.files["module"], resolved))
        if "main" in resolved.files:
            if MODULES[module].android:
                errors.extend(aar_errors(module, resolved.files["main"]))
            else:
                errors.extend(jar_errors(module, "main", resolved.files["main"]))
        for label in ("sources", "javadoc"):
            if label in resolved.files:
                errors.extend(jar_errors(module, label, resolved.files[label]))
    originals = {
        str(path.relative_to(repository)): sha256(path)
        for resolved in resolved_modules.values()
        for path in resolved.files.values()
    }
    if len(originals) != 26:
        errors.append(f"publication contains {len(originals)} originals, expected 26")
    media3 = resolved_modules.get("sdk-media3")
    if media3 is not None and "ffmpeg-sources" in media3.files:
        source = ffmpeg_source or ROOT / "third_party/ffmpeg/ffmpeg-6.0-3f92512f-sources.tar.xz"
        try:
            staged = media3.files["ffmpeg-sources"]
            if sha256(staged) != FFMPEG_SHA256 or staged.read_bytes() != source.read_bytes():
                errors.append("sdk-media3 ffmpeg-sources: staged bytes differ from the approved GPL source archive")
        except OSError as error:
            errors.append(f"sdk-media3 ffmpeg-sources: source comparison failed: {error}")
    return sorted(set(errors)), dict(sorted(originals.items()))


