def self_test() -> list[str]:
    errors: list[str] = []
    if VERSION not in ALLOWED_VERSIONS or not STRICT_RELEASE_VERSION.fullmatch(RELEASE_BASE):
        return ["self-test requires a strict configured major-zero release or snapshot"]
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        repository, source = create_fixture(root)
        baseline, manifest = verify(repository, enforce_path=False, ffmpeg_source=source)
        if baseline:
            errors.append("self-test rejected valid five-module publication: " + "; ".join(baseline))
        if len(manifest) != 26:
            errors.append(f"self-test manifest has {len(manifest)} originals instead of 26")

        def mutate_and_check(label: str, mutate: Callable[[Path, Path], None], expected: str) -> None:
            case = root / label.replace(" ", "-")
            repo, fixture_source = create_fixture(case)
            mutate(repo, fixture_source)
            actual, _ = verify(repo, enforce_path=False, ffmpeg_source=fixture_source)
            if not any(expected in item for item in actual):
                errors.append(f"self-test accepted {label} without {expected!r}: {actual}")

        def version_dir(repo: Path, module: str) -> Path:
            return repo.joinpath(*GROUP.split("."), module, VERSION)

        def artifact(repo: Path, module: str, label: str) -> Path:
            kind = next(item for item in kinds(module) if item.label == label)
            return version_dir(repo, module) / expected_name(module, VERSION, kind)

        def rewrite(path: Path, data: bytes) -> None:
            path.write_bytes(data)
            path.with_name(path.name + ".sha256").write_text(hashlib.sha256(data).hexdigest() + "\n", encoding="ascii")

        mutate_and_check(
            "missing original",
            lambda repo, _source: artifact(repo, "sdk-core", "main").unlink(),
            "expected one regular artifact",
        )
        mutate_and_check(
            "extra original",
            lambda repo, _source: (version_dir(repo, "sdk-core") / "unexpected.jar").write_bytes(b"x"),
            "version inventory mismatch",
        )
        mutate_and_check(
            "wrong checksum",
            lambda repo, _source: artifact(repo, "sdk-core", "pom").with_name(
                artifact(repo, "sdk-core", "pom").name + ".sha256"
            ).write_text("0" * 64 + "\n"),
            "does not match artifact bytes",
        )

        def wrong_pom(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-core", "pom")
            rewrite(path, path.read_bytes().replace(GROUP.encode(), b"invalid.group", 1))
        mutate_and_check("wrong POM coordinate", wrong_pom, "POM: groupId")

        def optional_pom_dependency(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-core", "pom")
            rewrite(path, path.read_bytes().replace(b"</scope>", b"</scope><optional>true</optional>", 1))
        mutate_and_check("optional POM dependency", optional_pom_dependency, "exact XML structure")

        def excluded_pom_dependency(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-core", "pom")
            exclusion = b"<exclusions><exclusion><groupId>x</groupId><artifactId>y</artifactId></exclusion></exclusions>"
            rewrite(path, path.read_bytes().replace(b"</dependency>", exclusion + b"</dependency>", 1))
        mutate_and_check("excluded POM dependency", excluded_pom_dependency, "exact XML structure")

        def unexpected_pom_element(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-core", "pom")
            rewrite(path, path.read_bytes().replace(b"</project>", b"<repositories/></project>", 1))
        mutate_and_check("unexpected POM element", unexpected_pom_element, "exact XML structure")

        def wrong_module_dependency(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-core", "module")
            model = json.loads(path.read_text())
            model["variants"][0]["dependencies"][0]["version"]["requires"] = "9.9.9"
            rewrite(path, json.dumps(model, sort_keys=True).encode())
        mutate_and_check("wrong module dependency", wrong_module_dependency, "dependencies")

        def wrong_module_usage(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-core", "module")
            model = json.loads(path.read_text())
            model["variants"][0]["attributes"]["org.gradle.usage"] = "java-runtime"
            rewrite(path, json.dumps(model, sort_keys=True).encode())
        mutate_and_check("wrong module usage", wrong_module_usage, "exact Gradle metadata semantics")

        def extra_module_dependency_field(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-core", "module")
            model = json.loads(path.read_text())
            model["variants"][0]["dependencies"][0]["reason"] = "unexpected"
            rewrite(path, json.dumps(model, sort_keys=True).encode())
        mutate_and_check("extra module dependency field", extra_module_dependency_field, "exact Gradle metadata semantics")

        def extra_module_file_field(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-core", "module")
            model = json.loads(path.read_text())
            model["variants"][0]["files"][0]["unexpected"] = True
            rewrite(path, json.dumps(model, sort_keys=True).encode())
        mutate_and_check("extra module file field", extra_module_file_field, "exact Gradle metadata semantics")

        mutate_and_check(
            "wrong class major",
            lambda repo, _source: rewrite(artifact(repo, "sdk-core", "main"), archive_fixture("sdk-core", "main", True)),
            "class major 60",
        )
        mutate_and_check(
            "wrong FFmpeg source",
            lambda repo, _source: rewrite(artifact(repo, "sdk-media3", "ffmpeg-sources"), b"changed"),
            "approved GPL source archive",
        )

        def missing_ffmpeg_library(repo: Path, _source: Path) -> None:
            path = artifact(repo, "sdk-media3", "main")
            output = io.BytesIO()
            with zipfile.ZipFile(path) as source_archive, zipfile.ZipFile(output, "w") as target_archive:
                for info in source_archive.infolist():
                    if info.filename != FFMPEG_LIBRARY:
                        target_archive.writestr(info, source_archive.read(info.filename))
