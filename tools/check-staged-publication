#!/usr/bin/env python3
"""Verify the staged five-module SDK publication and record its exact bytes."""

from __future__ import annotations

import hashlib
import io
import json
import re
import stat
import sys
import zipfile
import xml.etree.ElementTree as ET
from dataclasses import dataclass
from pathlib import Path
from typing import Callable


ROOT = Path(__file__).resolve().parents[1]
REPOSITORY = ROOT / "build/local-maven"
GROUP = "at.bernhardberger.tvheadend"
VERSION_PATTERN = re.compile(r"0\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)")
CHECKSUM_SUFFIXES = (".md5", ".sha1", ".sha256", ".sha512")
LEGAL_ENTRIES = ("META-INF/LICENSE", "META-INF/NOTICE")
PROJECT_URL = "https://github.com/bernhardberger/tvheadend-sdk"
FFMPEG_JAR = ROOT / "sdk-media3/libs/media3-decoder-ffmpeg-1.11.0.jar"
FFMPEG_SOURCE = ROOT / "third_party/ffmpeg/ffmpeg-6.0-3f92512f-sources.tar.xz"
FFMPEG_CLASSES = {
    "androidx/media3/decoder/ffmpeg/ExperimentalFfmpegVideoRenderer.class",
    "androidx/media3/decoder/ffmpeg/FfmpegAudioDecoder.class",
    "androidx/media3/decoder/ffmpeg/FfmpegAudioRenderer.class",
    "androidx/media3/decoder/ffmpeg/FfmpegDecoderException.class",
    "androidx/media3/decoder/ffmpeg/FfmpegLibrary$1.class",
    "androidx/media3/decoder/ffmpeg/FfmpegLibrary.class",
    "androidx/media3/decoder/ffmpeg/package-info.class",
}
FFMPEG_NATIVES = {
    f"jni/{abi}/libffmpegJNI.so"
    for abi in ("arm64-v8a", "armeabi-v7a", "x86", "x86_64")
}


class VerificationError(RuntimeError):
    """A staged published-byte invariant failed."""


@dataclass(frozen=True)
class Module:
    main_extension: str
    android: bool = False
    ffmpeg: bool = False


MODULES = {
    "sdk-android": Module("aar", android=True),
    "sdk-core": Module("jar"),
    "sdk-media3": Module("aar", android=True, ffmpeg=True),
    "sdk-playback": Module("jar"),
    "sdk-testing": Module("jar"),
}


def require(condition: bool, message: str) -> None:
    if not condition:
        raise VerificationError(message)


def read_regular(path: Path, label: str) -> bytes:
    try:
        require(stat.S_ISREG(path.lstat().st_mode), f"{label} is not a regular file")
        return path.read_bytes()
    except FileNotFoundError as error:
        raise VerificationError(f"{label} is missing") from error
    except OSError as error:
        raise VerificationError(f"{label} cannot be read") from error


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def configured_version(build_text: str | None = None) -> str:
    if build_text is None:
        build_text = read_regular(ROOT / "build.gradle.kts", "build configuration").decode("utf-8")
    groups = re.findall(r'(?m)^group\s*=\s*"([^"]+)"\s*$', build_text)
    versions = re.findall(r'(?m)^version\s*=\s*"([^"]+)"\s*$', build_text)
    require(groups == [GROUP], f"publication group must be exactly {GROUP}")
    require(len(versions) == 1, "publication version must be one literal assignment")
    require(VERSION_PATTERN.fullmatch(versions[0]) is not None, "publication version must be a strict major-zero release")
    return versions[0]


def artifact_names(module: str, version: str) -> dict[str, str]:
    spec = MODULES[module]
    names = {
        "main": f"{module}-{version}.{spec.main_extension}",
        "sources": f"{module}-{version}-sources.jar",
        "javadoc": f"{module}-{version}-javadoc.jar",
        "pom": f"{module}-{version}.pom",
        "module": f"{module}-{version}.module",
    }
    if spec.ffmpeg:
        names["ffmpeg-sources"] = f"{module}-{version}-ffmpeg-sources.tar.xz"
    return names


def expected_originals(version: str) -> dict[str, tuple[str, str]]:
    base = GROUP.replace(".", "/")
    result = {
        f"{base}/{module}/{version}/{name}": (module, label)
        for module in sorted(MODULES)
        for label, name in artifact_names(module, version).items()
    }
    require(len(result) == 26, "publication inventory must contain exactly 26 originals")
    return result


def pom_dependencies(module: str, version: str) -> set[tuple[str, str, str, str]]:
    return {
        "sdk-android": {
            (GROUP, "sdk-core", version, "compile"),
            ("io.coil-kt.coil3", "coil-core", "3.5.0", "compile"),
            ("org.jetbrains.kotlinx", "kotlinx-coroutines-core", "1.10.2", "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
            ("androidx.datastore", "datastore-preferences", "1.2.1", "runtime"),
            ("com.google.crypto.tink", "tink-android", "1.23.0", "runtime"),
        },
        "sdk-core": {
            ("org.jetbrains.kotlinx", "kotlinx-coroutines-core-jvm", "1.10.2", "compile"),
            (GROUP, "sdk-playback", version, "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
            (GROUP, "htsp", "0.7.0", "runtime"),
        },
        "sdk-media3": {
            (GROUP, "sdk-core", version, "compile"),
            (GROUP, "sdk-playback", version, "compile"),
            ("androidx.media3", "media3-exoplayer", "1.11.0", "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
            ("androidx.media3", "media3-extractor", "1.11.0", "runtime"),
            ("org.jetbrains.kotlinx", "kotlinx-coroutines-core", "1.10.2", "runtime"),
        },
        "sdk-playback": {
            ("org.jetbrains.kotlinx", "kotlinx-coroutines-core-jvm", "1.10.2", "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
        },
        "sdk-testing": {
            (GROUP, "sdk-core", version, "compile"),
            (GROUP, "sdk-playback", version, "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
        },
    }[module]


def module_variants(module: str, version: str) -> dict[str, tuple[str, set[tuple[str, str, str]]]]:
    pom = pom_dependencies(module, version)
    api = {
        (group, "kotlinx-coroutines-core" if artifact == "kotlinx-coroutines-core-jvm" else artifact, dependency_version)
        for group, artifact, dependency_version, scope in pom
        if scope == "compile"
    }
    runtime = api | {
        (group, artifact, dependency_version)
        for group, artifact, dependency_version, scope in pom
        if scope == "runtime"
    }
    if MODULES[module].android:
        return {
            "releaseVariantReleaseApiPublication": ("main", api),
            "releaseVariantReleaseRuntimePublication": ("main", runtime),
            "releaseVariantReleaseSourcePublication": ("sources", set()),
        }
    return {
        "apiElements": ("main", api),
        "runtimeElements": ("main", runtime),
        "sourcesElements": ("sources", set()),
        "javadocElements": ("javadoc", set()),
    }


def xml_children(parent: ET.Element, name: str) -> list[ET.Element]:
    return [child for child in parent if child.tag.rsplit("}", 1)[-1] == name]


def xml_one(parent: ET.Element, name: str, label: str) -> ET.Element:
    found = xml_children(parent, name)
    require(len(found) == 1, f"{label} must contain exactly one {name}")
    return found[0]


def xml_text(parent: ET.Element, name: str, label: str) -> str:
    value = (xml_one(parent, name, label).text or "").strip()
    require(bool(value), f"{label} {name} must not be empty")
    return value


def verify_pom(data: bytes, module: str, version: str) -> None:
    try:
        root = ET.fromstring(data)
    except ET.ParseError as error:
        raise VerificationError(f"{module} POM is malformed") from error
    label = f"{module} POM"
    expected = {
        "modelVersion": "4.0.0",
        "groupId": GROUP,
        "artifactId": module,
        "version": version,
        "name": module,
        "url": PROJECT_URL,
    }
    for name, value in expected.items():
        require(xml_text(root, name, label) == value, f"{label} has the wrong {name}")
    require(bool(xml_text(root, "description", label)), f"{label} description is missing")
    license_node = xml_one(xml_one(root, "licenses", label), "license", label)
    require(
        tuple(xml_text(license_node, name, label) for name in ("name", "url", "distribution")) ==
        ("GNU General Public License v3.0", "https://www.gnu.org/licenses/gpl-3.0.html", "repo"),
        f"{label} GPLv3 metadata differs",
    )
    developer = xml_one(xml_one(root, "developers", label), "developer", label)
    require(
        tuple(xml_text(developer, name, label) for name in ("id", "name", "url")) ==
        ("bernhardberger", "Bernhard Berger", "https://github.com/bernhardberger"),
        f"{label} developer metadata differs",
    )
    scm = xml_one(root, "scm", label)
    require(
        tuple(xml_text(scm, name, label) for name in ("connection", "developerConnection", "url")) ==
        ("scm:git:https://github.com/bernhardberger/tvheadend-sdk.git", "scm:git:ssh://git@github.com/bernhardberger/tvheadend-sdk.git", PROJECT_URL),
        f"{label} SCM metadata differs",
    )
    issues = xml_one(root, "issueManagement", label)
    require(
        (xml_text(issues, "system", label), xml_text(issues, "url", label)) ==
        ("GitHub Issues", f"{PROJECT_URL}/issues"),
        f"{label} issue metadata differs",
    )
    dependencies = xml_children(xml_one(root, "dependencies", label), "dependency")
    coordinates: list[tuple[str, str, str, str]] = []
    for dependency in dependencies:
        require(
            {child.tag.rsplit("}", 1)[-1] for child in dependency} == {"groupId", "artifactId", "version", "scope"},
            f"{label} dependency contains unsupported metadata",
        )
        coordinates.append(tuple(xml_text(dependency, name, label) for name in ("groupId", "artifactId", "version", "scope")))
    require(len(coordinates) == len(set(coordinates)), f"{label} contains duplicate dependencies")
    require(set(coordinates) == pom_dependencies(module, version), f"{label} dependencies differ")


def verify_module_metadata(data: bytes, module: str, version: str, artifacts: dict[str, bytes]) -> None:
    try:
        model = json.loads(data.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise VerificationError(f"{module} Gradle metadata is malformed") from error
    require(isinstance(model, dict), f"{module} Gradle metadata must be an object")
    require(model.get("formatVersion") == "1.1", f"{module} Gradle metadata format is not 1.1")
    component = model.get("component")
    require(isinstance(component, dict), f"{module} Gradle metadata component is missing")
    require(
        {name: component.get(name) for name in ("group", "module", "version")} ==
        {"group": GROUP, "module": module, "version": version},
        f"{module} Gradle metadata has the wrong component identity",
    )
    require(component.get("attributes") == {"org.gradle.status": "release"}, f"{module} Gradle metadata has the wrong status")
    names = artifact_names(module, version)
    by_name = {names[label]: data for label, data in artifacts.items() if label in names}
    variants = model.get("variants")
    require(isinstance(variants, list) and all(isinstance(value, dict) for value in variants), f"{module} Gradle metadata variants are malformed")
    require(all(isinstance(value.get("name"), str) for value in variants), f"{module} Gradle metadata has an unnamed variant")
    by_variant = {value["name"]: value for value in variants}
    specs = module_variants(module, version)
    require(len(by_variant) == len(variants) and set(by_variant) == set(specs), f"{module} Gradle metadata variants differ")
    for variant_name, (label, expected_dependencies) in specs.items():
        variant = by_variant[variant_name]
        attributes = variant.get("attributes")
        require(isinstance(attributes, dict), f"{module} {variant_name} attributes are malformed")
        if label in {"sources", "javadoc"}:
            require(attributes.get("org.gradle.category") == "documentation" and attributes.get("org.gradle.docstype") == label, f"{module} {variant_name} documentation attributes differ")
        else:
            require(attributes.get("org.gradle.category") == "library" and attributes.get("org.gradle.libraryelements") == MODULES[module].main_extension, f"{module} {variant_name} library attributes differ")
            require(MODULES[module].android or attributes.get("org.gradle.jvm.version") == 17, f"{module} {variant_name} JVM target differs")
        dependencies = variant.get("dependencies", [])
        require(isinstance(dependencies, list), f"{module} {variant_name} dependencies are malformed")
        actual_dependencies: list[tuple[str, str, str]] = []
        for dependency in dependencies:
            require(isinstance(dependency, dict) and set(dependency) == {"group", "module", "version"}, f"{module} {variant_name} dependency shape differs")
            dependency_version = dependency.get("version")
            require(isinstance(dependency_version, dict) and set(dependency_version) == {"requires"}, f"{module} {variant_name} dependency version differs")
            coordinate = (dependency.get("group"), dependency.get("module"), dependency_version.get("requires"))
            require(all(isinstance(value, str) for value in coordinate), f"{module} {variant_name} dependency coordinate is malformed")
            actual_dependencies.append(coordinate)
        require(len(actual_dependencies) == len(set(actual_dependencies)) and set(actual_dependencies) == expected_dependencies, f"{module} {variant_name} dependencies differ")
        files = variant.get("files")
        require(isinstance(files, list) and len(files) == 1 and isinstance(files[0], dict), f"{module} {variant_name} file metadata differs")
        entry = files[0]
        name = names[label]
        current = by_name[name]
        require(entry.get("name") == name and entry.get("url") == name and entry.get("size") == len(current) and entry.get("sha256") == sha256(current), f"{module} {variant_name} file identity differs")


def safe_zip(archive: zipfile.ZipFile, label: str) -> list[str]:
    entries = archive.infolist()
    names = [entry.filename for entry in entries]
    require(len(names) == len(set(names)), f"{label} contains duplicate entries")
    for entry in entries:
        name = entry.filename
        unix_type = stat.S_IFMT(entry.external_attr >> 16)
        require(
            not name.startswith("/") and ".." not in Path(name).parts and "\\" not in name and re.match(r"^[A-Za-z]:", name) is None and
            (entry.create_system != 3 or unix_type in {0, stat.S_IFREG, stat.S_IFDIR}),
            f"{label} contains an unsafe archive entry",
        )
    return names


def verify_legal(archive: zipfile.ZipFile, names: list[str], label: str) -> None:
    for name in LEGAL_ENTRIES:
        require(names.count(name) == 1, f"{label} must contain exactly one {name}")
    require("META-INF/NOTICE.md" not in names, f"{label} contains the nonstandard NOTICE.md entry")
    require(b"GNU GENERAL PUBLIC LICENSE" in archive.read("META-INF/LICENSE"), f"{label} lacks GPLv3 evidence")
    require(b"Preclikos/tvhstream" in archive.read("META-INF/NOTICE"), f"{label} lacks predecessor attribution")


def verify_jar(data: bytes, kind: str, label: str) -> None:
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as archive:
            names = safe_zip(archive, label)
            verify_legal(archive, names, label)
            if kind == "main":
                require(any(name.endswith(".class") for name in names), f"{label} contains no classes")
            elif kind == "sources":
                require(any(name.endswith(".kt") for name in names), f"{label} contains no Kotlin sources")
            elif kind == "javadoc":
                require(names.count("index.html") == 1, f"{label} lacks Dokka index.html")
    except zipfile.BadZipFile as error:
        raise VerificationError(f"{label} is not a valid ZIP archive") from error


def verify_ffmpeg_jar(data: bytes, label: str) -> None:
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as archive, zipfile.ZipFile(FFMPEG_JAR) as approved:
            names = safe_zip(archive, f"{label} embedded FFmpeg JAR")
            require({name for name in names if not name.endswith("/")} == FFMPEG_CLASSES, f"{label} embeds an unexpected FFmpeg payload")
            classes = {name: archive.read(name) for name in names if name.endswith(".class")}
            expected = {name: approved.read(name) for name in FFMPEG_CLASSES}
            require(set(classes) == FFMPEG_CLASSES and classes == expected, f"{label} embeds different FFmpeg classes")
            require(all(len(value) >= 8 and value[:4] == b"\xca\xfe\xba\xbe" and int.from_bytes(value[6:8], "big") == 52 for value in classes.values()), f"{label} embeds a non-Java-8 FFmpeg class")
    except (KeyError, zipfile.BadZipFile) as error:
        raise VerificationError(f"{label} has a malformed FFmpeg JAR") from error


def verify_ffmpeg_source(data: bytes) -> None:
    require(data == read_regular(FFMPEG_SOURCE, "approved FFmpeg source archive"), "sdk-media3 staged FFmpeg source bytes differ")


def verify_aar(data: bytes, module: str) -> None:
    label = f"{module} AAR"
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as archive:
            names = safe_zip(archive, label)
            require(names.count("classes.jar") == 1, f"{label} must contain exactly one classes.jar")
            verify_jar(archive.read("classes.jar"), "main", f"{label} classes.jar")
            if module != "sdk-media3":
                return
            embedded = "libs/media3-decoder-ffmpeg-1.11.0.jar"
            require(names.count(embedded) == 1, f"{label} lacks the exact embedded FFmpeg JAR")
            verify_ffmpeg_jar(archive.read(embedded), label)
            natives = {name for name in names if name.endswith(".so")}
            require(natives == FFMPEG_NATIVES, f"{label} has the wrong FFmpeg native inventory")
            for name in sorted(FFMPEG_NATIVES):
                local = ROOT / "sdk-media3/src/main/jniLibs" / Path(name).relative_to("jni")
                require(archive.read(name) == read_regular(local, f"approved {Path(name).name}"), f"{label} embeds different FFmpeg native bytes")
    except zipfile.BadZipFile as error:
        raise VerificationError(f"{label} is not a valid ZIP archive") from error


def verify(repository: Path = REPOSITORY) -> dict[str, str]:
    version = configured_version()
    require(repository.is_dir() and not repository.is_symlink(), "staged Maven repository is missing or unsafe")
    expected = expected_originals(version)
    group_directory = repository.joinpath(*GROUP.split("."))
    try:
        modules = {entry.name for entry in group_directory.iterdir() if entry.is_dir() and not entry.is_symlink()}
    except OSError as error:
        raise VerificationError("staged Maven group cannot be inspected") from error
    require(modules == set(MODULES), "staged Maven repository does not contain exactly the five SDK modules")
    manifest: dict[str, str] = {}
    for module in sorted(MODULES):
        names = artifact_names(module, version)
        directory = group_directory / module / version
        try:
            entries = list(directory.iterdir())
        except OSError as error:
            raise VerificationError(f"{module} staged directory cannot be inspected") from error
        actual = {entry.name for entry in entries if entry.is_file() and not entry.is_symlink()}
        allowed = set(names.values()) | {name + suffix for name in names.values() for suffix in CHECKSUM_SUFFIXES}
        require(set(names.values()) <= actual, f"{module} staged publication omits a required original")
        require(actual <= allowed and all(entry.is_file() and not entry.is_symlink() for entry in entries), f"{module} staged publication contains an unexpected entry")
        artifacts = {label: read_regular(directory / name, f"{module} {label}") for label, name in names.items()}
        verify_pom(artifacts["pom"], module, version)
        verify_module_metadata(artifacts["module"], module, version, artifacts)
        if MODULES[module].android:
            verify_aar(artifacts["main"], module)
        else:
            verify_jar(artifacts["main"], "main", f"{module} main JAR")
        verify_jar(artifacts["sources"], "sources", f"{module} sources JAR")
        verify_jar(artifacts["javadoc"], "javadoc", f"{module} Javadoc JAR")
        if MODULES[module].ffmpeg:
            verify_ffmpeg_source(artifacts["ffmpeg-sources"])
        for label, name in names.items():
            relative = f"{GROUP.replace('.', '/')}/{module}/{version}/{name}"
            require(expected.get(relative) == (module, label), "internal staged inventory differs")
            manifest[relative] = sha256(artifacts[label])
    require(set(manifest) == set(expected), "staged publication does not contain the exact 26 originals")
    return dict(sorted(manifest.items()))


def manifest_path(argument: str) -> Path:
    path = Path(argument)
    path = path if path.is_absolute() else ROOT / path
    resolved = path.resolve(strict=False)
    build = (ROOT / "build").resolve(strict=False)
    require(resolved != build and build in resolved.parents, "manifest path must be below checkout build")
    return resolved


def expect_error(errors: list[str], label: str, action: Callable[[], object]) -> None:
    try:
        action()
    except VerificationError:
        return
    errors.append(f"self-test accepted {label}")


def self_test() -> list[str]:
    errors: list[str] = []
    build = f'group = "{GROUP}"\nversion = "0.1.2"\n'
    if configured_version(build) != "0.1.2" or len(expected_originals("0.1.2")) != 26:
        errors.append("self-test rejected the exact five-module release identity")
    expect_error(errors, "snapshot version", lambda: configured_version(build.replace("0.1.2", "0.1.2-SNAPSHOT")))
    expect_error(errors, "wrong group", lambda: configured_version(build.replace(GROUP, "invalid.example")))
    legal = {
        "META-INF/LICENSE": b"GNU GENERAL PUBLIC LICENSE Version 3",
        "META-INF/NOTICE": b"Derived from Preclikos/tvhstream",
        "example/Test.class": b"class",
    }

    def archive(entries: dict[str, bytes]) -> bytes:
        output = io.BytesIO()
        with zipfile.ZipFile(output, "w") as target:
            for name, data in entries.items():
                target.writestr(name, data)
        return output.getvalue()

    try:
        verify_jar(archive(legal), "main", "synthetic JAR")
    except VerificationError as error:
        errors.append(f"self-test rejected a valid synthetic JAR: {error}")
    expect_error(errors, "missing standard notice", lambda: verify_jar(archive({key: value for key, value in legal.items() if key != "META-INF/NOTICE"}), "main", "synthetic JAR"))
    expect_error(errors, "nonstandard notice", lambda: verify_jar(archive({**legal, "META-INF/NOTICE.md": b"duplicate"}), "main", "synthetic JAR"))
    approved_source = read_regular(FFMPEG_SOURCE, "approved FFmpeg source archive")
    try:
        verify_ffmpeg_source(approved_source)
        approved_jar = read_regular(FFMPEG_JAR, "approved FFmpeg JAR")
        verify_ffmpeg_jar(approved_jar, "approved FFmpeg JAR")
        with zipfile.ZipFile(io.BytesIO(approved_jar)) as ffmpeg:
            classes = {name: ffmpeg.read(name) for name in FFMPEG_CLASSES}
        classes[next(iter(sorted(classes)))] = b"changed"
        expect_error(errors, "altered FFmpeg class", lambda: verify_ffmpeg_jar(archive(classes), "synthetic FFmpeg JAR"))
        classes.pop(next(iter(sorted(classes))))
        expect_error(errors, "missing FFmpeg class", lambda: verify_ffmpeg_jar(archive(classes), "synthetic FFmpeg JAR"))
        expect_error(errors, "altered FFmpeg source", lambda: verify_ffmpeg_source(approved_source + b"changed"))
    except (VerificationError, zipfile.BadZipFile) as error:
        errors.append(f"self-test rejected approved FFmpeg inputs: {error}")
    try:
        manifest_path("build/publication-manifest.json")
    except VerificationError as error:
        errors.append(f"self-test rejected a build-local manifest: {error}")
    expect_error(errors, "manifest escape", lambda: manifest_path("../publication-manifest.json"))
    return errors


def main() -> int:
    arguments = sys.argv[1:]
    try:
        if arguments == ["--self-test"]:
            errors = self_test()
            for error in errors:
                print(f"error: {error}", file=sys.stderr)
            if errors:
                return 1
            print("Staged publication focused self-tests passed")
            return 0
        if arguments and (len(arguments) != 2 or arguments[0] not in {"--write-manifest", "--compare-manifest"}):
            print("usage: check-staged-publication [--self-test|--write-manifest PATH|--compare-manifest PATH]", file=sys.stderr)
            return 2
        manifest = verify()
        if arguments:
            path = manifest_path(arguments[1])
            if arguments[0] == "--write-manifest":
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            else:
                try:
                    expected = json.loads(read_regular(path, "comparison manifest").decode("utf-8"))
                except (UnicodeError, json.JSONDecodeError) as error:
                    raise VerificationError("comparison manifest is malformed") from error
                require(expected == manifest, "recreated publication bytes differ from the recorded manifest")
        print("Staged SDK publication passed: five modules, 26 originals, metadata, legal notices, and FFmpeg payload/source")
        return 0
    except (VerificationError, UnicodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except OSError:
        print("error: staged publication output could not be written", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
