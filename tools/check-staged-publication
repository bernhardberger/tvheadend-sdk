def configured_version(root: Path = ROOT) -> str:
    try:
        text = (root / "build.gradle.kts").read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return ""
    matches = re.findall(r'^version = "([^"]+)"[ \t]*$', text, re.M)
    return matches[0] if len(matches) == 1 else ""


VERSION = configured_version()
RELEASE_BASE = VERSION.removesuffix("-SNAPSHOT")
ALLOWED_VERSIONS = (
    {RELEASE_BASE, f"{RELEASE_BASE}-SNAPSHOT"}
    if STRICT_RELEASE_VERSION.fullmatch(RELEASE_BASE)
    else set()
)


def kinds(module: str) -> tuple[Kind, ...]:
    spec = MODULES[module]
    result = [
        Kind("main", spec.main_extension),
        Kind("sources", "jar", "sources"),
        Kind("javadoc", "jar", "javadoc"),
        Kind("pom", "pom"),
        Kind("module", "module"),
    ]
    if spec.ffmpeg_sources:
        result.append(Kind("ffmpeg-sources", "tar.xz", "ffmpeg-sources"))
    return tuple(result)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def digest_bytes(name: str, data: bytes) -> str:
    return hashlib.new(name, data).hexdigest()


def local_name(tag: str) -> str:
    return tag.rsplit("}", 1)[-1]


def children(parent: ET.Element, name: str) -> list[ET.Element]:
    return [child for child in parent if local_name(child.tag) == name]


def one_child(parent: ET.Element, name: str, label: str, errors: list[str]) -> ET.Element | None:
    found = children(parent, name)
    if len(found) != 1:
        errors.append(f"{label}: expected exactly one <{name}>, found {len(found)}")
        return None
    return found[0]


def one_text(parent: ET.Element, name: str, label: str, errors: list[str]) -> str | None:
    node = one_child(parent, name, label, errors)
    if node is None:
        return None
    value = (node.text or "").strip()
    if not value:
        errors.append(f"{label}: <{name}> is empty")
        return None
    return value


def parse_xml(path: Path, label: str, errors: list[str]) -> ET.Element | None:
    try:
        return ET.parse(path).getroot()
    except (OSError, ET.ParseError) as error:
        errors.append(f"{label}: malformed XML: {error}")
        return None


def canonical_xml(element: ET.Element) -> tuple[object, ...]:
    nested = [canonical_xml(child) for child in element]
    if local_name(element.tag) == "dependencies":
        nested.sort(key=repr)
    return (
        element.tag,
        tuple(sorted(element.attrib.items())),
        (element.text or "").strip(),
        tuple(nested),
    )


def canonical_module_model(model: dict[str, Any]) -> dict[str, Any]:
    result = copy.deepcopy(model)
    variants = result.get("variants")
    if isinstance(variants, list):
        for variant in variants:
            if not isinstance(variant, dict) or not isinstance(variant.get("dependencies"), list):
                continue
            variant["dependencies"].sort(
                key=lambda dependency: json.dumps(dependency, sort_keys=True, separators=(",", ":"))
            )
    return result


def reject_symlinks(root: Path, errors: list[str]) -> None:
    if root.is_symlink():
        errors.append(f"publication repository must not be a symlink: {root}")
        return
    if not root.is_dir():
        return
    for path in root.rglob("*"):
        if path.is_symlink():
            errors.append(f"publication repository contains symlink/escape: {path.relative_to(root)}")


def expected_name(module: str, value: str, kind: Kind) -> str:
    classifier = f"-{kind.classifier}" if kind.classifier else ""
    return f"{module}-{value}{classifier}.{kind.extension}"


def resolve_module(repository: Path, module: str, errors: list[str]) -> ResolvedModule | None:
    version_dir = repository.joinpath(*GROUP.split("."), module, VERSION)
    if not version_dir.is_dir() or version_dir.is_symlink():
        errors.append(f"{module}: published version directory is missing or unsafe")
        return None
    files: dict[str, Path] = {}
    values: set[str] = set()
    for kind in kinds(module):
        if VERSION.endswith("-SNAPSHOT"):
            classifier = f"-{re.escape(kind.classifier)}" if kind.classifier else ""
            pattern = re.compile(
                rf"^{re.escape(module)}-({re.escape(RELEASE_BASE)}-\d{{8}}\.\d{{6}}-\d+)"
                rf"{classifier}\.{re.escape(kind.extension)}$"
            )
            matches = [entry for entry in version_dir.iterdir() if entry.is_file() and pattern.fullmatch(entry.name)]
            if len(matches) == 1:
                match = pattern.fullmatch(matches[0].name)
                assert match is not None
                values.add(match.group(1))
        else:
            matches = [version_dir / expected_name(module, VERSION, kind)]
            matches = [entry for entry in matches if entry.is_file() and not entry.is_symlink()]
            values.add(VERSION)
        if len(matches) != 1:
            errors.append(f"{module} {kind.label}: expected one regular artifact, found {[entry.name for entry in matches]}")
        else:
            files[kind.label] = matches[0]
    if len(values) != 1:
        errors.append(f"{module}: snapshot artifacts do not share one timestamped value: {sorted(values)}")
        value = ""
    else:
        value = next(iter(values))

    primary = {path.name for path in files.values()}
    if VERSION.endswith("-SNAPSHOT"):
        primary.add("maven-metadata.xml")
    allowed = primary | {name + suffix for name in primary for suffix in CHECKSUM_SUFFIXES}
    actual_files = {entry.name for entry in version_dir.iterdir() if entry.is_file()}
    extra = actual_files - allowed
    missing = primary - actual_files
    directories = [entry.name for entry in version_dir.iterdir() if entry.is_dir()]
    if extra or missing or directories:
        errors.append(
            f"{module}: version inventory mismatch; missing={sorted(missing)}, "
            f"extra={sorted(extra)}, directories={sorted(directories)}"
        )
    return ResolvedModule(files, value)


def metadata_errors(path: Path, module: str) -> list[str]:
    errors: list[str] = []
    root = parse_xml(path, f"{module} Maven metadata", errors)
    if root is None:
        return errors
    for name, expected in (("groupId", GROUP), ("artifactId", module)):
        actual = one_text(root, name, f"{module} Maven metadata", errors)
        if actual is not None and actual != expected:
            errors.append(f"{module} Maven metadata: {name} is {actual!r}, expected {expected!r}")
    versioning = one_child(root, "versioning", f"{module} Maven metadata", errors)
    if versioning is not None:
        versions = one_child(versioning, "versions", f"{module} Maven metadata", errors)
        actual_versions = [] if versions is None else [(node.text or "").strip() for node in children(versions, "version")]
        if actual_versions != [VERSION]:
            errors.append(f"{module} Maven metadata: versions are {actual_versions}, expected {[VERSION]}")
        latest = one_text(versioning, "latest", f"{module} Maven metadata", errors)
        if latest is not None and latest != VERSION:
            errors.append(f"{module} Maven metadata: latest is {latest!r}, expected {VERSION!r}")
        release_nodes = children(versioning, "release")
        expected_release = None if VERSION.endswith("-SNAPSHOT") else VERSION
        actual_release = (release_nodes[0].text or "").strip() if len(release_nodes) == 1 else None
        if len(release_nodes) > 1 or actual_release != expected_release:
            errors.append(f"{module} Maven metadata: release is {actual_release!r}, expected {expected_release!r}")
        updated = one_text(versioning, "lastUpdated", f"{module} Maven metadata", errors)
        if updated is not None and not re.fullmatch(r"\d{14}", updated):
            errors.append(f"{module} Maven metadata: invalid lastUpdated {updated!r}")
    return errors


def topology_errors(repository: Path) -> list[str]:
    errors: list[str] = []
    expected_repository = REPOSITORY.absolute()
    if repository.absolute() != expected_repository:
        errors.append(f"publication repository must be exactly {expected_repository}")
        return errors
    if VERSION not in ALLOWED_VERSIONS:
        errors.append(f"publication version must be exactly one of {sorted(ALLOWED_VERSIONS)}: {VERSION!r}")
        return errors
    if not repository.is_dir():
        errors.append(f"publication repository is missing: {repository}")
        return errors
    reject_symlinks(repository, errors)
    current = repository
    for component in GROUP.split("."):
        directories = {entry.name for entry in current.iterdir() if entry.is_dir()} if current.is_dir() else set()
        files = {entry.name for entry in current.iterdir() if entry.is_file()} if current.is_dir() else set()
        if directories != {component} or files:
            errors.append(
                f"publication group path {current}: expected only {component!r}, "
                f"found directories={sorted(directories)}, files={sorted(files)}"
            )
        current /= component
    group_dir = repository.joinpath(*GROUP.split("."))
    modules = {entry.name for entry in group_dir.iterdir() if entry.is_dir()} if group_dir.is_dir() else set()
    if modules != set(MODULES):
        errors.append(f"publication group modules are {sorted(modules)}, expected {sorted(MODULES)}")
    for module in sorted(MODULES):
        module_dir = group_dir / module
        if not module_dir.is_dir():
            continue
        entries = list(module_dir.iterdir())
        directories = {entry.name for entry in entries if entry.is_dir()}
        files = {entry.name for entry in entries if entry.is_file()}
        expected_files = {"maven-metadata.xml"} | {
            "maven-metadata.xml" + suffix for suffix in CHECKSUM_SUFFIXES
        }
        if directories != {VERSION} or files != expected_files:
            errors.append(
                f"{module}: module topology mismatch; directories={sorted(directories)}, files={sorted(files)}"
            )
        errors.extend(metadata_errors(module_dir / "maven-metadata.xml", module))
    return errors


def checksum_errors(module: str, resolved: ResolvedModule) -> list[str]:
    errors: list[str] = []
    for label, artifact in resolved.files.items():
        sidecar = artifact.with_name(artifact.name + ".sha256")
        try:
            actual = sidecar.read_bytes() if sidecar.is_file() and not sidecar.is_symlink() else b""
        except OSError:
            actual = b""
        expected = (sha256(artifact) + "\n").encode("ascii")
        if actual == expected:
            continue
        try:
            text = actual.decode("ascii")
        except UnicodeError:
            text = ""
        if not re.fullmatch(r"[0-9a-f]{64}\n", text):
            errors.append(f"{module} {label}: malformed or missing exact SHA-256 sidecar")
        else:
            errors.append(f"{module} {label}: SHA-256 sidecar does not match artifact bytes")
    return errors


