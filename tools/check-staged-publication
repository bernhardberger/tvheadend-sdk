#!/usr/bin/env python3
"""Verify the staged five-module SDK publication and record its exact bytes."""

from __future__ import annotations

import hashlib
import io
import json
import re
import stat
import sys
import tempfile
import zipfile
import xml.etree.ElementTree as ET
from dataclasses import dataclass
from pathlib import Path
from typing import Callable


ROOT = Path(__file__).resolve().parents[1]
REPOSITORY = ROOT / "build/local-maven"
GROUP = "at.bernhardberger.tvheadend"
VERSION_PATTERN = re.compile(r"0\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)")
# Immutable numbered prereleases (including HTSP beta releases) are allowed.
# Fail closed on snapshots, timestamped snapshots, ranges and dynamic selectors.
DEPENDENCY_RELEASE_PATTERN = re.compile(r"[0-9]+(?:\.[0-9]+)+(?:[-.](?:alpha|beta|rc|m)[.-]?[0-9]+)?", re.IGNORECASE)
CHECKSUM_SUFFIXES = (".md5", ".sha1", ".sha256", ".sha512")
LEGAL_ENTRIES = ("META-INF/LICENSE", "META-INF/NOTICE")
PROJECT_URL = "https://github.com/bernhardberger/tvheadend-sdk"


class VerificationError(RuntimeError):
    """A staged published-byte invariant failed."""


@dataclass(frozen=True)
class Module:
    main_extension: str
    android: bool = False


MODULES = {
    "sdk-android": Module("aar", android=True),
    "sdk-core": Module("jar"),
    "sdk-media3": Module("aar", android=True),
    "sdk-playback": Module("jar"),
    "sdk-testing": Module("jar"),
}
PUBLICATION_NAMES = {
    "sdk-android": "Tvheadend Kotlin SDK: Android",
    "sdk-core": "Tvheadend Kotlin SDK: Core",
    "sdk-media3": "Tvheadend Kotlin SDK: Media3",
    "sdk-playback": "Tvheadend Kotlin SDK: Playback",
    "sdk-testing": "Tvheadend Kotlin SDK: Testing",
}


def require(condition: bool, message: str) -> None:
    if not condition:
        raise VerificationError(message)


def read_regular(path: Path, label: str) -> bytes:
    try:
        require(stat.S_ISREG(path.lstat().st_mode), f"{label} is not a regular file")
        return path.read_bytes()
    except FileNotFoundError as error:
        raise VerificationError(f"{label} is missing") from error
    except OSError as error:
        raise VerificationError(f"{label} cannot be read") from error


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def configured_version(build_text: str | None = None) -> str:
    if build_text is None:
        build_text = read_regular(ROOT / "build.gradle.kts", "build configuration").decode("utf-8")
    groups = re.findall(r'(?m)^group\s*=\s*"([^"]+)"\s*$', build_text)
    versions = re.findall(r'(?m)^version\s*=\s*"([^"]+)"\s*$', build_text)
    require(groups == [GROUP], f"publication group must be exactly {GROUP}")
    require(len(versions) == 1, "publication version must be one literal assignment")
    require(VERSION_PATTERN.fullmatch(versions[0]) is not None, "publication version must be a strict major-zero release")
    return versions[0]


def artifact_names(module: str, version: str) -> dict[str, str]:
    spec = MODULES[module]
    return {
        "main": f"{module}-{version}.{spec.main_extension}",
        "sources": f"{module}-{version}-sources.jar",
        "javadoc": f"{module}-{version}-javadoc.jar",
        "pom": f"{module}-{version}.pom",
        "module": f"{module}-{version}.module",
    }


def expected_originals(version: str) -> dict[str, tuple[str, str]]:
    base = GROUP.replace(".", "/")
    result = {
        f"{base}/{module}/{version}/{name}": (module, label)
        for module in sorted(MODULES)
        for label, name in artifact_names(module, version).items()
    }
    require(len(result) == 25, "publication inventory must contain exactly 25 originals")
    return result


def pom_dependencies(module: str, version: str) -> set[tuple[str, str, str, str]]:
    return {
        "sdk-android": {
            (GROUP, "sdk-core", version, "compile"),
            ("io.coil-kt.coil3", "coil-core", "3.6.3", "compile"),
            ("org.jetbrains.kotlinx", "kotlinx-coroutines-core", "1.11.0", "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
            ("androidx.datastore", "datastore-preferences", "1.2.1", "runtime"),
            ("com.google.crypto.tink", "tink-android", "1.23.0", "runtime"),
        },
        "sdk-core": {
            ("org.jetbrains.kotlinx", "kotlinx-coroutines-core-jvm", "1.11.0", "compile"),
            (GROUP, "sdk-playback", version, "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
            (GROUP, "htsp", "1.0.0-beta.3", "runtime"),
            ("org.jetbrains.kotlinx", "kotlinx-serialization-protobuf-jvm", "1.11.0", "runtime"),
        },
        "sdk-media3": {
            (GROUP, "sdk-core", version, "compile"),
            (GROUP, "sdk-playback", version, "compile"),
            ("androidx.media3", "media3-exoplayer", "1.11.1", "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
            ("androidx.media3", "media3-extractor", "1.11.1", "runtime"),
            ("org.jetbrains.kotlinx", "kotlinx-coroutines-core", "1.11.0", "runtime"),
        },
        "sdk-playback": {
            ("org.jetbrains.kotlinx", "kotlinx-coroutines-core-jvm", "1.11.0", "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
        },
        "sdk-testing": {
            (GROUP, "sdk-core", version, "compile"),
            (GROUP, "sdk-playback", version, "compile"),
            ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
        },
    }[module]


def dependency_constraints(module: str) -> set[tuple[str, str, str]]:
    return {"sdk-android": {("com.squareup.okio", "okio", "3.18.2")}}.get(module, set())


def module_variants(module: str, version: str) -> dict[str, tuple[str, set[tuple[str, str, str]]]]:
    pom = pom_dependencies(module, version)
    api = {
        (group, "kotlinx-coroutines-core" if artifact == "kotlinx-coroutines-core-jvm" else artifact, dependency_version)
        for group, artifact, dependency_version, scope in pom
        if scope == "compile"
    }
    runtime = api | {
        (group, "kotlinx-serialization-protobuf" if artifact == "kotlinx-serialization-protobuf-jvm" else artifact, dependency_version)
        for group, artifact, dependency_version, scope in pom
        if scope == "runtime"
    }
    if MODULES[module].android:
        return {
            "releaseVariantReleaseApiPublication": ("main", api),
            "releaseVariantReleaseRuntimePublication": ("main", runtime),
            "releaseVariantReleaseSourcePublication": ("sources", set()),
        }
    return {
        "apiElements": ("main", api),
        "runtimeElements": ("main", runtime),
        "sourcesElements": ("sources", set()),
        "javadocElements": ("javadoc", set()),
    }


def xml_children(parent: ET.Element, name: str) -> list[ET.Element]:
    return [child for child in parent if child.tag.rsplit("}", 1)[-1] == name]


def xml_one(parent: ET.Element, name: str, label: str) -> ET.Element:
    found = xml_children(parent, name)
    require(len(found) == 1, f"{label} must contain exactly one {name}")
    return found[0]


def xml_text(parent: ET.Element, name: str, label: str) -> str:
    value = (xml_one(parent, name, label).text or "").strip()
    require(bool(value), f"{label} {name} must not be empty")
    return value


def verify_pom_name(root: ET.Element, module: str, label: str) -> None:
    require(
        xml_text(root, "name", label) == PUBLICATION_NAMES[module],
        f"{label} has the wrong name",
    )


def verify_pom(data: bytes, module: str, version: str) -> None:
    try:
        root = ET.fromstring(data)
    except ET.ParseError as error:
        raise VerificationError(f"{module} POM is malformed") from error
    label = f"{module} POM"
    expected = {
        "modelVersion": "4.0.0",
        "groupId": GROUP,
        "artifactId": module,
        "version": version,
        "url": PROJECT_URL,
    }
    for name, value in expected.items():
        require(xml_text(root, name, label) == value, f"{label} has the wrong {name}")
    verify_pom_name(root, module, label)
    require(bool(xml_text(root, "description", label)), f"{label} description is missing")
    license_node = xml_one(xml_one(root, "licenses", label), "license", label)
    require(
        tuple(xml_text(license_node, name, label) for name in ("name", "url", "distribution")) ==
        ("GNU General Public License v3.0", "https://www.gnu.org/licenses/gpl-3.0.html", "repo"),
        f"{label} GPLv3 metadata differs",
    )
    developer = xml_one(xml_one(root, "developers", label), "developer", label)
    require(
        tuple(xml_text(developer, name, label) for name in ("id", "name", "url")) ==
        ("bernhardberger", "Bernhard Berger", "https://github.com/bernhardberger"),
        f"{label} developer metadata differs",
    )
    scm = xml_one(root, "scm", label)
    require(
        tuple(xml_text(scm, name, label) for name in ("connection", "developerConnection", "url")) ==
        ("scm:git:https://github.com/bernhardberger/tvheadend-sdk.git", "scm:git:ssh://git@github.com/bernhardberger/tvheadend-sdk.git", PROJECT_URL),
        f"{label} SCM metadata differs",
    )
    issues = xml_one(root, "issueManagement", label)
    require(
        (xml_text(issues, "system", label), xml_text(issues, "url", label)) ==
        ("GitHub Issues", f"{PROJECT_URL}/issues"),
        f"{label} issue metadata differs",
    )
    dependencies = xml_children(xml_one(root, "dependencies", label), "dependency")
    coordinates: list[tuple[str, str, str, str]] = []
    for dependency in dependencies:
        require(
            {child.tag.rsplit("}", 1)[-1] for child in dependency} == {"groupId", "artifactId", "version", "scope"},
            f"{label} dependency contains unsupported metadata",
        )
        coordinates.append(tuple(xml_text(dependency, name, label) for name in ("groupId", "artifactId", "version", "scope")))
    require(len(coordinates) == len(set(coordinates)), f"{label} contains duplicate dependencies")
    require(set(coordinates) == pom_dependencies(module, version), f"{label} dependencies differ")
    managed: list[tuple[str, str, str]] = []
    for management in xml_children(root, "dependencyManagement"):
        for dependency in xml_children(xml_one(management, "dependencies", label), "dependency"):
            require(
                {child.tag.rsplit("}", 1)[-1] for child in dependency} == {"groupId", "artifactId", "version"},
                f"{label} dependency constraint contains unsupported metadata",
            )
            managed.append(tuple(xml_text(dependency, name, label) for name in ("groupId", "artifactId", "version")))
    require(len(managed) == len(set(managed)) and set(managed) == dependency_constraints(module), f"{label} dependency constraints differ")


def verify_module_metadata(data: bytes, module: str, version: str, artifacts: dict[str, bytes]) -> None:
    try:
        model = json.loads(data.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise VerificationError(f"{module} Gradle metadata is malformed") from error
    require(isinstance(model, dict), f"{module} Gradle metadata must be an object")
    require(model.get("formatVersion") == "1.1", f"{module} Gradle metadata format is not 1.1")
    component = model.get("component")
    require(isinstance(component, dict), f"{module} Gradle metadata component is missing")
    require(
        {name: component.get(name) for name in ("group", "module", "version")} ==
        {"group": GROUP, "module": module, "version": version},
        f"{module} Gradle metadata has the wrong component identity",
    )
    require(component.get("attributes") == {"org.gradle.status": "release"}, f"{module} Gradle metadata has the wrong status")
    names = artifact_names(module, version)
    by_name = {names[label]: data for label, data in artifacts.items() if label in names}
    variants = model.get("variants")
    require(isinstance(variants, list) and all(isinstance(value, dict) for value in variants), f"{module} Gradle metadata variants are malformed")
    require(all(isinstance(value.get("name"), str) for value in variants), f"{module} Gradle metadata has an unnamed variant")
    by_variant = {value["name"]: value for value in variants}
    specs = module_variants(module, version)
    require(len(by_variant) == len(variants) and set(by_variant) == set(specs), f"{module} Gradle metadata variants differ")
    for variant_name, (label, expected_dependencies) in specs.items():
        variant = by_variant[variant_name]
        attributes = variant.get("attributes")
        require(isinstance(attributes, dict), f"{module} {variant_name} attributes are malformed")
        if label in {"sources", "javadoc"}:
            require(attributes.get("org.gradle.category") == "documentation" and attributes.get("org.gradle.docstype") == label, f"{module} {variant_name} documentation attributes differ")
        else:
            require(attributes.get("org.gradle.category") == "library" and attributes.get("org.gradle.libraryelements") == MODULES[module].main_extension, f"{module} {variant_name} library attributes differ")
            require(MODULES[module].android or attributes.get("org.gradle.jvm.version") == 17, f"{module} {variant_name} JVM target differs")
        dependencies = variant.get("dependencies", [])
        require(isinstance(dependencies, list), f"{module} {variant_name} dependencies are malformed")
        actual_dependencies: list[tuple[str, str, str]] = []
        for dependency in dependencies:
            require(isinstance(dependency, dict) and set(dependency) == {"group", "module", "version"}, f"{module} {variant_name} dependency shape differs")
            dependency_version = dependency.get("version")
            require(isinstance(dependency_version, dict) and set(dependency_version) == {"requires"}, f"{module} {variant_name} dependency version differs")
            coordinate = (dependency.get("group"), dependency.get("module"), dependency_version.get("requires"))
            require(all(isinstance(value, str) for value in coordinate), f"{module} {variant_name} dependency coordinate is malformed")
            actual_dependencies.append(coordinate)
        require(len(actual_dependencies) == len(set(actual_dependencies)) and set(actual_dependencies) == expected_dependencies, f"{module} {variant_name} dependencies differ")
        constraints = variant.get("dependencyConstraints", [])
        require(isinstance(constraints, list), f"{module} {variant_name} dependency constraints are malformed")
        actual_constraints: list[tuple[str, str, str]] = []
        for constraint in constraints:
            require(isinstance(constraint, dict) and set(constraint) == {"group", "module", "version", "reason"}, f"{module} {variant_name} dependency constraint shape differs")
            constraint_version = constraint.get("version")
            require(isinstance(constraint_version, dict) and set(constraint_version) == {"requires"}, f"{module} {variant_name} dependency constraint version differs")
            require(isinstance(constraint.get("reason"), str) and bool(constraint["reason"]), f"{module} {variant_name} dependency constraint reason is missing")
            actual_constraints.append((constraint.get("group"), constraint.get("module"), constraint_version.get("requires")))
        expected_constraints = set() if label in {"sources", "javadoc"} else dependency_constraints(module)
        require(len(actual_constraints) == len(set(actual_constraints)) and set(actual_constraints) == expected_constraints, f"{module} {variant_name} dependency constraints differ")
        files = variant.get("files")
        require(isinstance(files, list) and len(files) == 1 and isinstance(files[0], dict), f"{module} {variant_name} file metadata differs")
        entry = files[0]
        name = names[label]
        current = by_name[name]
        require(entry.get("name") == name and entry.get("url") == name and entry.get("size") == len(current) and entry.get("sha256") == sha256(current), f"{module} {variant_name} file identity differs")


def safe_zip(archive: zipfile.ZipFile, label: str) -> list[str]:
    entries = archive.infolist()
    names = [entry.filename for entry in entries]
    require(len(names) == len(set(names)), f"{label} contains duplicate entries")
    for entry in entries:
        name = entry.filename
        unix_type = stat.S_IFMT(entry.external_attr >> 16)
        require(
            not name.startswith("/") and ".." not in Path(name).parts and "\\" not in name and re.match(r"^[A-Za-z]:", name) is None and
            (entry.create_system != 3 or unix_type in {0, stat.S_IFREG, stat.S_IFDIR}),
            f"{label} contains an unsafe archive entry",
        )
    return names


def verify_legal(archive: zipfile.ZipFile, names: list[str], label: str) -> None:
    for name in LEGAL_ENTRIES:
        require(names.count(name) == 1, f"{label} must contain exactly one {name}")
    require("META-INF/NOTICE.md" not in names, f"{label} contains the nonstandard NOTICE.md entry")
    require(b"GNU GENERAL PUBLIC LICENSE" in archive.read("META-INF/LICENSE"), f"{label} lacks GPLv3 evidence")
    require(b"Preclikos/tvhstream" in archive.read("META-INF/NOTICE"), f"{label} lacks predecessor attribution")


def verify_jar(data: bytes, kind: str, label: str) -> None:
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as archive:
            names = safe_zip(archive, label)
            verify_legal(archive, names, label)
            if kind == "main":
                require(any(name.endswith(".class") for name in names), f"{label} contains no classes")
            elif kind == "sources":
                require(any(name.endswith(".kt") for name in names), f"{label} contains no Kotlin sources")
            elif kind == "javadoc":
                require(names.count("index.html") == 1, f"{label} lacks Dokka index.html")
    except zipfile.BadZipFile as error:
        raise VerificationError(f"{label} is not a valid ZIP archive") from error


def verify_aar(data: bytes, module: str) -> None:
    label = f"{module} AAR"
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as archive:
            names = safe_zip(archive, label)
            require(names.count("classes.jar") == 1, f"{label} must contain exactly one classes.jar")
            verify_jar(archive.read("classes.jar"), "main", f"{label} classes.jar")
            require(not any(name.endswith(".so") or name.startswith("libs/") for name in names), f"{label} bundles native libraries or local JARs")
    except zipfile.BadZipFile as error:
        raise VerificationError(f"{label} is not a valid ZIP archive") from error


def verify_release_dependencies(pom: bytes, metadata: bytes, module: str) -> None:
    """Check dependency and constraint versions after their metadata shapes validate."""
    def check(group: str, artifact: str, version: str, label: str) -> None:
        require(
            DEPENDENCY_RELEASE_PATTERN.fullmatch(version) is not None,
            f"{module} {label} dependency {group}:{artifact} has non-release version {version}",
        )

    for dependency in ET.fromstring(pom).iter():
        if dependency.tag.rsplit("}", 1)[-1] == "dependency":
            check(*(xml_text(dependency, name, f"{module} POM") for name in ("groupId", "artifactId", "version")), "POM")
    for variant in json.loads(metadata)["variants"]:
        for collection in ("dependencies", "dependencyConstraints"):
            for dependency in variant.get(collection, []):
                check(dependency["group"], dependency["module"], dependency["version"]["requires"], "Gradle metadata")


def verify_module_artifacts(artifacts: dict[str, bytes], module: str, version: str) -> None:
    verify_pom(artifacts["pom"], module, version)
    verify_module_metadata(artifacts["module"], module, version, artifacts)
    verify_release_dependencies(artifacts["pom"], artifacts["module"], module)
    if MODULES[module].android:
        verify_aar(artifacts["main"], module)
    else:
        verify_jar(artifacts["main"], "main", f"{module} main JAR")
    verify_jar(artifacts["sources"], "sources", f"{module} sources JAR")
    verify_jar(artifacts["javadoc"], "javadoc", f"{module} Javadoc JAR")


def verify(repository: Path = REPOSITORY) -> dict[str, str]:
    version = configured_version()
    require(repository.is_dir() and not repository.is_symlink(), "staged Maven repository is missing or unsafe")
    expected = expected_originals(version)
    group_directory = repository.joinpath(*GROUP.split("."))
    try:
        modules = {entry.name for entry in group_directory.iterdir() if entry.is_dir() and not entry.is_symlink()}
    except OSError as error:
        raise VerificationError("staged Maven group cannot be inspected") from error
    require(modules == set(MODULES), "staged Maven repository does not contain exactly the five SDK modules")
    manifest: dict[str, str] = {}
    for module in sorted(MODULES):
        names = artifact_names(module, version)
        directory = group_directory / module / version
        try:
            entries = list(directory.iterdir())
        except OSError as error:
            raise VerificationError(f"{module} staged directory cannot be inspected") from error
        actual = {entry.name for entry in entries if entry.is_file() and not entry.is_symlink()}
        allowed = set(names.values()) | {name + suffix for name in names.values() for suffix in CHECKSUM_SUFFIXES}
        require(set(names.values()) <= actual, f"{module} staged publication omits a required original")
        require(actual <= allowed and all(entry.is_file() and not entry.is_symlink() for entry in entries), f"{module} staged publication contains an unexpected entry")
        artifacts = {label: read_regular(directory / name, f"{module} {label}") for label, name in names.items()}
        verify_module_artifacts(artifacts, module, version)
        for label, name in names.items():
            relative = f"{GROUP.replace('.', '/')}/{module}/{version}/{name}"
            require(expected.get(relative) == (module, label), "internal staged inventory differs")
            manifest[relative] = sha256(artifacts[label])
    require(set(manifest) == set(expected), "staged publication does not contain the exact 25 originals")
    return dict(sorted(manifest.items()))


def manifest_path(argument: str) -> Path:
    path = Path(argument)
    path = path if path.is_absolute() else ROOT / path
    resolved = path.resolve(strict=False)
    build = (ROOT / "build").resolve(strict=False)
    require(resolved != build and build in resolved.parents, "manifest path must be below checkout build")
    return resolved


def expect_error(errors: list[str], label: str, action: Callable[[], object]) -> None:
    try:
        action()
    except VerificationError:
        return
    errors.append(f"self-test accepted {label}")


def self_test() -> list[str]:
    from unittest.mock import patch

    errors: list[str] = []
    # Exercise both formats independently, including managed dependencies/constraints,
    # across all five modules. Release status of the SDK itself is not sufficient.
    for module in MODULES:
        for managed in (False, True):
            def dependency_documents(pom_version: str, metadata_version: str) -> tuple[bytes, bytes]:
                dependencies = (f"<dependencies><dependency><groupId>{GROUP}</groupId>"
                                f"<artifactId>htsp</artifactId><version>{pom_version}</version>"
                                "</dependency></dependencies>")
                if managed:
                    dependencies = f"<dependencyManagement>{dependencies}</dependencyManagement>"
                pom = f'<project xmlns="http://maven.apache.org/POM/4.0.0">{dependencies}</project>'.encode()
                metadata = json.dumps({"variants": [{
                    "dependencyConstraints" if managed else "dependencies": [
                        {"group": GROUP, "module": "htsp", "version": {"requires": metadata_version}},
                    ],
                }]}).encode()
                return pom, metadata

            for version in ("1.0.0", "1.0.0-beta.3", "1.0.0-alpha01", "1.0.0-rc1", "2.4.10", "33.4.8"):
                try:
                    verify_release_dependencies(*dependency_documents(version, version), module)
                except VerificationError as error:
                    errors.append(f"self-test rejected immutable dependency release: {error}")
            for version in ("1.0.0-SNAPSHOT", "1.0.0-beta.2-entity-model-SNAPSHOT", "1.0.0-snapshot",
                            "1.0.0-20261015.150132-1", "1.0.0-dev", "1.0.0-candidate", "+", "1.+",
                            "latest.release", "latest.integration", "[1.0,2.0)", "${htsp.version}", ""):
                for pom_version, metadata_version in ((version, "1.0.0-beta.3"), ("1.0.0-beta.3", version)):
                    expect_error(errors, f"{module} non-release dependency {version}",
                                 lambda: verify_release_dependencies(*dependency_documents(pom_version, metadata_version), module))
    build = f'group = "{GROUP}"\nversion = "0.4.0"\n'
    if configured_version(build) != "0.4.0" or len(expected_originals("0.4.0")) != 25:
        errors.append("self-test rejected the exact five-module release identity")
    expected_publication_names = {
        "sdk-android": "Tvheadend Kotlin SDK: Android",
        "sdk-core": "Tvheadend Kotlin SDK: Core",
        "sdk-media3": "Tvheadend Kotlin SDK: Media3",
        "sdk-playback": "Tvheadend Kotlin SDK: Playback",
        "sdk-testing": "Tvheadend Kotlin SDK: Testing",
    }
    if PUBLICATION_NAMES != expected_publication_names:
        errors.append("self-test rejected the configured human-readable publication names")
    core_dependencies = [
        ("org.jetbrains.kotlinx", "kotlinx-coroutines-core-jvm", "1.11.0", "compile"),
        (GROUP, "sdk-playback", "0.8.0", "compile"),
        ("org.jetbrains.kotlin", "kotlin-stdlib", "2.4.10", "compile"),
        (GROUP, "htsp", "1.0.0-beta.3", "runtime"),
        ("org.jetbrains.kotlinx", "kotlinx-serialization-protobuf-jvm", "1.11.0", "runtime"),
    ]
    core_pom = ET.fromstring(f"""<project>
        <modelVersion>4.0.0</modelVersion><groupId>{GROUP}</groupId><artifactId>sdk-core</artifactId>
        <version>0.8.0</version><name>{PUBLICATION_NAMES['sdk-core']}</name>
        <description>Fixture</description><url>{PROJECT_URL}</url>
        <licenses><license><name>GNU General Public License v3.0</name>
        <url>https://www.gnu.org/licenses/gpl-3.0.html</url><distribution>repo</distribution></license></licenses>
        <developers><developer><id>bernhardberger</id><name>Bernhard Berger</name>
        <url>https://github.com/bernhardberger</url></developer></developers>
        <scm><connection>scm:git:https://github.com/bernhardberger/tvheadend-sdk.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/bernhardberger/tvheadend-sdk.git</developerConnection>
        <url>{PROJECT_URL}</url></scm><issueManagement><system>GitHub Issues</system>
        <url>{PROJECT_URL}/issues</url></issueManagement><dependencies/></project>""")
    dependency_nodes = core_pom.find("dependencies")
    for coordinate in core_dependencies:
        node = ET.SubElement(dependency_nodes, "dependency")
        for name, value in zip(("groupId", "artifactId", "version", "scope"), coordinate):
            ET.SubElement(node, name).text = value
    try:
        verify_pom(ET.tostring(core_pom), "sdk-core", "0.8.0")
    except VerificationError as error:
        errors.append(f"self-test rejected core protobuf POM: {error}")
    management = ET.SubElement(core_pom, "dependencyManagement")
    managed_node = ET.SubElement(ET.SubElement(management, "dependencies"), "dependency")
    for name, value in zip(("groupId", "artifactId", "version"), ("com.squareup.okio", "okio", "3.18.2")):
        ET.SubElement(managed_node, name).text = value
    expect_error(errors, "unexpected POM dependency management", lambda: verify_pom(ET.tostring(core_pom), "sdk-core", "0.8.0"))
    core_pom.remove(management)
    protobuf_node = dependency_nodes[-1]
    for field, wrong in (("version", "1.10.0"), ("scope", "compile"), ("artifactId", "kotlinx-serialization-core-jvm")):
        child = protobuf_node.find(field)
        original = child.text
        child.text = wrong
        expect_error(errors, f"wrong protobuf POM {field}", lambda: verify_pom(ET.tostring(core_pom), "sdk-core", "0.8.0"))
        child.text = original
    dependency_nodes.remove(protobuf_node)
    expect_error(errors, "missing protobuf POM dependency", lambda: verify_pom(ET.tostring(core_pom), "sdk-core", "0.8.0"))

    core_artifacts = {label: b"fixture" for label in ("main", "sources", "javadoc")}
    variants = []
    for variant_name, label, scope in (("apiElements", "main", "compile"), ("runtimeElements", "main", "runtime"),
                                        ("sourcesElements", "sources", "none"), ("javadocElements", "javadoc", "none")):
        dependencies = [{"group": group, "module": artifact.removesuffix("-jvm") if group == "org.jetbrains.kotlinx" else artifact,
                         "version": {"requires": version}}
                        for group, artifact, version, dependency_scope in core_dependencies
                        if dependency_scope == scope or scope == "runtime"]
        name = artifact_names("sdk-core", "0.8.0")[label]
        attributes = {"org.gradle.category": "library", "org.gradle.libraryelements": "jar", "org.gradle.jvm.version": 17}
        if scope == "none":
            attributes = {"org.gradle.category": "documentation", "org.gradle.docstype": label}
        variants.append({"name": variant_name, "attributes": attributes, "dependencies": dependencies,
                         "files": [{"name": name, "url": name, "size": 7, "sha256": sha256(b"fixture")}]})
    core_metadata = {"formatVersion": "1.1", "component": {"group": GROUP, "module": "sdk-core", "version": "0.8.0",
                     "attributes": {"org.gradle.status": "release"}}, "variants": variants}
    def verify_core_metadata() -> None:
        verify_module_metadata(json.dumps(core_metadata).encode(), "sdk-core", "0.8.0", core_artifacts)
    try:
        verify_core_metadata()
    except VerificationError as error:
        errors.append(f"self-test rejected core protobuf module metadata: {error}")
    variants[1]["dependencyConstraints"] = [{"group": "com.squareup.okio", "module": "okio", "version": {"requires": "3.18.2"}, "reason": "fixture"}]
    expect_error(errors, "unexpected module dependency constraint", verify_core_metadata)
    del variants[1]["dependencyConstraints"]
    protobuf_dependency = variants[1]["dependencies"][-1]
    protobuf_dependency["version"]["requires"] = "1.10.0"
    expect_error(errors, "wrong protobuf module version", verify_core_metadata)
    protobuf_dependency["version"]["requires"] = "1.11.0"
    variants[1]["dependencies"].remove(protobuf_dependency)
    expect_error(errors, "missing protobuf module dependency", verify_core_metadata)

    android_artifacts = {label: b"fixture" for label in ("main", "sources")}
    okio_constraint = {"group": "com.squareup.okio", "module": "okio", "version": {"requires": "3.18.2"}, "reason": "fixture"}
    android_variants = []
    for variant_name, (label, expected) in module_variants("sdk-android", "0.8.0").items():
        name = artifact_names("sdk-android", "0.8.0")[label]
        variant = {"name": variant_name, "dependencies": [{"group": group, "module": artifact, "version": {"requires": version}}
                                                          for group, artifact, version in sorted(expected)],
                   "files": [{"name": name, "url": name, "size": 7, "sha256": sha256(b"fixture")}]}
        if label == "sources":
            variant["attributes"] = {"org.gradle.category": "documentation", "org.gradle.docstype": label}
        else:
            variant["attributes"] = {"org.gradle.category": "library", "org.gradle.libraryelements": "aar"}
            variant["dependencyConstraints"] = [okio_constraint]
        android_variants.append(variant)
    android_metadata = {"formatVersion": "1.1", "component": {"group": GROUP, "module": "sdk-android", "version": "0.8.0",
                        "attributes": {"org.gradle.status": "release"}}, "variants": android_variants}
    def verify_android_metadata() -> None:
        verify_module_metadata(json.dumps(android_metadata).encode(), "sdk-android", "0.8.0", android_artifacts)
    try:
        verify_android_metadata()
    except VerificationError as error:
        errors.append(f"self-test rejected android Okio constraint metadata: {error}")
    runtime_variant = android_variants[1]
    del runtime_variant["dependencyConstraints"]
    expect_error(errors, "missing android Okio constraint", verify_android_metadata)
    runtime_variant["dependencyConstraints"] = [dict(okio_constraint, version={"requires": "3.18.1"})]
    expect_error(errors, "android Okio constraint requiring 3.18.1", verify_android_metadata)
    runtime_variant["dependencyConstraints"] = [{key: value for key, value in okio_constraint.items() if key != "reason"}]
    expect_error(errors, "android Okio constraint without reason", verify_android_metadata)
    for module, name in expected_publication_names.items():
        root = ET.fromstring(f"<project><name>{name}</name></project>")
        try:
            verify_pom_name(root, module, "synthetic POM")
        except VerificationError as error:
            errors.append(f"self-test rejected {module} publication name: {error}")
        obsolete = ET.fromstring(f"<project><name>{module}</name></project>")
        expect_error(
            errors,
            f"obsolete {module} POM name",
            lambda root=obsolete, module=module: verify_pom_name(root, module, "synthetic POM"),
        )
    expect_error(errors, "snapshot version", lambda: configured_version(build.replace("0.4.0", "0.4.0-SNAPSHOT")))
    expect_error(errors, "wrong group", lambda: configured_version(build.replace(GROUP, "invalid.example")))
    legal = {
        "META-INF/LICENSE": b"GNU GENERAL PUBLIC LICENSE Version 3",
        "META-INF/NOTICE": b"Derived from Preclikos/tvhstream",
        "example/Test.class": b"class",
    }

    def archive(entries: dict[str, bytes]) -> bytes:
        output = io.BytesIO()
        with zipfile.ZipFile(output, "w") as target:
            for name, data in entries.items():
                target.writestr(name, data)
        return output.getvalue()

    def integrated_fixture(version: str, module: str = "sdk-testing") -> dict[str, bytes]:
        # Internal SDK edges use the supplied version, independently of the HTSP pin.
        # The SNAPSHOT case must fail specifically on a dependency, not archive shape.
        pom = ET.fromstring(ET.tostring(core_pom))
        pom.find("artifactId").text = module
        pom.find("version").text = version
        pom.find("name").text = PUBLICATION_NAMES[module]
        dependencies = pom.find("dependencies")
        dependencies.clear()
        for coordinate in sorted(pom_dependencies(module, version)):
            dependency = ET.SubElement(dependencies, "dependency")
            for name, value in zip(("groupId", "artifactId", "version", "scope"), coordinate):
                ET.SubElement(dependency, name).text = value
        if dependency_constraints(module):
            managed = ET.SubElement(ET.SubElement(pom, "dependencyManagement"), "dependencies")
            for coordinate in sorted(dependency_constraints(module)):
                dependency = ET.SubElement(managed, "dependency")
                for name, value in zip(("groupId", "artifactId", "version"), coordinate):
                    ET.SubElement(dependency, name).text = value
        artifacts = {
            "pom": ET.tostring(pom),
            "main": archive({"classes.jar": archive(legal)}) if MODULES[module].android else archive(legal),
            "sources": archive({**legal, "example/Test.kt": b"class Test"}),
            "javadoc": archive({**legal, "index.html": b"Fixture"}),
        }
        variants = []
        for name, (label, dependencies) in module_variants(module, version).items():
            filename = artifact_names(module, version)[label]
            attributes = ({"org.gradle.category": "documentation", "org.gradle.docstype": label}
                          if label in ("sources", "javadoc") else
                          {"org.gradle.category": "library", "org.gradle.libraryelements": MODULES[module].main_extension,
                           "org.gradle.jvm.version": 17})
            variants.append({"name": name, "attributes": attributes,
                             "dependencies": [{"group": group, "module": artifact, "version": {"requires": required}}
                                              for group, artifact, required in sorted(dependencies)],
                             "files": [{"name": filename, "url": filename, "size": len(artifacts[label]),
                                        "sha256": sha256(artifacts[label])}]})
            if label == "main" and dependency_constraints(module):
                variants[-1]["dependencyConstraints"] = [
                    {"group": group, "module": artifact, "version": {"requires": required}, "reason": "fixture"}
                    for group, artifact, required in sorted(dependency_constraints(module))
                ]
        artifacts["module"] = json.dumps({"formatVersion": "1.1", "component": {
            "group": GROUP, "module": module, "version": version, "attributes": {"org.gradle.status": "release"}},
            "variants": variants}).encode()
        return artifacts

    try:
        verify_module_artifacts(integrated_fixture("0.8.0"), "sdk-testing", "0.8.0")
    except VerificationError as error:
        errors.append(f"self-test rejected integrated release fixture: {error}")
    try:
        verify_module_artifacts(integrated_fixture("0.8.0-SNAPSHOT"), "sdk-testing", "0.8.0-SNAPSHOT")
    except VerificationError as error:
        if "dependency" not in str(error) or "has non-release version 0.8.0-SNAPSHOT" not in str(error):
            errors.append(f"self-test rejected integrated snapshot fixture for the wrong reason: {error}")
    else:
        errors.append("self-test accepted integrated SNAPSHOT dependency fixture")

    # Exercise the real repository walk and all 25 originals. Substitute only the
    # expected dependency pins so this regression survives an HTSP re-pin; all
    # repository, metadata, archive and release-version validators remain real.
    version = configured_version()
    fixture_dependencies = {
        module: {(group, artifact, "1.0.0-beta.3" if (group, artifact) == (GROUP, "htsp") else required, scope)
                 for group, artifact, required, scope in pom_dependencies(module, version)}
        for module in MODULES
    }
    with tempfile.TemporaryDirectory(prefix="staged-publication-self-test-") as temporary:
        repository = Path(temporary)
        with patch.dict(globals(), pom_dependencies=lambda module, version: fixture_dependencies[module]):
            for snapshot in (False, True):
                if snapshot:
                    fixture_dependencies["sdk-core"].remove((GROUP, "htsp", "1.0.0-beta.3", "runtime"))
                    fixture_dependencies["sdk-core"].add((GROUP, "htsp", "1.0.0-SNAPSHOT", "runtime"))
                expected_manifest = {}
                for module in MODULES:
                    artifacts = integrated_fixture(version, module)
                    directory = repository.joinpath(*GROUP.split("."), module, version)
                    directory.mkdir(parents=True, exist_ok=True)
                    for label, name in artifact_names(module, version).items():
                        path = directory / name
                        path.write_bytes(artifacts[label])
                        expected_manifest[path.relative_to(repository).as_posix()] = sha256(artifacts[label])
                try:
                    manifest = verify(repository)
                except VerificationError as error:
                    expected_error = f"sdk-core POM dependency {GROUP}:htsp has non-release version 1.0.0-SNAPSHOT"
                    if not snapshot or str(error) != expected_error:
                        errors.append(f"self-test rejected staged repository fixture for the wrong reason: {error}")
                else:
                    if snapshot:
                        errors.append("self-test accepted staged repository SNAPSHOT dependency fixture")
                    elif manifest != expected_manifest:
                        errors.append("self-test staged repository manifest differs from its 25 originals")

    try:
        verify_jar(archive(legal), "main", "synthetic JAR")
    except VerificationError as error:
        errors.append(f"self-test rejected a valid synthetic JAR: {error}")
    expect_error(errors, "missing standard notice", lambda: verify_jar(archive({key: value for key, value in legal.items() if key != "META-INF/NOTICE"}), "main", "synthetic JAR"))
    expect_error(errors, "nonstandard notice", lambda: verify_jar(archive({**legal, "META-INF/NOTICE.md": b"duplicate"}), "main", "synthetic JAR"))
    aar = {"classes.jar": archive(legal)}
    try:
        verify_aar(archive(aar), "sdk-media3")
    except VerificationError as error:
        errors.append(f"self-test rejected a valid synthetic AAR: {error}")
    expect_error(errors, "bundled native library", lambda: verify_aar(archive({**aar, "jni/x86_64/libexample.so": b"native"}), "sdk-media3"))
    expect_error(errors, "bundled local JAR", lambda: verify_aar(archive({**aar, "libs/example.jar": archive(legal)}), "sdk-media3"))
    try:
        manifest_path("build/publication-manifest.json")
    except VerificationError as error:
        errors.append(f"self-test rejected a build-local manifest: {error}")
    expect_error(errors, "manifest escape", lambda: manifest_path("../publication-manifest.json"))
    return errors


def main() -> int:
    arguments = sys.argv[1:]
    try:
        if arguments == ["--self-test"]:
            errors = self_test()
            for error in errors:
                print(f"error: {error}", file=sys.stderr)
            if errors:
                return 1
            print("Staged publication focused self-tests passed")
            return 0
        if arguments and (len(arguments) != 2 or arguments[0] not in {"--write-manifest", "--compare-manifest"}):
            print("usage: check-staged-publication [--self-test|--write-manifest PATH|--compare-manifest PATH]", file=sys.stderr)
            return 2
        manifest = verify()
        if arguments:
            path = manifest_path(arguments[1])
            if arguments[0] == "--write-manifest":
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            else:
                try:
                    expected = json.loads(read_regular(path, "comparison manifest").decode("utf-8"))
                except (UnicodeError, json.JSONDecodeError) as error:
                    raise VerificationError("comparison manifest is malformed") from error
                require(expected == manifest, "recreated publication bytes differ from the recorded manifest")
        print("Staged SDK publication passed: five modules, 25 originals, metadata, legal notices, and no bundled native payloads")
        return 0
    except (VerificationError, UnicodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except OSError:
        print("error: staged publication output could not be written", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
