"""Prepare and upload one SDK release without autonomous recovery."""

from __future__ import annotations

import base64
import binascii
import hashlib
import io
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import uuid
import zipfile
from dataclasses import dataclass
from pathlib import Path
from typing import Callable


ROOT = Path(__file__).resolve().parents[1]
REPOSITORY = "bernhardberger/tvheadend-sdk"
GROUP = "at.bernhardberger.tvheadend"
MODULE_EXTENSIONS = {
    "sdk-android": "aar",
    "sdk-core": "jar",
    "sdk-media3": "aar",
    "sdk-playback": "jar",
    "sdk-testing": "jar",
}
FINGERPRINT = "C20177505D8D21CE86DEF715889A6266E5504130"
EXPECTED_UID = "Bernhard Berger <bernhard.berger@gmail.com>"
UPLOAD_URL = "https://central.sonatype.com/api/v1/publisher/upload"
MAVEN_URL = "https://repo1.maven.org/maven2"
CENTRAL_ARTIFACT_URL = "https://central.sonatype.com/artifact"
SEMVER = re.compile(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)")
DEPLOYMENT_ID = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}")
STAGED_MANIFEST = ROOT / "build/staged-publication.json"
RELEASE_OUTPUT = ROOT / "build/release"
UPLOAD_MARKER = ROOT / "build/central-upload-attempted"
SECRET_NAMES = ("MAVEN_GPG_PRIVATE_KEY", "MAVEN_GPG_PASSPHRASE", "CENTRAL_PORTAL_TOKEN")
ZIP_TIMESTAMP = (1980, 1, 1, 0, 0, 0)
ZIP_MODE = (stat.S_IFREG | 0o644) << 16


class ReleaseError(RuntimeError):
    """A release invariant failed without exposing private data."""


@dataclass(frozen=True)
class Identity:
    version: str
    tag: str
    coordinates: tuple[str, ...]


@dataclass(frozen=True)
class Original:
    relative_path: str
    name: str
    data: bytes
    sha256: str


@dataclass(frozen=True)
class HttpResponse:
    status: int
    body: bytes


HttpClient = Callable[[str, str, dict[str, str], bytes | None], HttpResponse]
SignatureVerifier = Callable[[str, bytes, bytes], bool]


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ReleaseError(message)


def read_regular(path: Path, label: str) -> bytes:
    try:
        require(stat.S_ISREG(path.lstat().st_mode), f"{label} is not a regular file")
        return path.read_bytes()
    except FileNotFoundError as error:
        raise ReleaseError(f"{label} is missing") from error
    except OSError as error:
        raise ReleaseError(f"{label} cannot be read") from error


def digest(name: str, data: bytes) -> str:
    return hashlib.new(name, data).hexdigest()


def configured_identity(build_text: str | None = None, tag: str | None = None) -> Identity:
    if build_text is None:
        build_text = read_regular(ROOT / "build.gradle.kts", "build configuration").decode("utf-8")
    groups = re.findall(r'(?m)^group\s*=\s*"([^"]+)"\s*$', build_text)
    versions = re.findall(r'(?m)^version\s*=\s*"([^"]+)"\s*$', build_text)
    require(groups == [GROUP], f"configured release group must be exactly {GROUP}")
    require(len(versions) == 1, "configured release version must be one literal assignment")
    match = SEMVER.fullmatch(versions[0])
    require(match is not None and match.group(1) == "0", "configured release version must be strict major-zero SemVer")
    expected_tag = f"v{versions[0]}"
    if tag is not None:
        require(tag == expected_tag, f"release tag must be exactly {expected_tag}")
    coordinates = tuple(f"{GROUP}:{module}:{versions[0]}" for module in sorted(MODULE_EXTENSIONS))
    return Identity(versions[0], expected_tag, coordinates)


def artifact_names(module: str, identity: Identity) -> tuple[str, ...]:
    stem = f"{module}-{identity.version}"
    names = [
        f"{stem}.{MODULE_EXTENSIONS[module]}",
        f"{stem}-sources.jar",
        f"{stem}-javadoc.jar",
        f"{stem}.pom",
        f"{stem}.module",
    ]
    if module == "sdk-media3":
        names.append(f"{stem}-ffmpeg-sources.tar.xz")
    return tuple(names)


def expected_paths(identity: Identity) -> tuple[str, ...]:
    base = GROUP.replace(".", "/")
    paths = tuple(
        f"{base}/{module}/{identity.version}/{name}"
        for module in sorted(MODULE_EXTENSIONS)
        for name in artifact_names(module, identity)
    )
    require(len(paths) == 26 and len(set(paths)) == 26, "release inventory must contain exactly 26 originals")
    return paths


def staged_originals(identity: Identity) -> tuple[Original, ...]:
    data = read_regular(STAGED_MANIFEST, "staged publication manifest")
    try:
        manifest = json.loads(data.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ReleaseError("staged publication manifest is malformed") from error
    require(isinstance(manifest, dict), "staged publication manifest must be an object")
    paths = expected_paths(identity)
    require(set(manifest) == set(paths), "staged publication manifest does not list the exact 26 originals")
    repository = ROOT / "build/local-maven"
    originals: list[Original] = []
    for relative in paths:
        value = manifest.get(relative)
        require(isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None, "staged publication manifest contains an invalid digest")
        current = read_regular(repository / relative, f"staged original {Path(relative).name}")
        current_digest = digest("sha256", current)
        require(current_digest == value, f"staged original differs from its manifest: {Path(relative).name}")
        originals.append(Original(relative, Path(relative).name, current, current_digest))
    return tuple(originals)


def release_manifest(identity: Identity, commit: str, originals: tuple[Original, ...]) -> dict[str, object]:
    return {
        "schema": "tvheadend-sdk-release-manifest-v1",
        "coordinates": list(identity.coordinates),
        "tag": identity.tag,
        "commit": commit,
        "fingerprint": FINGERPRINT,
        "files": [
            {"path": item.relative_path, "size": len(item.data), "sha256": item.sha256}
            for item in sorted(originals, key=lambda value: value.relative_path)
        ],
    }


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")


def extract_release_notes(changelog: str, version: str) -> str:
    heading = re.compile(rf"(?m)^## \[{re.escape(version)}\]\s*$")
    matches = list(heading.finditer(changelog))
    require(len(matches) == 1, f"CHANGELOG must contain exactly one section for {version}")
    following = re.search(r"(?m)^## ", changelog[matches[0].end():])
    end = matches[0].end() + following.start() if following else len(changelog)
    section = changelog[matches[0].start():end].strip()
    require(bool(section[len(matches[0].group(0)):].strip()), f"CHANGELOG section for {version} is empty")
    return section + "\n"


def release_notes(identity: Identity) -> str:
    changelog = read_regular(ROOT / "CHANGELOG.md", "CHANGELOG").decode("utf-8")
    notes = extract_release_notes(changelog, identity.version).rstrip()
    links: list[str] = []
    for module in sorted(MODULE_EXTENSIONS):
        links.append(f"- [{module} on Maven Central]({CENTRAL_ARTIFACT_URL}/{GROUP}/{module}/{identity.version})")
        links.append(f"- [{module} repository files]({MAVEN_URL}/{GROUP.replace('.', '/')}/{module}/{identity.version}/)")
    return f"{notes}\n\n### Distribution\n\n" + "\n".join(links) + "\n"


def safe_environment(gnupg_home: Path | None = None) -> dict[str, str]:
    environment = {name: os.environ[name] for name in ("PATH", "HOME", "TMPDIR") if name in os.environ}
    environment["LC_ALL"] = "C"
    if gnupg_home is not None:
        environment["GNUPGHOME"] = str(gnupg_home)
    return environment


def run_process(command: tuple[str, ...], data: bytes | None = None, gnupg_home: Path | None = None) -> subprocess.CompletedProcess[bytes]:
    try:
        return subprocess.run(
            command,
            input=data,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            env=safe_environment(gnupg_home),
        )
    except OSError as error:
        raise ReleaseError(f"required executable failed to start: {command[0]}") from error


def git_text(*arguments: str) -> str:
    result = run_process(("git", *arguments))
    require(result.returncode == 0, f"Git context check failed: {' '.join(arguments)}")
    try:
        return result.stdout.decode("utf-8").strip()
    except UnicodeError as error:
        raise ReleaseError("Git context output is malformed") from error


def parse_remote_tag(data: bytes, tag: str) -> str:
    try:
        lines = data.decode("utf-8").splitlines()
    except UnicodeError as error:
        raise ReleaseError("remote release tag response is malformed") from error
    fields = lines[0].split("\t") if len(lines) == 1 else []
    require(
        len(fields) == 2 and fields[1] == f"refs/tags/{tag}" and re.fullmatch(r"[0-9a-f]{40}", fields[0]) is not None,
        "remote annotated release tag is missing or malformed",
    )
    return fields[0]


def require_remote_tag(identity: Identity, commit: str) -> None:
    reference = f"refs/tags/{identity.tag}"
    local_object = git_text("rev-parse", reference)
    result = run_process(("git", "ls-remote", "--refs", "origin", reference))
    require(result.returncode == 0, "remote release tag cannot be read")
    require(parse_remote_tag(result.stdout, identity.tag) == local_object, "remote release tag differs from the local annotated tag")
    require(git_text("rev-parse", f"{reference}^{{commit}}") == commit, "release tag does not identify the release commit")


def require_action_context(identity: Identity, tagged_commit: str, environment: dict[str, str]) -> None:
    expected = {
        "GITHUB_ACTIONS": "true",
        "GITHUB_EVENT_NAME": "push",
        "GITHUB_REF_TYPE": "tag",
        "GITHUB_REPOSITORY": REPOSITORY,
        "GITHUB_REF": f"refs/tags/{identity.tag}",
        "GITHUB_REF_NAME": identity.tag,
        "GITHUB_RUN_ATTEMPT": "1",
    }
    for name, value in expected.items():
        require(environment.get(name) == value, f"release requires exact first-attempt tag context: {name}")
    require(environment.get("GITHUB_SHA") == tagged_commit, "GITHUB_SHA does not equal the peeled tagged commit")


def require_local_tag(kind: str, tagged_commit: str, commit: str) -> None:
    require(kind == "tag", "release tag must be annotated")
    require(tagged_commit == commit, "annotated release tag does not resolve to HEAD")


def require_publish_context(identity: Identity) -> str:
    commit = git_text("rev-parse", "HEAD")
    reference = f"refs/tags/{identity.tag}"
    tagged_commit = git_text("rev-parse", f"{reference}^{{commit}}")
    require_action_context(identity, tagged_commit, os.environ)
    require_local_tag(git_text("cat-file", "-t", reference), tagged_commit, commit)
    require_remote_tag(identity, commit)
    ancestry = run_process(("git", "merge-base", "--is-ancestor", commit, "refs/remotes/origin/main"))
    require(ancestry.returncode == 0, "release commit is not reachable from origin/main")
    require(not git_text("status", "--porcelain=v1", "--untracked-files=all"), "release checkout is not clean")
    return commit


def colon_records(data: bytes, label: str) -> list[list[str]]:
    try:
        return [line.split(":") for line in data.decode("utf-8").splitlines() if line]
    except UnicodeError as error:
        raise ReleaseError(f"{label} key listing is malformed") from error


def require_public_key_listing(records: list[list[str]]) -> None:
    public = [fields for fields in records if fields[0] == "pub"]
    fingerprints = [fields[9].upper() for fields in records if fields[0] == "fpr" and len(fields) > 9]
    uids = [fields for fields in records if fields[0] == "uid"]
    require(len(public) == 1 and not any(fields[0] in {"sec", "ssb", "sub"} for fields in records), "tracked key must contain one public primary and no private key or subkey")
    require(fingerprints == [FINGERPRINT], "tracked public-key fingerprint differs")
    key = public[0]
    require(len(key) > 11 and key[1] not in {"d", "e", "i", "r"} and key[6] in {"", "0"} and "s" in key[11], "tracked public key is not a valid non-expiring signing key")
    require(len(uids) == 1 and len(uids[0]) > 9 and uids[0][1] not in {"d", "e", "i", "r"} and uids[0][6] in {"", "0"} and uids[0][9] == EXPECTED_UID, "tracked public key UID differs")


def inspect_public_key(public_key: bytes) -> None:
    with tempfile.TemporaryDirectory() as directory:
        result = run_process((
            "gpg", "--batch", "--with-colons", "--fingerprint",
            "--import-options", "show-only", "--dry-run", "--import",
        ), public_key, Path(directory))
    require(result.returncode == 0, "tracked public key cannot be inspected")
    require_public_key_listing(colon_records(result.stdout, "public"))


def import_public_key(home: Path, public_key: bytes) -> None:
    inspect_public_key(public_key)
    result = run_process(("gpg", "--batch", "--yes", "--import"), public_key, home)
    require(result.returncode == 0, "tracked public key import failed")


def import_secret_key(home: Path, private_key: bytes) -> None:
    imported = run_process(("gpg", "--batch", "--yes", "--import"), private_key, home)
    require(imported.returncode == 0, "dedicated Maven secret-key import failed")
    listing = run_process(("gpg", "--batch", "--with-colons", "--fingerprint", "--list-secret-keys"), None, home)
    require(listing.returncode == 0, "dedicated Maven secret key cannot be inspected")
    records = colon_records(listing.stdout, "secret")
    secret = [fields for fields in records if fields[0] == "sec"]
    fingerprints = [fields[9].upper() for fields in records if fields[0] == "fpr" and len(fields) > 9]
    require(len(secret) == 1 and not any(fields[0] == "ssb" for fields in records), "secret key must contain one primary and no signing subkey")
    require(fingerprints == [FINGERPRINT], "secret key fingerprint differs from the approved fingerprint")


def valid_signature(status: bytes) -> bool:
    values: list[tuple[str, str]] = []
    try:
        lines = status.decode("utf-8").splitlines()
    except UnicodeError:
        return False
    for line in lines:
        prefix = "[GNUPG:] VALIDSIG "
        if line.startswith(prefix):
            fields = line[len(prefix):].split()
            if len(fields) >= 9:
                signer = fields[0].upper()
                primary = fields[9].upper() if len(fields) >= 10 and re.fullmatch(r"[0-9A-Fa-f]{40}", fields[9]) else signer
                values.append((signer, primary))
    return values == [(FINGERPRINT, FINGERPRINT)]


def signature_verifier(workspace: Path, public_key: bytes) -> SignatureVerifier:
    home = workspace / "gnupg-public"
    home.mkdir(mode=0o700)
    import_public_key(home, public_key)
    counter = 0

    def verify(name: str, signature: bytes, original: bytes) -> bool:
        nonlocal counter
        counter += 1
        original_path = workspace / f"verify-{counter}.original"
        signature_path = workspace / f"verify-{counter}.asc"
        original_path.write_bytes(original)
        signature_path.write_bytes(signature)
        try:
            result = run_process(("gpg", "--batch", "--status-fd", "1", "--verify", str(signature_path), str(original_path)), None, home)
            return result.returncode == 0 and valid_signature(result.stdout)
        finally:
            original_path.unlink(missing_ok=True)
            signature_path.unlink(missing_ok=True)

    return verify


def sign_originals(workspace: Path, originals: tuple[Original, ...], private_key: bytes, passphrase: str, public_key: bytes) -> tuple[dict[str, bytes], SignatureVerifier]:
    require(bool(private_key), "MAVEN_GPG_PRIVATE_KEY is empty")
    require(bool(passphrase) and "\n" not in passphrase and "\r" not in passphrase, "MAVEN_GPG_PASSPHRASE is empty or contains a newline")
    home = workspace / "gnupg-private"
    home.mkdir(mode=0o700)
    import_secret_key(home, private_key)
    verifier = signature_verifier(workspace, public_key)
    signatures: dict[str, bytes] = {}
    for index, original in enumerate(originals):
        original_path = workspace / f"original-{index}"
        signature_path = workspace / f"signature-{index}.asc"
        original_path.write_bytes(original.data)
        result = run_process((
            "gpg", "--batch", "--yes", "--pinentry-mode", "loopback", "--passphrase-fd", "0",
            "--local-user", FINGERPRINT + "!", "--armor", "--detach-sign",
            "--output", str(signature_path), str(original_path),
        ), (passphrase + "\n").encode("utf-8"), home)
        require(result.returncode == 0, f"detached signing failed: {original.name}")
        signature = read_regular(signature_path, f"detached signature {original.name}")
        require(verifier(original.name, signature, original.data), f"detached signature verification failed: {original.name}")
        signatures[original.relative_path + ".asc"] = signature
        original_path.unlink(missing_ok=True)
        signature_path.unlink(missing_ok=True)
    return signatures, verifier


def terminate_gpg_agents(workspace: Path) -> None:
    for home in workspace.glob("gnupg-*"):
        try:
            run_process(("gpgconf", "--homedir", str(home), "--kill", "all"))
        except Exception:
            pass


def release_assets(originals: tuple[Original, ...], signatures: dict[str, bytes]) -> dict[str, bytes]:
    assets = {item.relative_path: item.data for item in originals}
    assets.update(signatures)
    for original in originals:
        assets[original.relative_path + ".md5"] = (digest("md5", original.data) + "\n").encode("ascii")
        assets[original.relative_path + ".sha1"] = (digest("sha1", original.data) + "\n").encode("ascii")
    require(len(assets) == 104, "Central bundle must contain exactly 104 Maven members")
    return assets


def zip_bytes(assets: dict[str, bytes]) -> bytes:
    output = io.BytesIO()
    with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_STORED) as archive:
        for path, data in sorted(assets.items()):
            info = zipfile.ZipInfo(path, date_time=ZIP_TIMESTAMP)
            info.compress_type = zipfile.ZIP_STORED
            info.create_system = 3
            info.external_attr = ZIP_MODE
            archive.writestr(info, data)
    return output.getvalue()


def zip_members(data: bytes) -> dict[str, bytes]:
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as archive:
            entries = archive.infolist()
            names = [entry.filename for entry in entries]
            require(len(names) == len(set(names)) and all(not name.startswith("/") and ".." not in Path(name).parts for name in names), "Central ZIP contains duplicate or unsafe members")
            require(all(not entry.is_dir() and entry.create_system == 3 and entry.external_attr == ZIP_MODE for entry in entries), "Central ZIP contains a special or noncanonical member")
            return {name: archive.read(name) for name in names}
    except zipfile.BadZipFile as error:
        raise ReleaseError("Central ZIP is malformed") from error


def verify_bundle(bundle: bytes, originals: tuple[Original, ...], verifier: SignatureVerifier) -> dict[str, bytes]:
    members = zip_members(bundle)
    expected = {item.relative_path + suffix for item in originals for suffix in ("", ".asc", ".md5", ".sha1")}
    require(set(members) == expected and len(members) == 104, "Central ZIP does not contain the exact 104 Maven members")
    for original in originals:
        path = original.relative_path
        require(members[path] == original.data, f"Central ZIP original differs: {original.name}")
        require(members[path + ".md5"] == (digest("md5", original.data) + "\n").encode("ascii"), f"Central ZIP MD5 differs: {original.name}")
        require(members[path + ".sha1"] == (digest("sha1", original.data) + "\n").encode("ascii"), f"Central ZIP SHA-1 differs: {original.name}")
        require(verifier(original.name, members[path + ".asc"], original.data), f"Central ZIP signature differs: {original.name}")
    return members


def ensure_absent(path: Path, label: str) -> None:
    require(not path.exists() and not path.is_symlink(), f"{label} already exists")


def write_outputs(identity: Identity, commit: str, originals: tuple[Original, ...], bundle: bytes, notes: str) -> None:
    ensure_absent(RELEASE_OUTPUT, "release output")
    pending = RELEASE_OUTPUT.with_name(".release-pending")
    ensure_absent(pending, "pending release output")
    pending.mkdir(parents=True)
    (pending / f"tvheadend-sdk-{identity.version}-central.zip").write_bytes(bundle)
    (pending / "release-manifest.json").write_bytes(canonical_json(release_manifest(identity, commit, originals)))
    (pending / "release-notes.md").write_text(notes, encoding="utf-8")
    os.replace(pending, RELEASE_OUTPUT)


def read_outputs(identity: Identity, commit: str, originals: tuple[Original, ...], verifier: SignatureVerifier) -> tuple[bytes, dict[str, bytes]]:
    try:
        entries = list(RELEASE_OUTPUT.iterdir())
    except OSError as error:
        raise ReleaseError("release output cannot be inspected") from error
    central_name = f"tvheadend-sdk-{identity.version}-central.zip"
    require({entry.name for entry in entries} == {central_name, "release-manifest.json", "release-notes.md"}, "release output has missing or extra entries")
    manifest_data = read_regular(RELEASE_OUTPUT / "release-manifest.json", "release manifest")
    expected_manifest = release_manifest(identity, commit, originals)
    require(manifest_data == canonical_json(expected_manifest), "release manifest differs from the exact staged originals")
    bundle = read_regular(RELEASE_OUTPUT / central_name, "Central ZIP")
    members = verify_bundle(bundle, originals, verifier)
    notes = read_regular(RELEASE_OUTPUT / "release-notes.md", "release notes")
    require(notes == release_notes(identity).encode("utf-8"), "release notes differ from the changelog")
    return bundle, members


def stdlib_http(method: str, url: str, headers: dict[str, str], body: bytes | None) -> HttpResponse:
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return HttpResponse(response.status, response.read())
    except urllib.error.HTTPError as error:
        return HttpResponse(error.code, error.read())
    except (OSError, urllib.error.URLError) as error:
        raise ReleaseError("Central HTTPS request failed") from error


def central_url(relative_path: str) -> str:
    return f"{MAVEN_URL}/{urllib.parse.quote(relative_path, safe='/')}"


def member_paths(originals: tuple[Original, ...]) -> tuple[str, ...]:
    return tuple(sorted(item.relative_path + suffix for item in originals for suffix in ("", ".asc", ".md5", ".sha1")))


def require_central_absent(originals: tuple[Original, ...], client: HttpClient) -> None:
    for path in member_paths(originals):
        response = client("GET", central_url(path), {}, None)
        require(response.status == 404, "Central coordinates are not wholly absent; automatic upload or recovery is forbidden")


def verify_published_members(expected: dict[str, bytes], client: HttpClient) -> None:
    require(len(expected) == 104, "published verification requires exactly 104 expected members")
    for path, data in sorted(expected.items()):
        response = client("GET", central_url(path), {}, None)
        require(response.status == 200 and response.body == data, f"published Central member differs or is unavailable: {Path(path).name}")


def validate_portal_token(token: str) -> None:
    require(bool(token) and not any(character.isspace() for character in token), "CENTRAL_PORTAL_TOKEN is empty or malformed")
    try:
        decoded = base64.b64decode(token, validate=True)
    except (binascii.Error, ValueError) as error:
        raise ReleaseError("CENTRAL_PORTAL_TOKEN is not valid base64") from error
    require(decoded.count(b":") == 1, "CENTRAL_PORTAL_TOKEN must encode username:password")
    username, password = decoded.split(b":", 1)
    require(bool(username) and bool(password) and all(0x21 <= byte < 0x7F for byte in decoded), "CENTRAL_PORTAL_TOKEN has an invalid username:password shape")


def scoped_credentials(required: tuple[str, ...], environment: dict[str, str]) -> tuple[str, ...]:
    unrelated = (set(SECRET_NAMES) | {"GH_TOKEN"}) - set(required)
    require(not any(name in environment for name in unrelated), "release step received an unrelated credential")
    try:
        values = tuple(environment[name] for name in required)
    except KeyError as error:
        raise ReleaseError(f"required release secret is unavailable: {error.args[0]}") from error
    require(all(values), "required release secret is empty")
    return values


def upload_bundle(bundle: bytes, identity: Identity, token: str, client: HttpClient) -> str:
    boundary = "tvheadend-sdk-" + uuid.uuid4().hex
    body = (
        f"--{boundary}\r\n"
        'Content-Disposition: form-data; name="bundle"; filename="bundle.zip"\r\n'
        "Content-Type: application/zip\r\n\r\n"
    ).encode("ascii") + bundle + f"\r\n--{boundary}--\r\n".encode("ascii")
    query = urllib.parse.urlencode({"name": f"tvheadend-sdk-{identity.version}", "publishingType": "AUTOMATIC"})
    response = client("POST", f"{UPLOAD_URL}?{query}", {
        "Authorization": f"Bearer {token}",
        "Content-Type": f"multipart/form-data; boundary={boundary}",
    }, body)
    try:
        deployment = response.body.decode("ascii").strip()
    except UnicodeError:
        deployment = ""
    require(response.status == 201 and DEPLOYMENT_ID.fullmatch(deployment) is not None, "Central upload response is ambiguous; blind retry is forbidden")
    return deployment


def upload_once(bundle: bytes, identity: Identity, environment: dict[str, str], client: HttpClient, marker: Path = UPLOAD_MARKER) -> str:
    token, = scoped_credentials(("CENTRAL_PORTAL_TOKEN",), environment)
    validate_portal_token(token)
    ensure_absent(marker, "Central upload-attempt marker")
    descriptor = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "w", encoding="ascii") as output:
        output.write("attempted\n")
    return upload_bundle(bundle, identity, token, client)


def workflow_errors(workflow: str) -> list[str]:
    errors: list[str] = []
    if workflow.count("tags:\n      - 'v*'") != 1 or any(name in workflow for name in ("workflow_dispatch:", "pull_request:", "schedule:", "branches:")):
        errors.append("release workflow must be triggered only by v* tag pushes")
    if workflow.count("    environment: central") != 1 or workflow.count("github.run_attempt == 1") != 1:
        errors.append("release workflow must use the protected Environment on the first attempt only")
    if workflow.count("group: release-${{ github.ref }}") != 1 or workflow.count("cancel-in-progress: false") != 1:
        errors.append("release workflow must serialize attempts for the exact tag")
    if "contents: write" in workflow or "GH_TOKEN" in workflow or "github.token" in workflow:
        errors.append("release workflow must remain read-only and must not finalize GitHub autonomously")
    secret_references = re.findall(r"\$\{\{ secrets\.([A-Z0-9_]+) \}\}", workflow)
    if secret_references != list(SECRET_NAMES):
        errors.append("release secrets must occur exactly once in the protected prepare/upload steps")
    prepare_step = workflow.partition("      - name: Prepare signed release bundle")[2].partition("\n      - name:")[0]
    upload_step = workflow.partition("      - name: Upload once to Central")[2].partition("\n      - name:")[0]
    if re.findall(r"\$\{\{ secrets\.([A-Z0-9_]+) \}\}", prepare_step) != list(SECRET_NAMES[:2]) or re.findall(r"\$\{\{ secrets\.([A-Z0-9_]+) \}\}", upload_step) != [SECRET_NAMES[2]]:
        errors.append("OpenPGP and Central credentials must remain isolated to their exact steps")
    commands = ("./tools/publish-central-release --prepare", "./tools/publish-central-release --upload")
    positions = [workflow.find(command) for command in commands]
    artifact = workflow.find("uses: actions/upload-artifact@")
    if any(workflow.count(command) != 1 for command in commands) or workflow.count("uses: actions/upload-artifact@") != 1 or not (positions[0] < artifact < positions[1]):
        errors.append("release workflow must prepare, retain, and upload exactly once in order")
    if "          path: build/release" not in workflow or "--verify-published" in workflow:
        errors.append("release workflow must retain only release output and leave convergence explicit")
    return errors


def check_setup() -> list[str]:
    errors: list[str] = []
    try:
        identity = configured_identity()
        extract_release_notes(read_regular(ROOT / "CHANGELOG.md", "CHANGELOG").decode("utf-8"), identity.version)
        fingerprint = read_regular(ROOT / "release/openpgp/primary-fingerprint.txt", "tracked fingerprint")
        require(fingerprint == (FINGERPRINT + "\n").encode("ascii"), "tracked fingerprint differs")
        inspect_public_key(read_regular(ROOT / "release/openpgp/public-key.asc", "tracked public key"))
        for name in ("check-staged-publication", "publish-central-release"):
            require((ROOT / "tools" / name).stat().st_mode & 0o111 != 0, f"tools/{name} must be executable")
        workflow = read_regular(ROOT / ".github/workflows/release.yml", "release workflow").decode("utf-8")
        errors.extend(workflow_errors(workflow))
        ci = read_regular(ROOT / ".github/workflows/ci.yml", "CI workflow").decode("utf-8")
        if "secrets." in ci or "--prepare" in ci or "--upload" in ci or "upload-artifact" in ci:
            errors.append("normal CI must not access release credentials or mutation paths")
    except (ReleaseError, OSError, UnicodeError) as error:
        errors.append(str(error))
    return errors


def expect_error(errors: list[str], label: str, action: Callable[[], object]) -> None:
    try:
        action()
    except ReleaseError:
        return
    errors.append(f"self-test accepted {label}")


def self_test() -> list[str]:
    errors = check_setup()
    build = f'group = "{GROUP}"\nversion = "0.1.2"\n'
    identity = configured_identity(build, "v0.1.2")
    if len(expected_paths(identity)) != 26:
        errors.append("self-test release inventory is not 26 originals")
    expect_error(errors, "snapshot version", lambda: configured_identity(build.replace("0.1.2", "0.1.2-SNAPSHOT")))
    expect_error(errors, "major-one version", lambda: configured_identity(build.replace("0.1.2", "1.0.0")))
    expect_error(errors, "wrong group", lambda: configured_identity(build.replace(GROUP, "invalid.example")))
    expect_error(errors, "wrong tag", lambda: configured_identity(build, "v0.1.3"))
    token = base64.b64encode(b"user:password").decode("ascii")
    try:
        validate_portal_token(token)
    except ReleaseError as error:
        errors.append(f"self-test rejected a valid token shape: {error}")
    expect_error(errors, "malformed token", lambda: validate_portal_token("not base64"))
    tag_object = "1" * 40
    tagged_commit = "2" * 40
    if parse_remote_tag(f"{tag_object}\trefs/tags/v0.1.2\n".encode(), "v0.1.2") != tag_object:
        errors.append("self-test rejected an exact remote tag object")
    expect_error(errors, "wrong remote tag", lambda: parse_remote_tag(f"{tag_object}\trefs/tags/v0.1.3\n".encode(), "v0.1.2"))
    expect_error(errors, "lightweight tag", lambda: require_local_tag("commit", tagged_commit, tagged_commit))
    expect_error(errors, "wrong tag commit", lambda: require_local_tag("tag", "3" * 40, tagged_commit))
    context = {"GITHUB_ACTIONS": "true", "GITHUB_EVENT_NAME": "push", "GITHUB_REF_TYPE": "tag", "GITHUB_REPOSITORY": REPOSITORY, "GITHUB_REF": "refs/tags/v0.1.2", "GITHUB_REF_NAME": "v0.1.2", "GITHUB_RUN_ATTEMPT": "1", "GITHUB_SHA": tagged_commit}
    try:
        require_action_context(identity, tagged_commit, context)
    except ReleaseError as error:
        errors.append(f"self-test rejected exact action context: {error}")
    for label, name, value in (("wrong repository", "GITHUB_REPOSITORY", "other/repo"), ("tag object instead of commit", "GITHUB_SHA", tag_object), ("wrong action tag", "GITHUB_REF_NAME", "v0.1.3"), ("duplicate attempt", "GITHUB_RUN_ATTEMPT", "2")):
        expect_error(errors, label, lambda name=name, value=value: require_action_context(identity, tagged_commit, {**context, name: value}))
    originals = tuple(Original(f"group/module/0.1.2/file-{index}", f"file-{index}", f"original-{index}".encode(), digest("sha256", f"original-{index}".encode())) for index in range(26))
    signatures = {item.relative_path + ".asc": b"signature" for item in originals}
    bundle = zip_bytes(release_assets(originals, signatures))
    verifier = lambda _name, signature, _data: signature == b"signature"
    try:
        verify_bundle(bundle, originals, verifier)
    except ReleaseError as error:
        errors.append(f"self-test rejected exact 104-member bundle: {error}")
    altered = zip_members(bundle)
    altered[originals[0].relative_path + ".md5"] = b"changed\n"
    expect_error(errors, "altered bundle checksum", lambda: verify_bundle(zip_bytes(altered), originals, verifier))
    unsafe = io.BytesIO()
    with zipfile.ZipFile(unsafe, "w") as archive:
        link = zipfile.ZipInfo("unsafe-link")
        link.create_system = 3
        link.external_attr = (stat.S_IFLNK | 0o777) << 16
        archive.writestr(link, b"target")
    expect_error(errors, "special bundle member", lambda: zip_members(unsafe.getvalue()))
    all_absent = lambda _method, _url, _headers, _body: HttpResponse(404, b"")
    try:
        require_central_absent(originals, all_absent)
    except ReleaseError as error:
        errors.append(f"self-test rejected wholly absent Central members: {error}")
    present = lambda _method, _url, _headers, _body: HttpResponse(200, b"present")
    expect_error(errors, "existing Central member", lambda: require_central_absent(originals, present))
    workflow = read_regular(ROOT / ".github/workflows/release.yml", "release workflow").decode("utf-8")
    if not workflow_errors(workflow.replace("${{ secrets.CENTRAL_PORTAL_TOKEN }}", "${{ secrets.EXTRA_TOKEN }}", 1)):
        errors.append("self-test accepted a changed release credential boundary")
    if not workflow_errors(workflow.replace("github.run_attempt == 1", "github.run_attempt == 2")):
        errors.append("self-test accepted a duplicate workflow attempt")
    with tempfile.TemporaryDirectory() as directory:
        marker = Path(directory) / "attempted"
        calls: list[str] = []
        client = lambda method, _url, _headers, _body: (calls.append(method) or HttpResponse(201, b"12345678-1234-4234-9234-123456789abc"))
        try:
            upload_once(bundle, identity, {"CENTRAL_PORTAL_TOKEN": token}, client, marker)
        except ReleaseError as error:
            errors.append(f"self-test rejected one valid upload: {error}")
        expect_error(errors, "duplicate upload", lambda: upload_once(bundle, identity, {"CENTRAL_PORTAL_TOKEN": token}, client, marker))
        if calls != ["POST"] or not marker.is_file():
            errors.append("self-test valid upload did not make exactly one marked POST")
        missing = Path(directory) / "missing"
        expect_error(errors, "missing upload credential", lambda: upload_once(bundle, identity, {}, client, missing))
        expect_error(errors, "wrongly scoped upload credential", lambda: upload_once(bundle, identity, {"CENTRAL_PORTAL_TOKEN": token, "MAVEN_GPG_PRIVATE_KEY": "secret"}, client, missing))
        expect_error(errors, "wrongly scoped signing credential", lambda: scoped_credentials(("MAVEN_GPG_PRIVATE_KEY", "MAVEN_GPG_PASSPHRASE"), {"MAVEN_GPG_PRIVATE_KEY": "key", "MAVEN_GPG_PASSPHRASE": "passphrase", "CENTRAL_PORTAL_TOKEN": token}))
        ambiguous = Path(directory) / "ambiguous"
        expect_error(errors, "ambiguous upload response", lambda: upload_once(bundle, identity, {"CENTRAL_PORTAL_TOKEN": token}, lambda *_args: HttpResponse(500, b"unknown"), ambiguous))
        if missing.exists() or not ambiguous.is_file():
            errors.append("self-test did not preserve pre/post-upload attempt boundaries")
    return errors


def prepare() -> None:
    identity = configured_identity(tag=os.environ.get("GITHUB_REF_NAME", ""))
    commit = require_publish_context(identity)
    originals = staged_originals(identity)
    require_central_absent(originals, stdlib_http)
    private_key_text, passphrase = scoped_credentials(("MAVEN_GPG_PRIVATE_KEY", "MAVEN_GPG_PASSPHRASE"), os.environ)
    public_key = read_regular(ROOT / "release/openpgp/public-key.asc", "tracked public key")
    ROOT.joinpath("build").mkdir(exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".release-prepare-", dir=ROOT / "build"))
    temporary.chmod(0o700)
    try:
        signatures, verifier = sign_originals(temporary, originals, private_key_text.encode("utf-8"), passphrase, public_key)
        bundle = zip_bytes(release_assets(originals, signatures))
        verify_bundle(bundle, originals, verifier)
        write_outputs(identity, commit, originals, bundle, release_notes(identity))
    finally:
        terminate_gpg_agents(temporary)
        shutil.rmtree(temporary)
    print("Signed release bundle prepared; no Central mutation occurred")


def upload() -> None:
    identity = configured_identity(tag=os.environ.get("GITHUB_REF_NAME", ""))
    commit = require_publish_context(identity)
    originals = staged_originals(identity)
    public_key = read_regular(ROOT / "release/openpgp/public-key.asc", "tracked public key")
    temporary = Path(tempfile.mkdtemp(prefix=".release-upload-", dir=ROOT / "build"))
    temporary.chmod(0o700)
    try:
        verifier = signature_verifier(temporary, public_key)
        bundle, _members = read_outputs(identity, commit, originals, verifier)
        require_central_absent(originals, stdlib_http)
        require_remote_tag(identity, commit)
        deployment = upload_once(bundle, identity, os.environ, stdlib_http)
    finally:
        terminate_gpg_agents(temporary)
        shutil.rmtree(temporary)
    print(f"CENTRAL_DEPLOYMENT_ID={deployment}")
    print("Central accepted the sole upload attempt; convergence and GitHub release are explicit operator steps")


def verify_published() -> None:
    identity = configured_identity()
    scoped_credentials((), os.environ)
    commit = git_text("rev-parse", "HEAD")
    originals = staged_originals(identity)
    public_key = read_regular(ROOT / "release/openpgp/public-key.asc", "tracked public key")
    temporary = Path(tempfile.mkdtemp(prefix=".release-verify-", dir=ROOT / "build"))
    temporary.chmod(0o700)
    try:
        verifier = signature_verifier(temporary, public_key)
        _bundle, members = read_outputs(identity, commit, originals, verifier)
        verify_published_members(members, stdlib_http)
    finally:
        terminate_gpg_agents(temporary)
        shutil.rmtree(temporary)
    print("Published Central bytes match all 104 signed Maven members")


def main() -> int:
    modes = {"--self-test", "--check-setup", "--prepare", "--upload", "--verify-published"}
    arguments = sys.argv[1:]
    if len(arguments) != 1 or arguments[0] not in modes:
        print("usage: publish-central-release --self-test|--check-setup|--prepare|--upload|--verify-published", file=sys.stderr)
        return 2
    try:
        mode = arguments[0]
        if mode == "--self-test":
            errors = self_test()
        elif mode == "--check-setup":
            errors = check_setup()
        elif mode == "--prepare":
            prepare()
            return 0
        elif mode == "--upload":
            upload()
            return 0
        else:
            verify_published()
            return 0
        for error in errors:
            print(f"error: {error}", file=sys.stderr)
        if errors:
            return 1
        print("Release tooling focused offline checks passed")
        return 0
    except (ReleaseError, UnicodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except OSError:
        print("error: release output operation failed", file=sys.stderr)
        return 1

if __name__ == "__main__":
    raise SystemExit(main())
