    if deployment_state(b'{"deploymentState":"PUBLISHED"}') != "PUBLISHED" or not status_complete("PUBLISHED"):
        errors.append("self-test rejected PUBLISHED deployment state")
    expect_error(errors, "terminal FAILED deployment", lambda: status_complete("FAILED"))
    expect_error(errors, "unknown deployment state", lambda: status_complete("UNKNOWN"))
    changelog = "# Changelog\n\n## [0.2.0]\n\nCurrent notes.\n\n## [0.1.0]\n\nOld notes.\n"
    if extract_release_notes(changelog, "0.2.0") != "## [0.2.0]\n\nCurrent notes.\n":
        errors.append("self-test release-note extraction mismatch")
    expect_error(errors, "missing release notes", lambda: extract_release_notes(changelog, "0.3.0"))
    errors.extend(setup_regression_tests())
    return errors


def authorize_central_upload() -> None:
    build_text = read_regular(ROOT / "build.gradle.kts", "build.gradle.kts").decode("utf-8")
    tag = os.environ.get("GITHUB_REF_NAME", "")
    identity = configured_identity(build_text, tag)
    commit = require_publish_context(identity)
    for name in SECRET_NAMES:
        if name in os.environ:
            raise ReleaseError(f"Central authorization must not receive release secret: {name}")
    token = os.environ.get("GH_TOKEN", "")
    if not token or any(character.isspace() for character in token):
        raise ReleaseError("GH_TOKEN is unavailable or malformed")
    originals = staged_originals(ROOT / "build/local-maven", identity)
    decision = central_preflight(originals, stdlib_http)
    run_id, run_attempt = github_run_identity()
    previous_publish_started = github_previous_publish_started(
        identity,
        commit,
        run_id,
        run_attempt,
        token,
        stdlib_http,
    )
    if decision == "upload" and previous_publish_started:
        raise ReleaseError(
            "a prior exact-tag workflow run or attempt started Central publication while coordinates remain absent; "
            "blind retry is forbidden"
        )
    write_central_authorization(
        CENTRAL_AUTHORIZATION_PATH,
        identity,
        commit,
        originals,
        decision,
        previous_publish_started,
    )
    write_github_step_output("decision", decision)
    print(f"Central {decision} authorized for this exact workflow attempt")


def publish() -> None:
    build_text = read_regular(ROOT / "build.gradle.kts", "build.gradle.kts").decode("utf-8")
    tag = os.environ.get("GITHUB_REF_NAME", "")
    identity = configured_identity(build_text, tag)
    commit = require_publish_context(identity)
    if "GH_TOKEN" in os.environ or "GITHUB_TOKEN" in os.environ:
        raise ReleaseError("Central publish step must not receive GH_TOKEN")
    output = ROOT / "build/release"
    ensure_output_absent(output)
    originals = staged_originals(ROOT / "build/local-maven", identity)
    changelog = read_regular(ROOT / "CHANGELOG.md", "CHANGELOG.md").decode("utf-8")
    notes = github_release_notes(changelog, identity)
    manifest = release_manifest(identity, commit, originals)
    validate_manifest(manifest, originals)
    public_key = read_regular(ROOT / "release/openpgp/public-key.asc", "tracked public key")
    decision = central_preflight(originals, stdlib_http)
    authorized_decision, previous_publish_started = read_central_authorization(
        CENTRAL_AUTHORIZATION_PATH,
        identity,
        commit,
        originals,
    )
    if decision == "upload" and (authorized_decision != "upload" or previous_publish_started):
        raise ReleaseError("this workflow attempt is not authorized to create a Central deployment")
    build_directory = ROOT / "build"
    build_directory.mkdir(exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".central-release-", dir=build_directory))
    temporary.chmod(0o700)
    try:
        workspace = temporary / "private"
        workspace.mkdir(mode=0o700)
        if decision == "upload":
            try:
                private_key = os.environ["MAVEN_GPG_PRIVATE_KEY"].encode("utf-8")
                passphrase = os.environ["MAVEN_GPG_PASSPHRASE"]
                token = os.environ["CENTRAL_PORTAL_TOKEN"]
            except KeyError as error:
                raise ReleaseError(f"required release secret is unavailable: {error.args[0]}") from error
            if not private_key:
                raise ReleaseError("MAVEN_GPG_PRIVATE_KEY is empty")
            validate_portal_token(token)
            signatures, verifier = sign_originals(
                workspace,
                originals,
                private_key,
                passphrase,
                public_key,
                release_signing_epoch(commit),
            )
            assets = asset_map(originals, signatures, sidecars(originals))
            bundle = zip_bytes(assets)
            verify_zip(bundle, originals, manifest, verifier)
            require_remote_release_tag(identity, commit)
            deployment = upload_bundle(bundle, identity, token, stdlib_http)
            announce_and_poll(deployment, token, stdlib_http)
            poll_published_assets(assets, stdlib_http)
        else:
            for name in SECRET_NAMES:
                if name in os.environ:
                    raise ReleaseError(f"Central recovery must not receive release secret: {name}")
            verifier = public_signature_verifier(workspace, public_key)
            require_remote_release_tag(identity, commit)
            assets, bundle = recover_published_assets(originals, manifest, stdlib_http, verifier)
        pending_output = temporary / "release"
        write_outputs(pending_output, identity, assets, bundle, manifest_bytes(manifest), notes)
        ensure_output_absent(output)
        os.replace(pending_output, output)
    finally:
        terminate_gpg_agents(temporary)
        shutil.rmtree(temporary, ignore_errors=True)
    print(f"Central release verified for {', '.join(identity.coordinates)}; GitHub assets are ready")


def finalize_github_release() -> None:
    build_text = read_regular(ROOT / "build.gradle.kts", "build.gradle.kts").decode("utf-8")
    tag = os.environ.get("GITHUB_REF_NAME", "")
    identity = configured_identity(build_text, tag)
    commit = require_publish_context(identity)
    for name in SECRET_NAMES:
        if name in os.environ:
            raise ReleaseError(f"GitHub finalizer must not receive Central or GPG secret: {name}")
    token = os.environ.get("GH_TOKEN", "")
    if not token or any(character.isspace() for character in token):
        raise ReleaseError("GH_TOKEN is unavailable or malformed")
    originals = staged_originals(ROOT / "build/local-maven", identity)
    changelog = read_regular(ROOT / "CHANGELOG.md", "CHANGELOG.md").decode("utf-8")
    expected_notes = github_release_notes(changelog, identity)
    expected, notes = github_release_inputs(
        ROOT / "build/release",
        identity,
        commit,
        originals,
        expected_notes,
    )
    require_remote_release_tag(identity, commit)
    finalize_github_release_state(identity, commit, expected, notes, token, stdlib_http)
    print(f"GitHub prerelease finalized for {identity.tag} with two exact assets")


def main() -> int:
    parser = argparse.ArgumentParser()
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--self-test", action="store_true")
    modes.add_argument("--check-setup", action="store_true")
    modes.add_argument("--authorize-central-upload", action="store_true")
    modes.add_argument("--publish", action="store_true")
    modes.add_argument("--finalize-github-release", action="store_true")
    arguments = parser.parse_args()
    try:
        if arguments.self_test:
            errors = self_test()
            success = "Central release synthetic self-tests passed"
        elif arguments.check_setup:
            errors = setup_errors()
            success = "Central release setup check passed"
        elif arguments.authorize_central_upload:
            authorize_central_upload()
            return 0
        elif arguments.publish:
            publish()
            return 0
        else:
            finalize_github_release()
            return 0
    except (ReleaseError, UnicodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(success)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
