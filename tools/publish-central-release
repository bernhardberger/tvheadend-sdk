class ReleaseError(RuntimeError):
    """A release invariant failed without exposing secret data."""


@dataclass(frozen=True)
class ReleaseIdentity:
    version: str
    tag: str
    coordinates: tuple[str, ...]


@dataclass(frozen=True)
class ExpectedOriginal:
    module: str
    name: str
    relative_path: str


@dataclass(frozen=True)
class Original:
    module: str
    name: str
    relative_path: str
    data: bytes
    sha256: str


@dataclass(frozen=True)
class HttpResponse:
    status: int
    body: bytes


HttpClient = Callable[[str, str, dict[str, str], bytes | None], HttpResponse]
SignatureVerifier = Callable[[str, bytes, bytes], bool]


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def md5(data: bytes) -> str:
    return hashlib.md5(data).hexdigest()


def sha1(data: bytes) -> str:
    return hashlib.sha1(data).hexdigest()


def read_regular(path: Path, label: str) -> bytes:
    try:
        if not stat.S_ISREG(path.lstat().st_mode):
            raise ReleaseError(f"{label} is not a regular file")
        return path.read_bytes()
    except FileNotFoundError as error:
        raise ReleaseError(f"{label} is missing") from error
    except OSError as error:
        raise ReleaseError(f"{label} cannot be read: {error}") from error


def configured_identity(build_text: str, tag: str | None = None) -> ReleaseIdentity:
    groups = re.findall(r'(?m)^group\s*=\s*"([^"]+)"\s*$', build_text)
    versions = re.findall(r'(?m)^version\s*=\s*"([^"]+)"\s*$', build_text)
    if groups != [GROUP]:
        raise ReleaseError(f"configured release group must be exactly {GROUP}")
    if len(versions) != 1:
        raise ReleaseError("configured release version must be one literal assignment")
    version = versions[0]
    match = SEMVER.fullmatch(version)
    if match is None:
        raise ReleaseError("configured release version must be strict SemVer without snapshot, prerelease, or build metadata")
    if match.group(1) != "0":
        raise ReleaseError("the current release lane accepts only major-zero versions")
    expected_tag = f"v{version}"
    if tag is not None and tag != expected_tag:
        raise ReleaseError(f"release tag must be exactly {expected_tag}")
    coordinates = tuple(f"{GROUP}:{module}:{version}" for module in sorted(MODULE_EXTENSIONS))
    return ReleaseIdentity(version, expected_tag, coordinates)


def expected_originals(identity: ReleaseIdentity) -> tuple[ExpectedOriginal, ...]:
    group_path = GROUP.replace(".", "/")
    result: list[ExpectedOriginal] = []
    for module, main_extension in sorted(MODULE_EXTENSIONS.items()):
        kinds = [
            (None, main_extension),
            ("sources", "jar"),
            ("javadoc", "jar"),
            (None, "pom"),
            (None, "module"),
        ]
        if module == "sdk-media3":
            kinds.append(("ffmpeg-sources", "tar.xz"))
        for classifier, extension in kinds:
            suffix = f"-{classifier}" if classifier else ""
            name = f"{module}-{identity.version}{suffix}.{extension}"
            relative = f"{group_path}/{module}/{identity.version}/{name}"
            result.append(ExpectedOriginal(module, name, relative))
    if len(result) != ORIGINAL_COUNT or len({item.relative_path for item in result}) != ORIGINAL_COUNT:
        raise ReleaseError("internal release inventory is not exactly 26 unique originals")
    return tuple(result)


def reject_symlinks(root: Path) -> None:
    if root.is_symlink() or not root.is_dir():
        raise ReleaseError("release staging repository is missing or unsafe")
    for path in root.rglob("*"):
        if path.is_symlink():
            raise ReleaseError(f"release staging contains a symlink: {path.name}")


def staged_originals(repository: Path, identity: ReleaseIdentity) -> tuple[Original, ...]:
    expected_repository = ROOT / "build/local-maven"
    if repository.absolute() != expected_repository.absolute():
        raise ReleaseError("release staging repository is not the checkout-local Maven repository")
    reject_symlinks(repository)
    group_directory = repository.joinpath(*GROUP.split("."))
    try:
        modules = {entry.name for entry in group_directory.iterdir() if entry.is_dir()}
    except OSError as error:
        raise ReleaseError(f"release staging group cannot be inspected: {error}") from error
    if modules != set(MODULE_EXTENSIONS):
        raise ReleaseError(f"release staging module inventory mismatch: {sorted(modules)}")
    expected = expected_originals(identity)
    by_module = {
        module: tuple(item for item in expected if item.module == module)
        for module in MODULE_EXTENSIONS
    }
    originals: list[Original] = []
    for module in sorted(MODULE_EXTENSIONS):
        version_directory = group_directory / module / identity.version
        module_expected = by_module[module]
        names = {item.name for item in module_expected}
        required = names | {name + ".sha256" for name in names}
        allowed = names | {
            name + suffix
            for name in names
            for suffix in STAGING_CHECKSUM_SUFFIXES
        }
        try:
            entries = list(version_directory.iterdir())
        except FileNotFoundError as error:
            raise ReleaseError(f"release staging directory is missing for {module}") from error
        except OSError as error:
            raise ReleaseError(f"release staging directory is unreadable for {module}: {error}") from error
        actual: set[str] = set()
        folded: set[str] = set()
        for entry in entries:
            try:
                regular = stat.S_ISREG(entry.lstat().st_mode)
            except OSError as error:
                raise ReleaseError(f"staging entry metadata is unreadable: {entry.name}") from error
            if not regular:
                raise ReleaseError(f"staging contains a non-regular entry: {entry.name}")
            folded_name = entry.name.casefold()
            if folded_name in folded:
                raise ReleaseError("release staging contains a case collision")
            folded.add(folded_name)
            actual.add(entry.name)
        missing = required - actual
        extra = actual - allowed
        if missing or extra:
            raise ReleaseError(
                f"release staging inventory mismatch for {module}; "
                f"missing={sorted(missing)}, extra={sorted(extra)}"
            )
        for item in module_expected:
            data = read_regular(version_directory / item.name, f"staged original {item.name}")
            if not data or len(data) > MAX_ORIGINAL:
                raise ReleaseError(f"staged original is empty or oversized: {item.name}")
            digest = sha256(data)
            checksum = read_regular(version_directory / (item.name + ".sha256"), f"staged checksum {item.name}.sha256")
            if checksum != (digest + "\n").encode("ascii"):
                raise ReleaseError(f"staged SHA-256 does not match original: {item.name}")
            originals.append(Original(item.module, item.name, item.relative_path, data, digest))
    if len(originals) != ORIGINAL_COUNT:
        raise ReleaseError(f"release staging has {len(originals)} originals, expected {ORIGINAL_COUNT}")
    return tuple(originals)


def release_manifest(identity: ReleaseIdentity, commit: str, originals: tuple[Original, ...]) -> dict[str, object]:
    return {
        "schema": "tvheadend-sdk-release-manifest-v1",
        "coordinates": list(identity.coordinates),
        "tag": identity.tag,
        "commit": commit,
        "fingerprint": FINGERPRINT,
        "files": [
            {
                "path": original.relative_path,
                "size": len(original.data),
                "sha256": original.sha256,
            }
            for original in sorted(originals, key=lambda item: item.relative_path)
        ],
    }


def manifest_bytes(manifest: dict[str, object]) -> bytes:
    return (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode("utf-8")


def validate_manifest(manifest: dict[str, object], originals: tuple[Original, ...]) -> None:
    expected = [
        {"path": item.relative_path, "size": len(item.data), "sha256": sha256(item.data)}
        for item in sorted(originals, key=lambda value: value.relative_path)
    ]
    if manifest.get("files") != expected or len(expected) != ORIGINAL_COUNT:
        raise ReleaseError("release manifest does not match the 26 original bytes")


def sidecars(originals: tuple[Original, ...]) -> dict[str, bytes]:
    result: dict[str, bytes] = {}
    for original in originals:
        result[original.relative_path + ".md5"] = (md5(original.data) + "\n").encode("ascii")
        result[original.relative_path + ".sha1"] = (sha1(original.data) + "\n").encode("ascii")
    return result


def asset_map(
    originals: tuple[Original, ...],
    signatures: dict[str, bytes],
    checksums: dict[str, bytes],
) -> dict[str, bytes]:
    assets = {item.relative_path: item.data for item in originals}
    assets.update({path + ".asc": data for path, data in signatures.items()})
    assets.update(checksums)
    if len(assets) != MAVEN_MEMBER_COUNT:
        raise ReleaseError(f"release asset inventory must contain exactly {MAVEN_MEMBER_COUNT} files")
    return assets


def zip_bytes(assets: dict[str, bytes]) -> bytes:
    output = io.BytesIO()
    with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_STORED) as archive:
        for path in sorted(assets):
            info = zipfile.ZipInfo(path, date_time=ZIP_TIMESTAMP)
            info.compress_type = zipfile.ZIP_STORED
            info.create_system = 3
            info.external_attr = ZIP_FILE_MODE
            archive.writestr(info, assets[path])
    return output.getvalue()


def zip_member_map(data: bytes) -> dict[str, bytes]:
    try:
        with zipfile.ZipFile(io.BytesIO(data), "r") as archive:
            infos = archive.infolist()
            names = [info.filename for info in infos]
            if len(names) != len(set(names)):
                raise ReleaseError("Central ZIP contains duplicate members")
            if any(info.is_dir() or info.filename.startswith("/") or ".." in Path(info.filename).parts for info in infos):
                raise ReleaseError("Central ZIP contains a directory or unsafe member")
            return {name: archive.read(name) for name in names}
    except (OSError, zipfile.BadZipFile, RuntimeError) as error:
        if isinstance(error, ReleaseError):
            raise
        raise ReleaseError(f"Central ZIP cannot be read: {error}") from error


def exact_asset_paths(originals: tuple[Original, ...]) -> tuple[str, ...]:
    return tuple(sorted(
        original.relative_path + suffix
        for original in originals
        for suffix in ("", ".asc", ".md5", ".sha1")
    ))


def verify_zip(
    data: bytes,
    originals: tuple[Original, ...],
    manifest: dict[str, object],
    verifier: SignatureVerifier,
) -> None:
    validate_manifest(manifest, originals)
    members = zip_member_map(data)
    expected = set(exact_asset_paths(originals))
    if set(members) != expected or len(members) != MAVEN_MEMBER_COUNT:
        raise ReleaseError(
            f"Central ZIP inventory mismatch; expected {MAVEN_MEMBER_COUNT} members, found {len(members)}"
        )
    for original in originals:
        path = original.relative_path
        current = members[path]
        if current != original.data or sha256(current) != original.sha256:
            raise ReleaseError(f"Central ZIP original differs from manifest: {original.name}")
        if members[path + ".md5"] != (md5(current) + "\n").encode("ascii"):
            raise ReleaseError(f"Central ZIP MD5 sidecar mismatch: {original.name}")
        if members[path + ".sha1"] != (sha1(current) + "\n").encode("ascii"):
            raise ReleaseError(f"Central ZIP SHA-1 sidecar mismatch: {original.name}")
        if not verifier(original.name, members[path + ".asc"], current):
            raise ReleaseError(f"Central ZIP signature verification failed: {original.name}")


def safe_subprocess_environment(gnupg_home: Path | None = None) -> dict[str, str]:
    allowed = ("PATH", "HOME", "TMPDIR")
    environment = {name: os.environ[name] for name in allowed if name in os.environ}
    environment["LC_ALL"] = "C"
    if gnupg_home is not None:
        environment["GNUPGHOME"] = str(gnupg_home)
    return environment


def run_process(
    command: tuple[str, ...],
    data: bytes | None = None,
    gnupg_home: Path | None = None,
) -> subprocess.CompletedProcess[bytes]:
    try:
        return subprocess.run(
            command,
            input=data,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            env=safe_subprocess_environment(gnupg_home),
        )
    except OSError as error:
        raise ReleaseError(f"required executable failed to start: {command[0]}") from error


def git_text(*arguments: str) -> str:
    result = run_process(("git", *arguments))
    if result.returncode != 0:
        raise ReleaseError(f"Git context check failed: {' '.join(arguments)}")
    try:
        return result.stdout.decode("utf-8").strip()
    except UnicodeError as error:
        raise ReleaseError("Git context output is not UTF-8") from error


def parse_remote_tag_object(output: bytes, tag: str) -> str:
    try:
        lines = output.decode("utf-8").splitlines()
    except UnicodeError as error:
        raise ReleaseError("remote release tag response is not UTF-8") from error
    expected_ref = f"refs/tags/{tag}"
    fields = lines[0].split("\t") if len(lines) == 1 else []
    if (
        len(fields) != 2
        or fields[1] != expected_ref
        or re.fullmatch(r"[0-9a-f]{40}", fields[0]) is None
    ):
        raise ReleaseError("remote release tag is missing or malformed")
    return fields[0]


def require_remote_release_tag(identity: ReleaseIdentity, commit: str) -> None:
    tag_ref = f"refs/tags/{identity.tag}"
    local_tag_object = git_text("rev-parse", tag_ref)
    if re.fullmatch(r"[0-9a-f]{40}", local_tag_object) is None:
        raise ReleaseError("local annotated release tag object is malformed")
    result = run_process(("git", "ls-remote", "--refs", "origin", tag_ref))
    if result.returncode != 0:
        raise ReleaseError("remote release tag cannot be read")
    if parse_remote_tag_object(result.stdout, identity.tag) != local_tag_object:
        raise ReleaseError("remote release tag no longer identifies this annotated tag object")
    if git_text("rev-parse", f"{tag_ref}^{{commit}}") != commit:
        raise ReleaseError("remote release tag does not identify the release commit")


def require_publish_context(identity: ReleaseIdentity) -> str:
    expected = {
        "GITHUB_ACTIONS": "true",
        "GITHUB_EVENT_NAME": "push",
        "GITHUB_REF_TYPE": "tag",
        "GITHUB_REPOSITORY": REPOSITORY,
        "GITHUB_REF": f"refs/tags/{identity.tag}",
        "GITHUB_REF_NAME": identity.tag,
    }
    for name, value in expected.items():
        if os.environ.get(name) != value:
            raise ReleaseError(f"release requires exact tag-triggered GitHub Actions context: {name}")
    github_run_identity()
    head = git_text("rev-parse", "HEAD")
    if os.environ.get("GITHUB_SHA") != head:
        raise ReleaseError("GITHUB_SHA does not equal the checked-out commit")
    tag_ref = f"refs/tags/{identity.tag}"
    if git_text("cat-file", "-t", tag_ref) != "tag":
        raise ReleaseError("release tag must be annotated")
    if git_text("rev-parse", f"{tag_ref}^{{commit}}") != head:
        raise ReleaseError("annotated release tag does not resolve to the checked-out commit")
    require_remote_release_tag(identity, head)
    ancestry = run_process(("git", "merge-base", "--is-ancestor", head, "refs/remotes/origin/main"))
    if ancestry.returncode != 0:
        raise ReleaseError("release commit is not reachable from origin/main")
    if git_text("status", "--porcelain=v1", "--untracked-files=all"):
        raise ReleaseError("working tree is not clean")
    return head


def github_run_identity() -> tuple[int, int]:
    values: list[int] = []
    for name in ("GITHUB_RUN_ID", "GITHUB_RUN_ATTEMPT"):
        value = os.environ.get(name, "")
        if re.fullmatch(r"[1-9][0-9]*", value) is None:
            raise ReleaseError(f"release requires a positive integer {name}")
        values.append(int(value))
    return values[0], values[1]


def release_signing_epoch(commit: str) -> int:
    value = git_text("show", "-s", "--format=%ct", commit)
    if re.fullmatch(r"[1-9][0-9]*", value) is None:
        raise ReleaseError("release commit timestamp is not a positive Unix epoch")
    return int(value)


def secret_primary_fingerprints(colon_listing: str) -> tuple[str, ...]:
    fingerprints: list[str] = []
    awaiting = False
    for line in colon_listing.splitlines():
        fields = line.split(":")
        record = fields[0] if fields else ""
        if record == "sec":
            awaiting = True
        elif record == "fpr" and awaiting:
            if len(fields) > 9:
                fingerprints.append(fields[9].upper())
            awaiting = False
        elif record in {"ssb", "pub"}:
            awaiting = False
    return tuple(fingerprints)


def require_secret_primary_fingerprint(colon_listing: str) -> None:
    records = [line.split(":") for line in colon_listing.splitlines() if line]
    if len([fields for fields in records if fields[0] == "sec"]) != 1:
        raise ReleaseError("secret key must contain exactly one primary key")
    if any(fields[0] in {"ssb", "pub", "sub"} for fields in records):
        raise ReleaseError("secret key must not contain additional public or secret keys")
    if secret_primary_fingerprints(colon_listing) != (FINGERPRINT,):
        raise ReleaseError("secret key primary fingerprint does not match the approved fingerprint")


def require_public_key_identity(colon_listing: str) -> None:
    records = [line.split(":") for line in colon_listing.splitlines() if line]
    if any(fields[0] in {"sec", "ssb"} for fields in records if fields):
        raise ReleaseError("tracked public key contains secret key packets")
    primary = [fields for fields in records if fields[0] == "pub"]
    subkeys = [fields for fields in records if fields[0] == "sub"]
    fingerprints = [fields[9].upper() for fields in records if fields[0] == "fpr" and len(fields) > 9]
    uids = [fields for fields in records if fields[0] == "uid"]
    if len(primary) != 1 or subkeys or fingerprints != [FINGERPRINT]:
        raise ReleaseError("tracked public key must contain exactly the approved primary key and no subkeys")
    key = primary[0]
    if len(key) <= 11 or key[1] in {"d", "e", "i", "r"} or key[6] not in {"", "0"} or "s" not in key[11]:
        raise ReleaseError("tracked public key must be valid, non-expiring, and signing-capable")
    if (
        len(uids) != 1
        or len(uids[0]) <= 9
        or uids[0][1] in {"d", "e", "i", "r"}
        or uids[0][6] not in {"", "0"}
        or uids[0][9] != EXPECTED_UID
    ):
        raise ReleaseError("tracked public key must contain exactly the approved valid UID")


def inspect_public_key(public_key: bytes) -> None:
    with tempfile.TemporaryDirectory(prefix="tvheadend-sdk-public-key-") as temporary:
        home = Path(temporary) / "gnupg"
        home.mkdir(mode=0o700)
        listing = run_process(
            (
                "gpg", "--batch", "--with-colons", "--fingerprint",
                "--import-options", "show-only", "--dry-run", "--import",
            ),
            public_key,
            home,
        )
        if listing.returncode != 0:
            raise ReleaseError("tracked public key packets cannot be inspected")
        try:
            require_public_key_identity(listing.stdout.decode("utf-8"))
        except UnicodeError as error:
            raise ReleaseError("tracked public key listing is malformed") from error


def import_secret_key(home: Path, private_key: bytes) -> None:
    imported = run_process(("gpg", "--batch", "--yes", "--import"), private_key, home)
    if imported.returncode != 0:
        raise ReleaseError("dedicated Maven secret key import failed")
    listing = run_process(("gpg", "--batch", "--with-colons", "--fingerprint", "--list-secret-keys"), None, home)
    if listing.returncode != 0:
        raise ReleaseError("dedicated Maven secret key cannot be inspected")
    try:
        colon_listing = listing.stdout.decode("utf-8")
    except UnicodeError as error:
        raise ReleaseError("secret-key fingerprint output is malformed") from error
    require_secret_primary_fingerprint(colon_listing)


def import_public_key(home: Path, public_key: bytes) -> None:
    inspect_public_key(public_key)
    imported = run_process(("gpg", "--batch", "--yes", "--import"), public_key, home)
    if imported.returncode != 0:
        raise ReleaseError("tracked public key import failed")
    listing = run_process(("gpg", "--batch", "--with-colons", "--fingerprint", "--list-keys"), None, home)
    try:
        text = listing.stdout.decode("utf-8")
    except UnicodeError as error:
        raise ReleaseError("tracked public key listing is malformed") from error
    if listing.returncode != 0:
        raise ReleaseError("tracked public key cannot be inspected after import")
    require_public_key_identity(text)


def validsig_fingerprints(status: bytes) -> tuple[tuple[str, str], ...]:
    results: list[tuple[str, str]] = []
    try:
        lines = status.decode("utf-8").splitlines()
    except UnicodeError as error:
        raise ReleaseError("GPG status output is malformed") from error
    for line in lines:
        prefix = "[GNUPG:] VALIDSIG "
        if not line.startswith(prefix):
            continue
        fields = line[len(prefix):].split()
        if len(fields) >= 9:
            signer = fields[0].upper()
            primary = fields[9].upper() if len(fields) >= 10 and re.fullmatch(r"[0-9A-Fa-f]{40}", fields[9]) else signer
            results.append((signer, primary))
    return tuple(results)


def verify_signature_file(home: Path, signature: Path, original: Path) -> None:
    result = run_process(
        ("gpg", "--batch", "--status-fd", "1", "--verify", str(signature), str(original)),
        None,
        home,
    )
    if result.returncode != 0 or validsig_fingerprints(result.stdout) != ((FINGERPRINT, FINGERPRINT),):
        raise ReleaseError(f"detached signature is not valid for approved fingerprint: {original.name}")


def public_signature_verifier(workspace: Path, public_key: bytes) -> SignatureVerifier:
    public_home = workspace / "gnupg-public"
    public_home.mkdir(mode=0o700)
    import_public_key(public_home, public_key)
    verify_counter = 0

    def verify_bytes(name: str, signature_data: bytes, original_data: bytes) -> bool:
        nonlocal verify_counter
        verify_counter += 1
        original_path = workspace / f"verify-{verify_counter}.original"
        signature_path = workspace / f"verify-{verify_counter}.asc"
        original_path.write_bytes(original_data)
        signature_path.write_bytes(signature_data)
        original_path.chmod(0o600)
        signature_path.chmod(0o600)
        try:
            verify_signature_file(public_home, signature_path, original_path)
            return True
        finally:
            original_path.unlink(missing_ok=True)
            signature_path.unlink(missing_ok=True)

    return verify_bytes


def detached_signature_command(signature_path: Path, original_path: Path, signing_epoch: int) -> tuple[str, ...]:
    if type(signing_epoch) is not int or signing_epoch <= 0:
        raise ReleaseError("detached signature timestamp must be a positive Unix epoch")
    return (
        "gpg", "--batch", "--yes", "--no-emit-version", "--no-comments",
        "--faked-system-time", f"{signing_epoch}!", "--digest-algo", "SHA256",
        "--pinentry-mode", "loopback", "--passphrase-fd", "0",
        "--local-user", FINGERPRINT + "!", "--armor", "--detach-sign",
        "--output", str(signature_path), str(original_path),
    )


def sign_originals(
    workspace: Path,
    originals: tuple[Original, ...],
    private_key: bytes,
    passphrase: str,
    public_key: bytes,
    signing_epoch: int,
) -> tuple[dict[str, bytes], SignatureVerifier]:
    if "\n" in passphrase or "\r" in passphrase or not passphrase:
        raise ReleaseError("MAVEN_GPG_PASSPHRASE must be nonempty and contain no newline")
    private_home = workspace / "gnupg-private"
    private_home.mkdir(mode=0o700)
    import_secret_key(private_home, private_key)
    verify_bytes = public_signature_verifier(workspace, public_key)
    signed: dict[str, bytes] = {}
    for index, original in enumerate(originals):
        original_path = workspace / f"original-{index}"
        signature_path = workspace / f"signature-{index}.asc"
        original_path.write_bytes(original.data)
        original_path.chmod(0o600)
        command = detached_signature_command(signature_path, original_path, signing_epoch)
        result = run_process(command, (passphrase + "\n").encode("utf-8"), private_home)
        if result.returncode != 0:
            raise ReleaseError(f"detached signing failed: {original.name}")
        signature = read_regular(signature_path, f"detached signature {original.name}")
        if not verify_bytes(original.name, signature, original.data):
            raise ReleaseError(f"detached signature verification failed: {original.name}")
        signed[original.relative_path] = signature
        original_path.unlink(missing_ok=True)
        signature_path.unlink(missing_ok=True)
    return signed, verify_bytes


def terminate_gpg_agents(
    workspace: Path,
    runner: Callable[..., subprocess.CompletedProcess[bytes]] = run_process,
) -> None:
    for home in sorted(workspace.glob("**/gnupg-*")):
        if not home.is_dir():
            continue
        try:
            runner(("gpgconf", "--homedir", str(home), "--kill", "all"))
        except Exception:
            pass


def extract_release_notes(changelog: str, version: str) -> str:
    heading = re.compile(rf"(?m)^## \[{re.escape(version)}\]\s*$")
    matches = list(heading.finditer(changelog))
    if len(matches) != 1:
        raise ReleaseError(f"CHANGELOG must contain exactly one section for {version}")
    following = re.search(r"(?m)^## ", changelog[matches[0].end():])
    end = matches[0].end() + following.start() if following else len(changelog)
    section = changelog[matches[0].start():end].strip()
    body = section[len(matches[0].group(0)):].strip()
    if not body:
        raise ReleaseError(f"CHANGELOG section for {version} is empty")
    return section + "\n"


def github_release_notes(changelog: str, identity: ReleaseIdentity) -> str:
    notes = extract_release_notes(changelog, identity.version).rstrip()
    links: list[str] = []
    for module in sorted(MODULE_EXTENSIONS):
        central = f"{CENTRAL_ARTIFACT_URL}/{GROUP}/{module}/{identity.version}"
        repository = f"{MAVEN_URL}/{GROUP.replace('.', '/')}/{module}/{identity.version}/"
        links.append(f"- [{module} on Maven Central]({central})")
        links.append(f"- [{module} repository files]({repository})")
    return f"{notes}\n\n### Distribution\n\n" + "\n".join(links) + "\n"


def validate_portal_token(token: str) -> None:
    if not token or any(character.isspace() for character in token):
        raise ReleaseError("CENTRAL_PORTAL_TOKEN is not a compact base64 value")
    try:
        decoded = base64.b64decode(token, validate=True)
    except (binascii.Error, ValueError) as error:
        raise ReleaseError("CENTRAL_PORTAL_TOKEN is not valid base64") from error
    if decoded.count(b":") != 1:
        raise ReleaseError("CENTRAL_PORTAL_TOKEN must encode username:password")
    username, password = decoded.split(b":", 1)
    if not username or not password or any(byte < 0x21 or byte == 0x7F for byte in decoded):
        raise ReleaseError("CENTRAL_PORTAL_TOKEN has an invalid username:password shape")


def stdlib_http(method: str, url: str, headers: dict[str, str], body: bytes | None) -> HttpResponse:
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return HttpResponse(response.status, response.read())
    except urllib.error.HTTPError as error:
        return HttpResponse(error.code, error.read())
    except (OSError, urllib.error.URLError) as error:
        raise ReleaseError(f"HTTPS request failed for {urllib.parse.urlsplit(url).path}") from error


def central_member_url(relative_path: str) -> str:
    return f"{MAVEN_URL}/{urllib.parse.quote(relative_path, safe='/')}"


def central_resolution(originals: tuple[Original, ...], client: HttpClient) -> tuple[str, ...]:
    states: list[str] = []
    for original in originals:
        response = client("GET", central_member_url(original.relative_path), {}, None)
        if response.status == 404:
            states.append("absent")
        elif response.status == 200:
            states.append("matching" if sha256(response.body) == original.sha256 else "mismatch")
        else:
            raise ReleaseError(f"Central resolution returned HTTP {response.status} for {original.name}")
    return tuple(states)


def central_companion_presence(originals: tuple[Original, ...], client: HttpClient) -> tuple[str, ...]:
    original_paths = {original.relative_path for original in originals}
    companion_paths = [path for path in exact_asset_paths(originals) if path not in original_paths]
    states: list[str] = []
    for path in companion_paths:
        response = client("GET", central_member_url(path), {}, None)
        if response.status == 404:
            states.append("absent")
        elif response.status == 200:
            states.append("present")
        else:
            raise ReleaseError(f"Central resolution returned HTTP {response.status} for {Path(path).name}")
    return tuple(states)


def central_preflight(originals: tuple[Original, ...], client: HttpClient) -> str:
    states = central_resolution(originals, client)
    if len(states) == ORIGINAL_COUNT and set(states) == {"absent"}:
        companions = central_companion_presence(originals, client)
        if len(companions) == MAVEN_MEMBER_COUNT - ORIGINAL_COUNT and set(companions) == {"absent"}:
            return "upload"
        raise ReleaseError("Central contains release companions without the 26 originals")
    if len(states) == ORIGINAL_COUNT and set(states) == {"matching"}:
        return "recover"
    if "mismatch" in states:
        raise ReleaseError("Central already contains an original with different bytes")
    raise ReleaseError("Central contains only part of the 26-original release")


def central_authorization_model(
    identity: ReleaseIdentity,
    commit: str,
    originals: tuple[Original, ...],
    decision: str,
    previous_publish_started: bool,
    run_id: int,
    run_attempt: int,
) -> dict[str, object]:
    if decision not in {"upload", "recover"} or type(previous_publish_started) is not bool:
        raise ReleaseError("Central authorization decision is invalid")
    return {
        "schema": CENTRAL_AUTHORIZATION_SCHEMA,
        "repository": REPOSITORY,
        "tag": identity.tag,
        "commit": commit,
        "originalManifestSha256": sha256(manifest_bytes(release_manifest(identity, commit, originals))),
        "preflightDecision": decision,
        "previousPublishStarted": previous_publish_started,
        "runId": run_id,
        "runAttempt": run_attempt,
    }


def central_authorization_bytes(model: dict[str, object]) -> bytes:
    return (json.dumps(model, indent=2, sort_keys=True) + "\n").encode("utf-8")


def write_central_authorization(
    path: Path,
    identity: ReleaseIdentity,
    commit: str,
    originals: tuple[Original, ...],
    decision: str,
    previous_publish_started: bool,
) -> None:
    run_id, run_attempt = github_run_identity()
    model = central_authorization_model(
        identity,
        commit,
        originals,
        decision,
        previous_publish_started,
        run_id,
        run_attempt,
    )
    ensure_output_absent(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        with path.open("xb") as stream:
            stream.write(central_authorization_bytes(model))
        path.chmod(0o600)
    except OSError as error:
        raise ReleaseError(f"Central authorization cannot be written: {error}") from error


def read_central_authorization(
    path: Path,
    identity: ReleaseIdentity,
    commit: str,
    originals: tuple[Original, ...],
) -> tuple[str, bool]:
    data = read_regular(path, "Central authorization")
    try:
        model = json.loads(data.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ReleaseError("Central authorization is malformed") from error
    if not isinstance(model, dict):
        raise ReleaseError("Central authorization must be a JSON object")
    decision = model.get("preflightDecision")
    previous = model.get("previousPublishStarted")
    run_id, run_attempt = github_run_identity()
    if not isinstance(decision, str) or type(previous) is not bool:
        raise ReleaseError("Central authorization decision fields are malformed")
    expected = central_authorization_model(
        identity,
        commit,
        originals,
        decision,
        previous,
        run_id,
        run_attempt,
    )
    if model != expected or data != central_authorization_bytes(expected):
        raise ReleaseError("Central authorization does not match this exact workflow attempt and release")
    return decision, previous


def write_github_step_output(name: str, value: str) -> None:
    output = os.environ.get("GITHUB_OUTPUT", "")
    path = Path(output)
    if not output or not path.is_absolute() or path.is_symlink() or not path.is_file():
        raise ReleaseError("GITHUB_OUTPUT is unavailable or unsafe")
    if re.fullmatch(r"[a-z][a-z0-9-]*", name) is None or "\n" in value or "\r" in value:
        raise ReleaseError("GitHub step output is malformed")
    try:
        with path.open("a", encoding="utf-8", newline="\n") as stream:
            stream.write(f"{name}={value}\n")
    except OSError as error:
        raise ReleaseError("GitHub step output cannot be written") from error


def published_asset_resolution(expected: dict[str, bytes], client: HttpClient) -> tuple[str, ...]:
    if len(expected) != MAVEN_MEMBER_COUNT:
        raise ReleaseError(f"uploaded Central member inventory must contain exactly {MAVEN_MEMBER_COUNT} files")
    states: list[str] = []
    for path, data in sorted(expected.items()):
        response = client("GET", central_member_url(path), {}, None)
        if response.status == 404:
            states.append("absent")
        elif response.status == 200:
            states.append("matching" if response.body == data else "mismatch")
        else:
            raise ReleaseError(f"Central resolution returned HTTP {response.status} for {Path(path).name}")
    return tuple(states)


def poll_published_assets(
    expected: dict[str, bytes],
    client: HttpClient,
    timeout: int = RESOLUTION_TIMEOUT_SECONDS,
) -> None:
    deadline = time.monotonic() + timeout
    while True:
        states = published_asset_resolution(expected, client)
        if len(states) == MAVEN_MEMBER_COUNT and set(states) == {"matching"}:
            return
        if "mismatch" in states:
            raise ReleaseError("resolved Central member differs from the exact uploaded bytes")
        if time.monotonic() >= deadline:
            raise ReleaseError(f"all {MAVEN_MEMBER_COUNT} exact Central members did not resolve before timeout")
        time.sleep(POLL_SECONDS)


def recover_published_assets(
    originals: tuple[Original, ...],
    manifest: dict[str, object],
    client: HttpClient,
    verifier: SignatureVerifier,
) -> tuple[dict[str, bytes], bytes]:
    assets: dict[str, bytes] = {}
    for path in exact_asset_paths(originals):
        response = client("GET", central_member_url(path), {}, None)
        if response.status == 404:
            raise ReleaseError(f"published Central member is missing during recovery: {Path(path).name}")
        if response.status != 200:
            raise ReleaseError(f"Central recovery returned HTTP {response.status} for {Path(path).name}")
        assets[path] = response.body
    bundle = zip_bytes(assets)
    verify_zip(bundle, originals, manifest, verifier)
    return assets, bundle


def upload_bundle(bundle: bytes, identity: ReleaseIdentity, token: str, client: HttpClient) -> str:
    boundary = "tvheadend-sdk-" + uuid.uuid4().hex
    body = (
        f"--{boundary}\r\n"
        'Content-Disposition: form-data; name="bundle"; filename="bundle.zip"\r\n'
        "Content-Type: application/zip\r\n\r\n"
    ).encode("ascii") + bundle + f"\r\n--{boundary}--\r\n".encode("ascii")
    query = urllib.parse.urlencode({"name": f"tvheadend-sdk-{identity.version}", "publishingType": "AUTOMATIC"})
    response = client(
        "POST",
        f"{UPLOAD_URL}?{query}",
        {
            "Authorization": f"Bearer {token}",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
        },
        body,
    )
    try:
        deployment = response.body.decode("ascii").strip()
    except UnicodeError:
        deployment = ""
    if response.status != 201 or UUID.fullmatch(deployment) is None:
        raise ReleaseError(
            f"Central upload returned HTTP {response.status} or an ambiguous deployment response; blind retry is forbidden"
        )
    return deployment


def deployment_state(body: bytes) -> str:
    try:
        value = json.loads(body.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ReleaseError("Central deployment status response is malformed") from error
    if not isinstance(value, dict) or not isinstance(value.get("deploymentState"), str):
        raise ReleaseError("Central deployment status lacks deploymentState")
    return value["deploymentState"].upper()


def status_complete(state: str) -> bool:
    if state == "PUBLISHED":
        return True
    if state in {"PENDING", "VALIDATING", "VALIDATED", "PUBLISHING"}:
        return False
    if state == "FAILED":
        raise ReleaseError("Central deployment entered FAILED state")
    raise ReleaseError(f"Central deployment entered unknown state: {state}")


def poll_published(
    deployment: str,
    token: str,
    client: HttpClient,
    timeout: int = PUBLISH_TIMEOUT_SECONDS,
) -> None:
    deadline = time.monotonic() + timeout
    query = urllib.parse.urlencode({"id": deployment})
    while True:
        response = client("POST", f"{STATUS_URL}?{query}", {"Authorization": f"Bearer {token}"}, b"")
        if response.status != 200:
            raise ReleaseError(f"Central deployment status returned HTTP {response.status}")
        if status_complete(deployment_state(response.body)):
            return
        if time.monotonic() >= deadline:
            raise ReleaseError("Central deployment did not reach PUBLISHED before timeout")
        time.sleep(POLL_SECONDS)


def announce_and_poll(
    deployment: str,
    token: str,
    client: HttpClient,
    stream: object | None = None,
    timeout: int = PUBLISH_TIMEOUT_SECONDS,
) -> None:
    destination = sys.stdout if stream is None else stream
    print(f"CENTRAL_DEPLOYMENT_ID={deployment}", file=destination, flush=True)
    try:
        poll_published(deployment, token, client, timeout)
    except ReleaseError as error:
        raise ReleaseError(f"Central deployment {deployment}: {error}") from error


def ensure_output_absent(path: Path) -> None:
    if path.exists() or path.is_symlink():
        raise ReleaseError(f"release output already exists: {path}")


def write_outputs(
    target: Path,
    identity: ReleaseIdentity,
    assets: dict[str, bytes],
    bundle: bytes,
    manifest: bytes,
    notes: str,
) -> None:
    ensure_output_absent(target)
    maven_members = target / "maven-members"
    maven_members.mkdir(parents=True)
    for path, data in sorted(assets.items()):
        destination = maven_members / path
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(data)
    (target / f"tvheadend-sdk-{identity.version}-central.zip").write_bytes(bundle)
    (target / "release-manifest.json").write_bytes(manifest)
    (target / "release-notes.md").write_text(notes, encoding="utf-8")
    if len([path for path in maven_members.rglob("*") if path.is_file()]) != MAVEN_MEMBER_COUNT:
        raise ReleaseError(f"Maven member directory does not contain the exact {MAVEN_MEMBER_COUNT} signed files")


def github_release_inputs(
    output: Path,
    identity: ReleaseIdentity,
    commit: str,
    originals: tuple[Original, ...],
    expected_notes: str | None = None,
) -> tuple[dict[str, bytes], str]:
    expected_root = {
        "maven-members",
        f"tvheadend-sdk-{identity.version}-central.zip",
        "release-manifest.json",
        "release-notes.md",
    }
    try:
        if output.is_symlink() or not output.is_dir():
            raise ReleaseError("build/release output is not a real directory")
        root_entries = list(output.iterdir())
    except FileNotFoundError as error:
        raise ReleaseError("build/release output is missing") from error
    except OSError as error:
        raise ReleaseError(f"build/release output cannot be inspected: {error}") from error
    if {entry.name for entry in root_entries} != expected_root:
        raise ReleaseError("build/release contains missing or extra output entries")
    assets_directory = output / "maven-members"
    if assets_directory.is_symlink() or not assets_directory.is_dir():
        raise ReleaseError("Maven member output is not a real directory")
    entries = [entry for entry in assets_directory.rglob("*") if entry.is_file() or entry.is_symlink()]
    if any(entry.is_symlink() for entry in entries):
        raise ReleaseError("Maven member output contains a symlink")
    expected_paths = set(exact_asset_paths(originals))
    actual_paths = {entry.relative_to(assets_directory).as_posix() for entry in entries}
    if actual_paths != expected_paths or len(entries) != MAVEN_MEMBER_COUNT:
        raise ReleaseError(f"Maven member output must contain exactly the {MAVEN_MEMBER_COUNT} expected paths")
    assets = {
        entry.relative_to(assets_directory).as_posix(): read_regular(entry, f"Maven member output {entry.name}")
        for entry in entries
    }
    for original in originals:
        path = original.relative_path
        if assets[path] != original.data:
            raise ReleaseError(f"Maven member differs from staged original: {original.name}")
        if assets[path + ".md5"] != (md5(original.data) + "\n").encode("ascii"):
            raise ReleaseError(f"Maven MD5 sidecar differs from staged original: {original.name}")
        if assets[path + ".sha1"] != (sha1(original.data) + "\n").encode("ascii"):
            raise ReleaseError(f"Maven SHA-1 sidecar differs from staged original: {original.name}")
    manifest_data = read_regular(output / "release-manifest.json", "release manifest output")
    try:
        manifest = json.loads(manifest_data.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ReleaseError("release manifest output is malformed") from error
    expected_manifest = release_manifest(identity, commit, originals)
    if manifest != expected_manifest or manifest_data != manifest_bytes(expected_manifest):
        raise ReleaseError("release manifest output does not exactly match staged originals and release identity")
    validate_manifest(manifest, originals)
    central_name = f"tvheadend-sdk-{identity.version}-central.zip"
    central_data = read_regular(output / central_name, "Central ZIP output")
    if zip_member_map(central_data) != assets:
        raise ReleaseError(f"Central ZIP output does not contain the exact {MAVEN_MEMBER_COUNT} Maven member bytes")
    notes_data = read_regular(output / "release-notes.md", "release notes output")
    try:
        notes = notes_data.decode("utf-8")
    except UnicodeError as error:
        raise ReleaseError("release notes output is not UTF-8") from error
    if not notes or notes.encode("utf-8") != notes_data:
        raise ReleaseError("release notes output is empty or non-canonical UTF-8")
    if expected_notes is not None and notes != expected_notes:
        raise ReleaseError("release notes output does not match the configured changelog section")
    expected = {central_name: central_data, "release-manifest.json": manifest_data}
    if len(expected) != GITHUB_ASSET_COUNT:
        raise ReleaseError("GitHub release inventory must contain exactly two assets")
    return expected, notes


def github_headers(token: str, content_type: str | None = None) -> dict[str, str]:
    headers = {
        "Accept": "application/vnd.github+json",
        "Authorization": f"Bearer {token}",
        "User-Agent": "tvheadend-sdk-release-finalizer",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if content_type is not None:
        headers["Content-Type"] = content_type
    return headers


def github_json(response: HttpResponse, label: str, statuses: tuple[int, ...]) -> object:
    if response.status not in statuses:
        raise ReleaseError(f"GitHub {label} returned HTTP {response.status}")
    if not response.body:
        return None
    try:
        return json.loads(response.body.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ReleaseError(f"GitHub {label} response is malformed") from error


def github_tag_runs(
    identity: ReleaseIdentity,
    commit: str,
    run_id: int,
    run_attempt: int,
    token: str,
    client: HttpClient,
) -> list[dict[str, object]]:
    query = urllib.parse.urlencode({
        "branch": identity.tag,
        "event": "push",
        "per_page": MAX_TAG_WORKFLOW_RUNS,
        "page": 1,
    })
    url = f"{GITHUB_API_URL}/repos/{REPOSITORY}/actions/workflows/release.yml/runs?{query}"
    model = github_json(client("GET", url, github_headers(token), None), "tag workflow runs", (200,))
    if not isinstance(model, dict) or type(model.get("total_count")) is not int:
        raise ReleaseError("GitHub tag workflow-run response has an invalid shape")
    runs = model.get("workflow_runs")
    if (
        not isinstance(runs, list)
        or any(not isinstance(run, dict) for run in runs)
        or model["total_count"] != len(runs)
        or len(runs) > MAX_TAG_WORKFLOW_RUNS
    ):
        raise ReleaseError("GitHub tag workflow-run inventory is incomplete")
    ids: list[int] = []
    for run in runs:
        repository = run.get("repository")
        head_repository = run.get("head_repository")
        current_id = run.get("id")
        current_attempt = run.get("run_attempt")
        head_sha = run.get("head_sha")
        if (
            type(current_id) is not int
            or current_id <= 0
            or type(current_attempt) is not int
            or current_attempt <= 0
            or not isinstance(head_sha, str)
            or re.fullmatch(r"[0-9a-f]{40}", head_sha) is None
            or run.get("head_branch") != identity.tag
            or run.get("event") != "push"
            or run.get("path") != WORKFLOW_PATH
            or not isinstance(repository, dict)
            or repository.get("full_name") != REPOSITORY
            or not isinstance(head_repository, dict)
            or head_repository.get("full_name") != REPOSITORY
            or head_sha != commit
        ):
            raise ReleaseError("GitHub tag workflow-run metadata is incompatible")
        ids.append(current_id)
    if len(ids) != len(set(ids)):
        raise ReleaseError("GitHub tag workflow-run inventory contains duplicate IDs")
    current = [run for run in runs if run.get("id") == run_id]
    if len(current) != 1 or current[0].get("run_attempt") != run_attempt or current[0].get("head_sha") != commit:
        raise ReleaseError("GitHub tag workflow-run inventory does not identify this exact run")
    return runs


def github_attempt_publish_started(run_id: int, attempt: int, token: str, client: HttpClient) -> bool:
    query = urllib.parse.urlencode({"per_page": 100, "page": 1})
    url = f"{GITHUB_API_URL}/repos/{REPOSITORY}/actions/runs/{run_id}/attempts/{attempt}/jobs?{query}"
    model = github_json(client("GET", url, github_headers(token), None), "prior attempt jobs", (200,))
    if not isinstance(model, dict) or type(model.get("total_count")) is not int:
        raise ReleaseError("GitHub prior-attempt jobs response has an invalid shape")
    jobs = model.get("jobs")
    if (
        not isinstance(jobs, list)
        or any(not isinstance(job, dict) for job in jobs)
        or len(jobs) != model["total_count"]
        or len(jobs) > 100
    ):
        raise ReleaseError("GitHub prior-attempt job inventory is incomplete")
    release_jobs = [job for job in jobs if job.get("name") == "release"]
    if len(release_jobs) != 1:
        raise ReleaseError("GitHub prior attempt does not contain exactly one release job")
    steps = release_jobs[0].get("steps")
    if not isinstance(steps, list) or any(not isinstance(step, dict) for step in steps):
        raise ReleaseError("GitHub prior release job has malformed step metadata")
    conclusions: list[str] = []
    for name in CENTRAL_STEP_NAMES:
        matching = [step for step in steps if step.get("name") == name]
        if len(matching) != 1:
            raise ReleaseError("GitHub prior release job lacks the exact Central processing steps")
        conclusion = matching[0].get("conclusion")
        if conclusion not in {"skipped", "success", "failure", "cancelled"}:
            raise ReleaseError("GitHub prior Central processing step has an unknown conclusion")
        conclusions.append(conclusion)
    return any(conclusion != "skipped" for conclusion in conclusions)


def github_previous_publish_started(
    identity: ReleaseIdentity,
    commit: str,
    run_id: int,
    run_attempt: int,
    token: str,
    client: HttpClient,
) -> bool:
    started = False
    for run in github_tag_runs(identity, commit, run_id, run_attempt, token, client):
        candidate_id = int(run["id"])
        last_attempt = int(run["run_attempt"])
        if candidate_id == run_id:
            last_attempt = run_attempt - 1
        for attempt in range(1, last_attempt + 1):
            if github_attempt_publish_started(candidate_id, attempt, token, client):
                started = True
    return started


def github_release_metadata(release: dict[str, object], identity: ReleaseIdentity, notes: str) -> None:
    expected = {"tag_name": identity.tag, "name": identity.tag, "body": notes, "prerelease": True}
    for key, value in expected.items():
        if release.get(key) != value:
            raise ReleaseError(f"existing GitHub release has incompatible {key} metadata")
    if type(release.get("draft")) is not bool or type(release.get("id")) is not int:
        raise ReleaseError("existing GitHub release has malformed id or draft metadata")


def github_releases(token: str, client: HttpClient) -> list[dict[str, object]]:
    releases: list[dict[str, object]] = []
    for page in range(1, GITHUB_RELEASE_PAGE_LIMIT + 1):
        query = urllib.parse.urlencode({"per_page": 100, "page": page})
        response = client("GET", f"{GITHUB_API_URL}/repos/{REPOSITORY}/releases?{query}", github_headers(token), None)
        model = github_json(response, "release listing", (200,))
        if not isinstance(model, list) or any(not isinstance(item, dict) for item in model):
            raise ReleaseError("GitHub release listing response has an invalid shape")
        releases.extend(model)
        if len(model) < 100:
            return releases
    raise ReleaseError("GitHub release listing exceeded the bounded pagination limit")


def github_refetch_release(release_id: int, token: str, client: HttpClient) -> dict[str, object]:
    response = client("GET", f"{GITHUB_API_URL}/repos/{REPOSITORY}/releases/{release_id}", github_headers(token), None)
    model = github_json(response, "release fetch", (200,))
    if not isinstance(model, dict):
        raise ReleaseError("GitHub release fetch response has an invalid shape")
    return model


def github_assets(release_id: int, token: str, client: HttpClient) -> list[dict[str, object]]:
    query = urllib.parse.urlencode({"per_page": 100, "page": 1})
    response = client(
        "GET",
        f"{GITHUB_API_URL}/repos/{REPOSITORY}/releases/{release_id}/assets?{query}",
        github_headers(token),
        None,
    )
    model = github_json(response, "asset listing", (200,))
    if not isinstance(model, list) or len(model) > 100 or any(not isinstance(item, dict) for item in model):
        raise ReleaseError("GitHub asset listing response has an invalid shape")
    return model


def exact_github_asset(asset: dict[str, object], name: str, data: bytes) -> bool:
    return (
        asset.get("name") == name
        and type(asset.get("size")) is int
        and asset.get("size") == len(data)
        and asset.get("digest") == f"sha256:{sha256(data)}"
    )


def verify_github_assets(
    release_id: int,
    expected: dict[str, bytes],
    token: str,
    client: HttpClient,
) -> None:
    assets = github_assets(release_id, token, client)
    names = [asset.get("name") for asset in assets]
    if any(not isinstance(name, str) for name in names) or len(names) != len(set(names)):
        raise ReleaseError("GitHub release contains malformed or duplicate asset names")
    if set(names) != set(expected) or len(names) != GITHUB_ASSET_COUNT:
        raise ReleaseError("GitHub release asset inventory is not exactly the expected two names")
    for asset in assets:
        name = str(asset["name"])
        if not exact_github_asset(asset, name, expected[name]):
            raise ReleaseError(f"GitHub release asset size or SHA-256 digest differs: {name}")


def finalize_github_release_state(
    identity: ReleaseIdentity,
    commit: str,
    expected: dict[str, bytes],
    notes: str,
    token: str,
    client: HttpClient,
) -> None:
    if len(expected) != GITHUB_ASSET_COUNT:
        raise ReleaseError("GitHub finalizer requires exactly two expected assets")
    candidates = [
        release
        for release in github_releases(token, client)
        if release.get("tag_name") == identity.tag or release.get("name") == identity.tag
    ]
    if len(candidates) > 1:
        raise ReleaseError("GitHub contains duplicate releases for the exact tag or title")
    if candidates:
        release = candidates[0]
        github_release_metadata(release, identity, notes)
    else:
        body = json.dumps({
            "tag_name": identity.tag,
            "target_commitish": commit,
            "name": identity.tag,
            "body": notes,
            "draft": True,
            "prerelease": True,
            "make_latest": "false",
        }).encode("utf-8")
        response = client("POST", f"{GITHUB_API_URL}/repos/{REPOSITORY}/releases", github_headers(token, "application/json"), body)
        model = github_json(response, "draft creation", (201,))
        if not isinstance(model, dict):
            raise ReleaseError("GitHub draft creation response has an invalid shape")
        release = model
        github_release_metadata(release, identity, notes)
        if release.get("draft") is not True:
            raise ReleaseError("GitHub did not create the release as a draft")
    release_id = int(release["id"])
    release = github_refetch_release(release_id, token, client)
    github_release_metadata(release, identity, notes)
    if release["draft"] is False:
        verify_github_assets(release_id, expected, token, client)
        return
    current_assets = github_assets(release_id, token, client)
    names = [asset.get("name") for asset in current_assets]
    if any(not isinstance(name, str) for name in names) or len(names) != len(set(names)):
        raise ReleaseError("GitHub draft contains malformed or duplicate asset names")
    unexpected = set(names) - set(expected)
    if unexpected:
        raise ReleaseError(f"GitHub draft contains unexpected assets: {sorted(unexpected)}")
    retained: set[str] = set()
    for asset in current_assets:
        name = str(asset["name"])
        if exact_github_asset(asset, name, expected[name]):
            retained.add(name)
            continue
        asset_id = asset.get("id")
        if type(asset_id) is not int:
            raise ReleaseError(f"GitHub draft asset has malformed id metadata: {name}")
        response = client(
            "DELETE",
            f"{GITHUB_API_URL}/repos/{REPOSITORY}/releases/assets/{asset_id}",
            github_headers(token),
            None,
        )
        github_json(response, f"asset deletion for {name}", (204,))
    for name, data in sorted(expected.items()):
        if name in retained:
            continue
        query = urllib.parse.urlencode({"name": name})
        upload_url = f"https://uploads.github.com/repos/{REPOSITORY}/releases/{release_id}/assets?{query}"
        response = client("POST", upload_url, github_headers(token, "application/octet-stream"), data)
        github_json(response, f"asset upload for {name}", (201,))
    release = github_refetch_release(release_id, token, client)
    github_release_metadata(release, identity, notes)
    if release.get("draft") is not True:
        raise ReleaseError("GitHub draft changed publication state before final verification")
    verify_github_assets(release_id, expected, token, client)
    patch = json.dumps({
        "tag_name": identity.tag,
        "name": identity.tag,
        "body": notes,
        "draft": False,
        "prerelease": True,
        "make_latest": "false",
    }).encode("utf-8")
    response = client(
        "PATCH",
        f"{GITHUB_API_URL}/repos/{REPOSITORY}/releases/{release_id}",
        github_headers(token, "application/json"),
        patch,
    )
    github_json(response, "draft publication", (200,))
    release = github_refetch_release(release_id, token, client)
    github_release_metadata(release, identity, notes)
    if release.get("draft") is not False:
        raise ReleaseError("GitHub release did not become a published prerelease")
    verify_github_assets(release_id, expected, token, client)


def workflow_step(workflow: str, name: str) -> str:
    marker = f"      - name: {name}"
    start = workflow.find(marker)
    if start < 0:
        return ""
    following = workflow.find("\n      - name: ", start + len(marker))
    return workflow[start:following if following >= 0 else len(workflow)]


def workflow_commands(workflow: str) -> list[str]:
    commands: list[str] = []
    for line in workflow.splitlines():
        value = line.strip()
        if value.startswith("run: "):
            commands.append(value.removeprefix("run: "))
        elif value.startswith("./") or value.startswith("sdkmanager "):
            commands.append(value)
    return commands


def release_job_guard_errors(workflow: str) -> list[str]:
    tokens = (
        "    if: >-",
        "      github.repository == 'bernhardberger/tvheadend-sdk' &&",
        "      github.ref_type == 'tag' &&",
        "      startsWith(github.ref, 'refs/tags/v')",
    )
    errors = []
    if any(workflow.count(token) != 1 for token in tokens):
        errors.append("release job must have the exact repository, tag-type, and v-ref guard")
    guard = workflow.find(tokens[0])
    environment = workflow.find("    environment: central")
    if guard < 0 or environment < 0 or guard > environment:
        errors.append("release job guard must precede Environment resolution")
    return errors


SETUP_FILES = (
    ".github/workflows/ci.yml",
    ".github/workflows/release.yml",
    "build.gradle.kts",
    "CHANGELOG.md",
    "docs/releasing.md",
    "docs/versioning.md",
    "release/openpgp/README.md",
    "release/openpgp/public-key.asc",
    "release/openpgp/primary-fingerprint.txt",
    "tools/check-staged-publication",
    "tools/publish-central-release",
)


def setup_errors(root: Path = ROOT) -> list[str]:
    errors: list[str] = []
    texts: dict[str, str] = {}
    for relative in SETUP_FILES:
        path = root / relative
        try:
            if not stat.S_ISREG(path.lstat().st_mode):
                raise OSError("not a regular file")
            texts[relative] = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            errors.append(f"{relative}: required setup file unavailable ({error})")
            texts[relative] = ""
    for relative in ("tools/check-staged-publication", "tools/publish-central-release"):
        tool = root / relative
        if tool.is_file() and tool.stat().st_mode & 0o111 == 0:
            errors.append(f"{relative} must be executable")
    release = texts[".github/workflows/release.yml"]
    ci = texts[".github/workflows/ci.yml"]
    source = texts["tools/publish-central-release"]
    errors.extend(release_job_guard_errors(release))
    if release.count("tags:\n      - 'v*'") != 1:
        errors.append("release workflow must trigger only v* tag pushes")
    if release.count(
        "concurrency:\n  group: release-${{ github.ref }}\n  cancel-in-progress: false"
    ) != 1:
        errors.append("release workflow must serialize the exact tag without cancelling an active run")
    for forbidden_trigger in ("branches:", "pull_request:", "workflow_dispatch:", "schedule:"):
        if forbidden_trigger in release:
            errors.append(f"release workflow contains a non-tag trigger: {forbidden_trigger}")
    if (
        release.count("permissions: {}") != 1
        or release.count("    environment: central") != 1
        or release.count("    permissions:\n      actions: read\n      contents: read") != 1
        or release.count("    permissions:\n      actions: read\n      contents: write") != 1
    ):
        errors.append("release workflow must isolate read-only Central and write-capable GitHub release permissions")
    if release.count("  github-release:\n    needs: release") != 1:
        errors.append("release workflow must finalize GitHub in one dependent credential-isolated job")
    authorization_step = workflow_step(release, "Authorize one Central upload or recovery")
    publish_step = workflow_step(release, "Sign, publish, and verify Central")
    recovery_step = workflow_step(release, "Recover and verify Central")
    github_step = workflow_step(release, "Finalize GitHub prerelease from verified outputs")
    actual_refs = set(re.findall(r"(?m)^\s{10}([A-Z0-9_]+): \$\{\{ secrets\.([A-Z0-9_]+) \}\}$", publish_step))
    if actual_refs != {(name, name) for name in SECRET_NAMES}:
        errors.append("publish step must receive only the exact three release secrets")
    expected_secret_refs = [f"${{{{ secrets.{name} }}}}" for name in SECRET_NAMES]
    if re.findall(r"\$\{\{ secrets\.[A-Z0-9_]+ \}\}", release) != expected_secret_refs:
        errors.append("release secret references must occur once and only in publish order")
    for label, step in (("Central authorization", authorization_step), ("GitHub release", github_step)):
        if re.findall(r"(?m)^\s{10}([A-Z0-9_]+):", step) != ["GH_TOKEN"] or "GH_TOKEN: ${{ github.token }}" not in step:
            errors.append(f"{label} step must receive only GH_TOKEN from github.token")
    if release.count("GH_TOKEN: ${{ github.token }}") != 2 or release.count("GH_TOKEN:") != 2:
        errors.append("release workflow must expose GH_TOKEN only to authorization and finalization")
    if "GH_TOKEN" in publish_step or "GH_TOKEN" in recovery_step:
        errors.append("Central processing steps must not receive GH_TOKEN")
    if "secrets." in recovery_step or "env:" in recovery_step:
        errors.append("Central recovery step must receive no release credentials")
    if (
        "        id: central-authorization" not in authorization_step
        or "        if: steps.central-authorization.outputs.decision == 'upload'" not in publish_step
        or "        if: steps.central-authorization.outputs.decision == 'recover'" not in recovery_step
    ):
        errors.append("Central upload and recovery must be selected by the exact authorization output")
    transfer_contract = (
        "uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
        "uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093",
        "name: verified-release-${{ github.run_id }}",
        "          path: |\n            build/local-maven\n            build/release",
        "          path: build",
        "if-no-files-found: error",
        "retention-days: 1",
        "compression-level: 0",
        "overwrite: true",
    )
    if any(release.count(value) != (2 if value.startswith("name:") else 1) for value in transfer_contract):
        errors.append("release workflow must transfer verified outputs once with the exact pinned artifact contract")
    release_lines = workflow_commands(release)
    ordered_commands = (
        "./tools/check-staged-publication --self-test",
        "./tools/publish-central-release --self-test",
        "./gradlew --no-daemon clean build check stageLocalPublication",
        "./tools/check-staged-publication",
        "./gradlew --no-daemon -p consumer-contract clean test verifyConsumerDependencyGraph",
        "./tools/publish-central-release --check-setup",
        "./tools/publish-central-release --authorize-central-upload",
        "./tools/publish-central-release --finalize-github-release",
    )
    positions: list[int] = []
    for command in ordered_commands:
        if release_lines.count(command) != 1:
            errors.append(f"release workflow must invoke exactly once: {command}")
            positions.append(-1)
        else:
            positions.append(release_lines.index(command))
    if all(position >= 0 for position in positions) and positions != sorted(positions):
        errors.append("release verification and publication command ordering is invalid")
    if release_lines.count("./tools/publish-central-release --publish") != 2:
        errors.append("release workflow must invoke the publisher once for upload and once for credential-free recovery")
    step_names = (
        "Authorize one Central upload or recovery",
        "Sign, publish, and verify Central",
        "Recover and verify Central",
        "Transfer verified release outputs",
        "Download verified release outputs",
        "Finalize GitHub prerelease from verified outputs",
    )
    step_positions = [release.find(f"      - name: {name}") for name in step_names]
    if any(position < 0 for position in step_positions) or step_positions != sorted(step_positions):
        errors.append("release authorization, Central processing, transfer, and finalization steps are misordered")
    if release_lines.count('sdkmanager "platforms;android-36" "build-tools;36.0.0"') != 1:
        errors.append("release workflow must install the exact Android SDK packages")
    ci_lines = workflow_commands(ci)
    expected_ci = ordered_commands[:6]
    for command in expected_ci:
        if ci_lines.count(command) != 1:
            errors.append(f"normal CI must invoke exactly once: {command}")
    if "secrets." in ci or "--publish" in ci or "--finalize-github-release" in ci or "upload-artifact" in ci:
        errors.append("normal CI must not reference release secrets, publishing, finalization, or retained release output")
    if re.search(r"\(\s*[\"'](?:\./)?gradlew?[\"']", source):
        errors.append("publisher source must not invoke Gradle")
    publish_start = source.find("\ndef publish() -> None:")
    publish_end = source.find("\ndef finalize_github_release() -> None:", publish_start)
    publish_source = source[publish_start:publish_end] if publish_start >= 0 and publish_end > publish_start else ""
    preflight_position = publish_source.find("decision = central_preflight(")
    private_position = publish_source.find('os.environ["MAVEN_GPG_PRIVATE_KEY"]')
    signing_position = publish_source.find("sign_originals(")
    recovery_position = publish_source.find("recover_published_assets(")
    if min(preflight_position, private_position, signing_position, recovery_position) < 0 or not (
        preflight_position < private_position < signing_position < recovery_position
    ):
        errors.append("Central preflight must select upload or recovery before private-secret access and signing")
    upload_guard = (
        "            require_remote_release_tag(identity, commit)\n"
        "            deployment = upload_bundle("
    )
    if publish_source.count(upload_guard) != 1:
        errors.append("Central upload must revalidate the live remote tag after signing and immediately before mutation")
    deterministic_signing_tokens = (
        '"--faked-system-time"', 'f"{signing_epoch}!"',
        '"--digest-algo", "SHA256"', '"--no-emit-version"',
    )
    signing_command_source = source[
        source.find("def detached_signature_command"):source.find("def sign_originals")
    ]
    if any(signing_command_source.count(token) != 1 for token in deterministic_signing_tokens):
        errors.append("release signing must be byte-deterministic for the exact release commit")
    recovery_start = publish_source.find("        else:\n            for name in SECRET_NAMES:")
    recovery_end = publish_source.find("        pending_output =", recovery_start)
    recovery_branch = (
        publish_source[recovery_start:recovery_end]
        if recovery_start >= 0 and recovery_end > recovery_start
        else ""
    )
    recovery_guard = (
        "            require_remote_release_tag(identity, commit)\n"
        "            assets, bundle = recover_published_assets("
    )
    if recovery_branch.count(recovery_guard) != 1:
        errors.append("Central recovery must revalidate the live remote tag immediately before verification")
    if not recovery_branch or any(name in recovery_branch for name in (
        'os.environ["MAVEN_GPG_PRIVATE_KEY"]',
        'os.environ["MAVEN_GPG_PASSPHRASE"]',
        'os.environ["CENTRAL_PORTAL_TOKEN"]',
        "sign_originals(",
        "upload_bundle(",
    )):
        errors.append("Central recovery must not access release secrets, signing, or upload paths")
    finalize_start = source.find("\ndef finalize_github_release() -> None:", publish_start)
    finalize_end = source.find("\ndef main() -> int:", finalize_start)
    finalize_source = (
        source[finalize_start:finalize_end]
        if finalize_start >= 0 and finalize_end > finalize_start
        else ""
    )
    finalize_guard = (
        "    require_remote_release_tag(identity, commit)\n"
        "    finalize_github_release_state("
    )
    if finalize_source.count(finalize_guard) != 1:
        errors.append("GitHub finalization must revalidate the live remote tag immediately before mutation")
    fingerprint = texts["release/openpgp/primary-fingerprint.txt"]
    if fingerprint != FINGERPRINT + "\n":
        errors.append("tracked primary fingerprint does not match the approved full fingerprint")
    public_key = texts["release/openpgp/public-key.asc"]
    if (
        public_key.count("-----BEGIN PGP PUBLIC KEY BLOCK-----") != 1
        or public_key.count("-----END PGP PUBLIC KEY BLOCK-----") != 1
        or "PRIVATE KEY" in public_key
        or not public_key.endswith("\n")
    ):
        errors.append("tracked public key is not one public-only armored block")
    try:
        inspect_public_key(public_key.encode("utf-8"))
    except ReleaseError as error:
        errors.append(f"tracked public key identity is invalid: {error}")
    openpgp_readme = texts["release/openpgp/README.md"]
    if FINGERPRINT not in openpgp_readme or EXPECTED_UID not in openpgp_readme:
        errors.append("OpenPGP documentation does not bind the approved fingerprint and UID")
    releasing = texts["docs/releasing.md"]
    if "26 Maven originals" not in releasing or "104-member" not in releasing:
        errors.append("release documentation does not state the exact original and Central member counts")
    if "no-bypass tag ruleset" not in releasing or "no cross-service atomic lock" not in releasing:
        errors.append("release documentation does not require the immutable-tag administrative control")
    try:
        identity = configured_identity(texts["build.gradle.kts"])
        extract_release_notes(texts["CHANGELOG.md"], identity.version)
    except (UnicodeError, ReleaseError) as error:
        errors.append(f"configured release identity or changelog is invalid: {error}")
    return errors


def expect_error(errors: list[str], label: str, action: Callable[[], object]) -> None:
    try:
        action()
    except ReleaseError:
        return
    errors.append(f"self-test accepted {label}")


class FakeGitHub:
    """In-memory GitHub Releases REST fixture for finalizer regression tests."""

    def __init__(self) -> None:
        self.releases: list[dict[str, object]] = []
        self.assets: dict[int, list[dict[str, object]]] = {}
        self.asset_bytes: dict[int, bytes] = {}
        self.next_release_id = 1
        self.next_asset_id = 100
        self.fail_after_stored_upload = False
        self.failed_once = False
        self.published_transitions = 0

    def add_release(
        self,
        identity: ReleaseIdentity,
        notes: str,
        *,
        draft: bool,
        name: str | None = None,
        tag: str | None = None,
        prerelease: bool = True,
    ) -> dict[str, object]:
        release_id = self.next_release_id
        self.next_release_id += 1
        release: dict[str, object] = {
            "id": release_id,
            "tag_name": identity.tag if tag is None else tag,
            "name": identity.tag if name is None else name,
            "body": notes,
            "draft": draft,
            "prerelease": prerelease,
        }
        self.releases.append(release)
        self.assets[release_id] = []
        return release

    def add_asset(self, release: dict[str, object], name: str, data: bytes, *, digest: str | None = None) -> None:
        asset_id = self.next_asset_id
        self.next_asset_id += 1
        current = {
            "id": asset_id,
            "name": name,
            "size": len(data),
            "digest": f"sha256:{sha256(data)}" if digest is None else digest,
        }
        self.assets[int(release["id"])].append(current)
        self.asset_bytes[asset_id] = data

    def client(self, method: str, url: str, headers: dict[str, str], body: bytes | None) -> HttpResponse:
        if headers.get("Authorization") != "Bearer synthetic-github-token":
            return HttpResponse(401, b"{}")
        parsed = urllib.parse.urlsplit(url)
        path = parsed.path
        releases_path = f"/repos/{REPOSITORY}/releases"
        if method == "GET" and path == releases_path:
            page = urllib.parse.parse_qs(parsed.query).get("page", ["1"])[0]
            return HttpResponse(200, json.dumps(self.releases if page == "1" else []).encode())
        if method == "POST" and path == releases_path:
            model = json.loads((body or b"").decode())
            identity = ReleaseIdentity(model["tag_name"][1:], model["tag_name"], ())
            release = self.add_release(
                identity,
                model["body"],
                draft=model["draft"],
                name=model["name"],
                prerelease=model["prerelease"],
            )
            return HttpResponse(201, json.dumps(release).encode())
        release_match = re.fullmatch(re.escape(releases_path) + r"/([0-9]+)", path)
        if release_match:
            release_id = int(release_match.group(1))
            release = next((item for item in self.releases if item["id"] == release_id), None)
            if release is None:
                return HttpResponse(404, b"{}")
            if method == "GET":
                return HttpResponse(200, json.dumps(release).encode())
            if method == "PATCH":
                model = json.loads((body or b"").decode())
                if release["draft"] and model.get("draft") is False:
                    self.published_transitions += 1
                release.update({key: value for key, value in model.items() if key != "make_latest"})
                return HttpResponse(200, json.dumps(release).encode())
        assets_match = re.fullmatch(re.escape(releases_path) + r"/([0-9]+)/assets", path)
        if assets_match and method == "GET":
            return HttpResponse(200, json.dumps(self.assets[int(assets_match.group(1))]).encode())
        delete_match = re.fullmatch(re.escape(releases_path) + r"/assets/([0-9]+)", path)
        if delete_match and method == "DELETE":
            asset_id = int(delete_match.group(1))
            for release_assets in self.assets.values():
                release_assets[:] = [item for item in release_assets if item["id"] != asset_id]
            self.asset_bytes.pop(asset_id, None)
            return HttpResponse(204, b"")
        upload_match = re.fullmatch(re.escape(releases_path) + r"/([0-9]+)/assets", path)
        if parsed.netloc == "uploads.github.com" and upload_match and method == "POST":
            name = urllib.parse.parse_qs(parsed.query).get("name", [""])[0]
            release = next(item for item in self.releases if item["id"] == int(upload_match.group(1)))
            self.add_asset(release, name, body or b"")
            if self.fail_after_stored_upload and not self.failed_once:
                self.failed_once = True
                return HttpResponse(500, b"{}")
            return HttpResponse(201, b"{}")
        return HttpResponse(404, b"{}")


def github_finalizer_regression_tests(
    identity: ReleaseIdentity,
    output: Path,
    commit: str,
    originals: tuple[Original, ...],
) -> list[str]:
    errors: list[str] = []
    expected, notes = github_release_inputs(output, identity, commit, originals)
    absent = FakeGitHub()
    finalize_github_release_state(identity, commit, expected, notes, "synthetic-github-token", absent.client)
    if len(absent.releases) != 1 or absent.releases[0]["draft"] is not False or absent.published_transitions != 1:
        errors.append("absent GitHub release did not converge through one draft publication")
    interrupted = FakeGitHub()
    interrupted.fail_after_stored_upload = True
    expect_error(
        errors,
        "injected partial GitHub asset upload failure",
        lambda: finalize_github_release_state(identity, commit, expected, notes, "synthetic-github-token", interrupted.client),
    )
    if not interrupted.releases or interrupted.releases[0]["draft"] is not True:
        errors.append("failed partial GitHub upload published the draft")
    finalize_github_release_state(identity, commit, expected, notes, "synthetic-github-token", interrupted.client)
    if interrupted.releases[0]["draft"] is not False:
        errors.append("GitHub finalizer rerun did not converge after partial upload")
    unexpected = FakeGitHub()
    release = unexpected.add_release(identity, notes, draft=True)
    unexpected.add_asset(release, "unexpected", b"x")
    expect_error(
        errors,
        "unexpected draft GitHub asset",
        lambda: finalize_github_release_state(identity, commit, expected, notes, "synthetic-github-token", unexpected.client),
    )
    published = FakeGitHub()
    release = published.add_release(identity, notes, draft=False)
    for name, data in expected.items():
        published.add_asset(release, name, data)
    finalize_github_release_state(identity, commit, expected, notes, "synthetic-github-token", published.client)
    if published.published_transitions:
        errors.append("exact published GitHub prerelease rerun was not idempotent")
    duplicate = FakeGitHub()
    duplicate.add_release(identity, notes, draft=True)
    duplicate.add_release(identity, notes, draft=True)
    expect_error(
        errors,
        "duplicate GitHub release",
        lambda: finalize_github_release_state(identity, commit, expected, notes, "synthetic-github-token", duplicate.client),
    )
    return errors


